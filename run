#!/usr/bin/env bash
set -euo pipefail

# Resolve paths relative to this repo, even when invoked from elsewhere.
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

usage() {
    cat <<'EOF'
Usage: ./run build [go build flags]
       ./run dev [commands and flags]
       ./run doctor [flags]
       ./run test [go test flags]
       ./run check
       ./run db:dump
       ./run db:rm
       ./run client-data:fetch
       ./run charcatalog:generate
       ./run mapcatalog:generate
       ./run opcodecatalog:generate

Examples:
  ./run build
  ./run doctor --json
  ./run check
  ./run dev auth init
  ./run dev auth login --timeout 5s
  ./run db:dump
  ./run db:rm
  ./run client-data:fetch
  ./run charcatalog:generate
  ./run mapcatalog:generate
  ./run opcodecatalog:generate
EOF
}

case "${1:-}" in
    build)
        shift
        exec go build -o ./bin/agent-wow "$@" .
        ;;
    dev)
        shift
        exec go run . --config dev.config.yaml "$@"
        ;;
    doctor)
        shift
        exec go run . --config dev.config.yaml doctor "$@"
        ;;
    test)
        shift
        exec go test -race -count=1 -timeout=5m "$@" ./...
        ;;
    check)
        shift
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 2
        fi
        unformatted=$(gofmt -l .)
        if [ -n "$unformatted" ]; then
            printf 'Run gofmt on these files:\n%s\n' "$unformatted" >&2
            exit 1
        fi
        go vet ./...
        go test -race -count=1 -timeout=5m ./...
        exec go build -o ./bin/agent-wow .
        ;;
    db:dump)
        shift
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 2
        fi
        exec go run ./tools/dumpdb
        ;;
    db:rm)
        shift
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 2
        fi
        exec rm -rf -- ./data
        ;;
    client-data:fetch)
        shift
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 2
        fi
        exec go run ./tools/clientdata
        ;;
    charcatalog:generate|mapcatalog:generate|opcodecatalog:generate)
        generator="${1%:generate}"
        shift
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 2
        fi
        exec go run "./tools/$generator"
        ;;
    ""|-h|--help)
        usage
        ;;
    *)
        printf 'Unknown task: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
