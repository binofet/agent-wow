ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('maintenance_sync', str(Path(__file__).with_name('sync-quests')))
spec = importlib.util.spec_from_loader(loader.name, loader)
sync = importlib.util.module_from_spec(spec)
loader.exec_module(sync)
c, Error, integer = sync.converse, sync.Error, sync.integer
ROSTER = sync.ROSTER
IDENTITY = {'version': 1, 'ownerGuid': 3, 'mode': 'training_stipend_and_class_training',
            'characters': [{'name': n, 'guid': g, 'port': p} for n,g,p in ROSTER]}

def load_character(path):
    try:
        with os.fdopen(c.private_open(path, os.O_RDONLY),'r') as source:
            raw=source.read(65537)
        if len(raw)>65536:raise Error('Maintenance character state exceeds its bound')
        value=json.loads(raw)
        if not isinstance(value,dict):raise ValueError
        return value
    except FileNotFoundError:return {}
    except ValueError:raise Error('Invalid maintenance character state') from None

def confirmed_mail(receipt, mail_id):
    return (integer(receipt.get('mailId',0)) == integer(mail_id)
        and receipt.get('status') == 'CLAIM_CONFIRMED' and receipt.get('serverAcknowledged') is True
        and receipt.get('walletIncreaseObserved') is True and integer(receipt.get('confirmedCopper',0)) == 10000)

class RPC(sync.SyncRPC):
    EXTRA = sync.SyncRPC.EXTRA | {'buddy-mail.list', 'buddy-mail.state', 'buddy-mail.claim_stipend',
        'buddy-training.discover', 'buddy-training.state', 'buddy-training.list', 'buddy-training.buy',
        'buddy-actions.travel_trainer'}

    def fork(self):
        return RPC(self.url, self.timeout)

    def call(self, method, params):
        if method != 'buddy-actions.travel_trainer':
            return super().call(method, params)
        self.request_id += 1
        request_id = self.request_id
        request = urllib.request.Request(self.url, data=json.dumps({'jsonrpc':'2.0','id':request_id,
            'method':method,'params':params}, allow_nan=False).encode(), headers={'Content-Type':'application/json'})
        try:
            with self.opener.open(request, timeout=35) as response:
                raw=response.read(262145)
            value=json.loads(raw) if len(raw)<=262144 else None
        except (OSError,ValueError,urllib.error.URLError):
            raise Error('Class trainer travel response is unconfirmed') from None
        if (not isinstance(value,dict) or value.get('jsonrpc')!='2.0' or type(value.get('id')) is not int
                or value['id']!=request_id or 'error' in value or not isinstance(value.get('result'),dict)):
            raise Error('Class trainer travel response is unconfirmed')
        return value['result']

def point(value):
    return (isinstance(value,dict) and value.get('positionKnown') is True and value.get('mapKnown') is True
        and all(type(value.get(k,0)) in (int,float) and math.isfinite(value.get(k,0))
                and abs(value.get(k,0))<40000 for k in ('x','y','z')))

def profession_active(guid):
    folder=ROOT/'data/professions'/str(guid)
    try:
        if folder.is_symlink():return True
        with os.fdopen(c.private_open(folder/'lock',os.O_RDONLY),'r') as lock:
            return c.is_locked(lock)
    except FileNotFoundError:return False
    except (OSError,Error):return True

class Maintenance:
    def __init__(self, name, guid, rpc, save, stored=None, now=time.time, stopped=lambda:False):
        if (name, guid) not in {(n, g) for n, g, _ in ROSTER}:
            raise Error('Maintenance supports only the configured companion profiles')
        self.name, self.guid, self.rpc, self.save, self.now = name, guid, rpc, save, now
        identity = {'name': name, 'guid': guid, 'ownerGuid': 3, 'budgetCopper': 10000}
        self.data = stored or {'identity': identity, 'reservedCopper': 0, 'training': [], 'mail': None}
        if (self.data.get('identity') != identity or type(self.data.get('reservedCopper')) is not int
                or not 0 <= self.data['reservedCopper'] <= 10000
                or not isinstance(self.data.get('training'), list) or len(self.data['training']) > 128
                or self.data.get('mail') is not None and not isinstance(self.data['mail'], dict)):
            raise Error('Maintenance state identity or bounds are invalid')
        for row in self.data['training']:
            if (not isinstance(row, dict) or not isinstance(row.get('session'), str)
                    or not 1 <= len(row['session']) <= 128 or not 0 < integer(row.get('spell', 0)) <= 2**32-1
                    or type(row.get('cost')) is not int or not 0 <= row['cost'] <= 10000
                    or not 0 < integer(row.get('npc',0)) <= 2**64-1
                    or type(row.get('baselineId')) is not int or row['baselineId'] < 0
                    or row.get('status') not in ('reserved','confirmed','rejected')):
                raise Error('Training reservation is invalid')
        if sum(row['cost'] for row in self.data['training']) != self.data['reservedCopper']:
            raise Error('Training budget does not match reservations')
        self.status = {'name': name, 'guid': guid, 'phase': 'starting'}
        self.next_query = 0
        self.stopped, self.travel_attempts = stopped, {}
        self.endpoint = getattr(rpc, "url", None)
        expected = "http://127.0.0.1:"+str(next(p for n,g,p in ROSTER if g==guid))+"/rpc"
        if self.endpoint is not None and self.endpoint != expected:
            raise Error("Maintenance endpoint differs from the fixed profile")

    def persist(self):
        self.save(self.data)

    def activity_phase(self):
        if c.quest_task_snapshot(self.guid).get('active') is True:
            return 'waiting_for_requested_quest_task'
        if (c.area_quest_snapshot(self.guid).get('active') is True
                or c.party_town_snapshot(self.guid).get('active') is True or profession_active(self.guid)):
            return 'waiting_for_requested_routine'
        return None

    def activities(self):
        return self.activity_phase() is not None

    def endpoint_bound(self):
        if self.endpoint is not None and getattr(self.rpc,'url',None)!=self.endpoint:
            raise Error('Maintenance endpoint changed')

    def travel_scene(self, expected_session=None, anchor=None, controls=None, leased=False):
        self.endpoint_bound()
        if self.stopped() or self.activities():raise Error('Class training defers to an active routine or stop')
        state=self.rpc.call('buddy-training.state',{})
        body=sync.session_id(state)
        if expected_session is not None and body!=expected_session:raise Error('Class training body changed')
        if state.get('copperKnown') is not True or integer(state.get('copper',0))==0:
            raise Error('Class training travel needs a positive actual wallet')
        world=self.rpc.call('buddy-world.snapshot',{})
        actions=self.rpc.call('buddy-actions.status',{})
        own,owner=world.get('self',{}),world.get('owner') or {}
        if (not c.BuddyControls.quest_scene_safe(actions,world,self.guid)
                or own.get('levelKnown') is not True or own.get('classKnown') is not True
                or integer(own.get('movementFlags',0)) & 0x080000ff
                or any(actions.get(k) is True for k in ('practicing','autoAttackRequested'))
                or state.get('actionInFlight') is True):
            raise Error('Class training needs a safe actual idle character')
        interaction=actions.get('interactionOwner','')
        if interaction and not (leased and interaction=='training'):
            raise Error('Another interaction owns the character')
        if not leased and any(actions.get(k) is True for k in ('moving','traveling')):
            raise Error('Class training waits for stationary movement')
        if controls is not None and any(actions.get(k,False) is not v for k,v in controls.items()):
            raise Error('Human control intent changed during training travel')
        if not isinstance(owner,dict) or integer(owner.get('guid',0)) not in (0,3):
            raise Error('Training owner identity changed')
        current=None
        if owner.get('present') is True:
            if (integer(owner.get('guid',0))!=3 or not point(owner)
                    or any(owner.get(k) is not True for k in ('aliveKnown','alive','unitFlagsKnown','movementFlagsKnown'))
                    or integer(owner.get('unitFlags',0)) & 0x80000
                    or integer(owner.get('movementFlags',0)) & 0x1ff
                    or integer(owner.get('extraMovementFlags',0))
                    or integer(owner.get('mapId',0))!=integer(own.get('mapId',0))):
                raise Error('Class training waits for Joel to stop out of combat')
            current=(integer(owner.get('mapId',0)), *(owner.get(k,0) for k in ('x','y','z')))
        if anchor is not None:
            old=anchor[0]
            if ((old is None)!=(current is None) or old is not None and
                    (old[0]!=current[0] or math.dist(old[1:],current[1:])>.35)):
                raise Error('Joel moved or returned during class training travel')
        return state,world,actions,current

    def travel_trainer(self, discovery, candidate):
        body=sync.session_id(discovery['state'])
        state,world,actions,owner=self.travel_scene(body)
        creature=candidate.get('creature',{})
        npc=integer(creature.get('guid',0))
        pos=actions['position']
        if (npc>>48!=0xf130 or npc&0xffffff==0 or npc>>24&0xffffff!=integer(creature.get('entry',0))
                or not point(creature) or creature.get('present') is not True
                or any(creature.get(k) is not True for k in ('aliveKnown','alive','healthKnown'))
                or integer(creature.get('health',0))==0 or integer(creature.get('npcFlags',0))&0x30!=0x30
                or integer(creature.get('mapId',0))!=integer(pos.get('mapId',0))
                or integer(creature.get('movementFlags',0))&0x080000ff
                or integer(creature.get('unitFlags',0))&0x80000):
            raise Error('Only an actual stationary same-map class trainer can be visited')
        trajectory=creature.get('trajectory',{})
        if trajectory.get('known') is True and (trajectory.get('stopped') is not True or trajectory.get('transportRelative') is True):
            raise Error('Class trainer is moving')
        distance=math.sqrt(sum((creature.get(k,0)-pos.get(k,0))**2 for k in ('x','y','z')))
        key=(body,npc,integer(world['self'].get('level',0)))
        if (not 4<distance<=100 or self.travel_attempts.get(key,0)>=3
                or key not in self.travel_attempts and len(self.travel_attempts)>=128):
            self.status['phase']='class_trainer_outside_local_travel_or_attempt_limit'
            return None
        controls={k:actions.get(k,False) for k in ('following','healing','assisting')}
        lease=self.rpc.call('buddy-actions.acquire_interaction',{'owner':'training','leaseMs':30000})
        token=lease.get('token')
        if not isinstance(token,str) or not 1<=len(token)<=128:
            raise Error('Class trainer lease is unconfirmed')
        try:
            self.travel_scene(body,anchor=(owner,),controls=controls,leased=True)
            self.travel_attempts[key]=self.travel_attempts.get(key,0)+1
            self.status['phase']='traveling_to_observed_class_trainer'
            traveler=self.rpc.fork() if isinstance(self.rpc,RPC) else self.rpc
            result,finished=queue.Queue(maxsize=1),threading.Event()
            def route():
                try:result.put((traveler.call('buddy-actions.travel_trainer',{'token':token,'npcGuid':str(npc)}),None))
                except Exception as exc:result.put((None,exc))
                finally:finished.set()
            threading.Thread(target=route,daemon=True).start()
            deadline,next_guard=time.monotonic()+36,time.monotonic()+.5
            while not finished.wait(.1):
                if self.stopped() or time.monotonic()>=deadline:raise Error('Class trainer travel stopped')
                if time.monotonic()>=next_guard:
                    self.travel_scene(body,anchor=(owner,),controls=controls,leased=True)
                    next_guard=time.monotonic()+.5
            response,error=result.get_nowait()
            if error is not None:raise Error('Class trainer travel is unconfirmed')
            self.travel_scene(body,anchor=(owner,),controls=controls,leased=True)
            if (response.get('reason')!='trainer_travel_within_distance' or response.get('moving') is True
                    or response.get('motionUnconfirmed') is True):
                self.status['phase']='class_trainer_route_stopped_before_arrival'
                return None
        finally:
            # Exact lease release also stops owned travel, even after cancellation.
            self.endpoint_bound()
            fresh=self.rpc.call('buddy-training.state',{})
            if sync.session_id(fresh)!=body:raise Error('Body changed; no stale trainer cleanup')
            released=self.rpc.call('buddy-actions.release_interaction',{'owner':'training','token':token})
            if released.get('interactionOwner','') or released.get('moving') is True or released.get('motionUnconfirmed') is True:
                raise Error('Class trainer lease cleanup is unconfirmed')
        state,world,actions,_=self.travel_scene(body,anchor=(owner,),controls=controls)
        fresh=self.rpc.call('buddy-training.discover',{})
        if sync.session_id(fresh.get('state',{}))!=body:raise Error('Trainer discovery body changed')
        nearby=fresh.get('nearby',[])
        if not isinstance(nearby,list) or len(nearby)>97:raise Error('Trainer observations exceed bound')
        matches=[row for row in nearby if row.get('interactable') is True
            and integer(row.get('creature',{}).get('guid',0))==npc]
        if len(matches)!=1:
            self.status['phase']='class_trainer_arrival_not_observed'
            return None
        return fresh,matches[0],world['self'],(body,owner,controls)

    def tick(self):
        activity=self.activity_phase()
        if self.stopped() or activity is not None:
            self.status['phase'] = activity or 'waiting_for_requested_routine'
            return
        if self.now() < self.next_query:
            return
        self.next_query = self.now() + 10
        world = self.rpc.call('buddy-world.snapshot', {})
        own, owner = world.get('self', {}), world.get('owner')
        if owner is None:
            owner = {}
        if (not isinstance(own, dict) or not isinstance(owner, dict)
                or integer(own.get('guid', 0)) != self.guid
                or integer(owner.get('guid', 0)) not in (0, 3)):
            raise Error('Maintenance character identity changed')
        # Local own mail and class training do not borrow Joel's party or
        # presence as authority. A fresh observed fight still takes priority.
        if (any(own.get(key) is not True for key in ('present','aliveKnown','alive','unitFlagsKnown'))
                or integer(own.get('unitFlags', 0)) & 0x80000
                or (integer(owner.get('guid', 0)) == 3 and owner.get('present') is True and owner.get('unitFlagsKnown') is True
                    and integer(owner.get('unitFlags', 0)) & 0x80000)):
            self.status['phase'] = 'waiting_out_of_combat'
            return
        a = self.rpc.call('buddy-actions.status', {})
        if any(a.get(k) for k in ('moving','castPending','motionUnconfirmed','autoAttacking','autoAttackRequested',
                                 'autoAttackUnconfirmed','interactionOwner','traveling','practicing')):
            self.status['phase'] = 'waiting_for_idle_companion'
            return
        pos = a.get('position', {})
        if (not isinstance(pos, dict) or own.get('mapKnown') is not True
                or pos.get('known') is not True or pos.get('mapKnown') is not True
                or integer(pos.get('mapId',0)) != integer(own.get('mapId',0))
                or any(type(pos.get(k)) not in (int,float) or not math.isfinite(pos[k])
                       or abs(pos[k]) >= 40000 for k in ('x','y','z'))):
            self.status['phase'] = 'waiting_for_known_companion_position'
            return
        if self.data['mail'] and self.data['mail'].get('status') == 'reserved':
            state=self.rpc.call('buddy-mail.state',{})
            if (state.get('sessionId') == self.data['mail']['sessionId']
                    and confirmed_mail(state.get('lastClaim',{}),self.data['mail']['mailId'])):
                self.data['mail']['status']='confirmed'
                self.persist()
        boxes = world.get('mailboxes', [])
        mailbox_near = (pos.get('known') is True and pos.get('mapKnown') is True
            and isinstance(boxes, list) and len(boxes) <= 32
            and all(type(pos.get(k)) in (int,float) and math.isfinite(pos[k]) for k in ('x','y','z'))
            and any(m.get('present') is True and m.get('positionKnown') is True and m.get('mapKnown') is True
                and integer(m.get('mapId',0)) == integer(pos.get('mapId',0))
                and all(type(m.get(k)) in (int,float) and math.isfinite(m[k]) for k in ('x','y','z'))
                and sum((m[k]-pos[k])**2 for k in ('x','y','z')) <= 25 for m in boxes))
        if mailbox_near and self.data['mail'] is None:
            mail = self.rpc.call('buddy-mail.list', {})
            if mail.get('listCurrent') is True and mail.get('listKnown') is True and not mail.get('claimReserved'):
                rows = mail.get('stipends', [])
                if rows and isinstance(rows, list) and len(rows) <= 50:
                    row = rows[0]
                    if integer(row.get('copper', 0)) == 10000 and integer(row.get('mailId', 0)) > 0:
                        request = {'sessionId': sync.session_id(mail), 'listRevision': mail['listRevision'],
                                   'mailboxGuid': mail['mailboxGuid'], 'mailId': row['mailId']}
                        self.data['mail'] = dict(request, status='reserved')
                        self.persist()  # A restart must not replay an ambiguous claim.
                        receipt = self.rpc.call('buddy-mail.claim_stipend', request).get('lastClaim', {})
                        if confirmed_mail(receipt,row['mailId']):
                            self.data['mail']['status'] = 'confirmed'
                            self.persist()
                        self.status['phase'] = 'stipend_' + self.data['mail']['status']
                        return
        if self.data['training'] and self.data['training'][-1]['status'] == 'reserved':
            pending = self.data['training'][-1]
            state = self.rpc.call('buddy-training.state', {})
            purchase = state.get('lastPurchase', {})
            if (sync.session_id(state) == pending['session'] and integer(purchase.get('spellId',0)) == pending['spell']
                    and integer(purchase.get('id',0)) > pending['baselineId']
                    and integer(purchase.get('npcGuid',0)) == integer(pending['npc'])
                    and integer(purchase.get('costCopper',0)) == pending['cost']):
                if (purchase.get('status') == 'TRAINING_CONFIRMED' and purchase.get('serverSuccessObserved') is True
                        and (purchase.get('learnedSpellObserved') is True or purchase.get('refreshedTrainerKnows') is True)):
                    pending['status'] = 'confirmed'
                    self.persist()
                elif purchase.get('status') == 'SERVER_REJECTED':
                    pending['status'] = 'rejected'
                    self.persist()
            if pending['status'] == 'reserved':
                self.status['phase'] = 'waiting_for_training_confirmation'
                return
        if len(self.data['training']) >= 128 or self.data['reservedCopper'] >= 10000:
            self.status['phase'] = 'training_budget_reserved'
            return
        discovery = self.rpc.call('buddy-training.discover', {})
        state = discovery.get('state', {})
        nearby = discovery.get('nearby', [])
        if not isinstance(nearby, list) or len(nearby) > 97:
            raise Error('Trainer observations exceed bound')
        trainers = [row for row in nearby if row.get('interactable') is True]
        travel_guard=None
        if not trainers:
            candidates=[row for row in nearby if row.get('blockedReason')=='trainer_outside_conservative_range'
                and row.get('distanceKnown') is True and type(row.get('distance')) in (int,float)
                and math.isfinite(row['distance']) and 4<row['distance']<=100
                and self.travel_attempts.get((sync.session_id(state),integer(row.get('creature',{}).get('guid',0)),integer(own.get('level',0))),0)<3]
            if not candidates:
                self.status['phase'] = 'waiting_near_class_trainer_or_mailbox'
                return
            arrival=self.travel_trainer(discovery,min(candidates,key=lambda row:(row['distance'],integer(row['creature']['guid']))))
            if arrival is None:return
            discovery,trainer,own,travel_guard=arrival
            state,trainers=discovery['state'],[trainer]
        npc = trainers[0].get('creature', {}).get('guid')
        listed_body=sync.session_id(state)
        state = self.rpc.call('buddy-training.list', {'sessionId': listed_body, 'npcGuid': npc})
        if sync.session_id(state)!=listed_body:raise Error('Class trainer offer belongs to a changed body')
        offer = state.get('offer', {})
        if (integer(offer.get('npcGuid', 0)) != integer(npc) or integer(offer.get('expiresInMs', 0)) <= 0
                or integer(offer.get('trainerType', 0)) != 0 or state.get('copperKnown') is not True):
            self.status['phase'] = 'waiting_for_current_class_training_offer'
            return
        spells = offer.get('spells', [])
        if not isinstance(spells, list) or len(spells) > 256:
            raise Error('Training offer exceeds bound')
        attempted = {row['spell'] for row in self.data['training']}
        budget = min(10000-self.data['reservedCopper'], integer(state.get('copper', 0)))
        choices = [s for s in spells if integer(s.get('usable', 0)) == 0 and integer(s.get('spellId',0)) > 0
                   and not any(integer(v) for v in s.get('pointCost', []))
                   and 0 <= integer(s.get('costCopper',0)) <= budget
                   and integer(s.get('requiredLevel',0)) <= integer(own.get('level',0))
                   and integer(s.get('spellId',0)) not in attempted]
        if not choices:
            self.status['phase'] = 'no_affordable_unattempted_class_training'
            return
        spell = min(choices, key=lambda s:(integer(s.get('costCopper',0)), integer(s['spellId'])))
        cost, spell_id = integer(spell.get('costCopper',0)), integer(spell['spellId'])
        if travel_guard is not None:
            body,owner,controls=travel_guard
            self.travel_scene(body,anchor=(owner,),controls=controls)
        self.data['training'].append({'session':sync.session_id(state), 'spell':spell_id, 'cost':cost,
            'npc':str(npc), 'baselineId':integer(state.get('lastPurchase',{}).get('id',0)), 'status':'reserved'})
        self.data['reservedCopper'] += cost
        self.persist()  # Reserve the cumulative budget before any purchase packet.
        self.rpc.call('buddy-training.buy', {'sessionId':sync.session_id(state), 'npcGuid':npc,
            'offerRevision':offer['revision'], 'spellId':spell_id, 'expectedCostCopper':cost, 'maxSpendCopper':budget})
        self.status['phase'] = 'waiting_for_training_confirmation'


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command',choices=('run','status','stop'))
    parser.add_argument('--state-dir',type=Path,default=ROOT/'data/party-maintenance')
    parser.add_argument('--max-hours',type=float,default=8)
    args=parser.parse_args()
    if not math.isfinite(args.max_hours) or not 0 < args.max_hours <= 8:
        parser.error('Runtime must be greater than0 and at most8hours')
    folder=c.ensure_state(args.state_dir)
    with os.fdopen(c.private_open(folder/'lock',os.O_RDWR|os.O_CREAT),'r+') as lock:
        record=c.read_json(folder/'status.json')
        if record and record.get('identity') != IDENTITY:
            raise Error('Directory tracks a different maintenance routine')
        if args.command != 'run':
            running=c.is_locked(lock)
            if args.command == 'status':print(json.dumps(dict(record,running=running),indent=2))
            elif running:
                instance=record.get('instance','')
                if len(instance)!=32 or any(x not in '0123456789abcdef' for x in instance):raise Error('Unconfirmed maintenance instance')
                c.write_json(folder/'stop.json',{'identity':IDENTITY,'instance':instance})
                print('Party maintenance stop requested.')
            else:print('Party maintenance is not running.')
            return
        try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:raise Error('Party maintenance already runs') from None
        record={'identity':IDENTITY,'instance':uuid.uuid4().hex,'pid':os.getpid(),'phase':'running'}
        stop_requested=False
        def stop(signum,frame):
            nonlocal stop_requested
            stop_requested=True
        signal.signal(signal.SIGINT,stop);signal.signal(signal.SIGTERM,stop)
        deadline=time.monotonic()+args.max_hours*3600
        def stopped():
            return stop_requested or time.monotonic()>=deadline or c.read_json(folder/'stop.json')=={'identity':IDENTITY,'instance':record['instance']}
        profiles=[]
        for name,guid,port in ROSTER:
            path=folder/('character-'+str(guid)+'.json')
            stored=load_character(path)
            profiles.append(Maintenance(name,guid,RPC('http://127.0.0.1:'+str(port)+'/rpc',timeout=8),
                lambda value,path=path:c.write_json(path,value),stored or None,stopped=stopped))
        def status():
            record.update(updatedAt=time.time(),characters=[p.status for p in profiles])
            c.write_json(folder/'status.json',record)
        try:
            while not stopped():
                for p in profiles:
                    if stopped():break
                    try:p.tick()
                    except (Error,KeyError,TypeError,ValueError):p.status['phase']='service_request_or_observation_unavailable'
                    status()
                until=time.monotonic()+1
                while time.monotonic()<until and not stopped():time.sleep(.1)
        finally:
            record['phase']='stopped';status()

if __name__=='__main__':
    try:main()
    except (Error,OSError) as e:raise SystemExit('Party maintenance: '+str(e))
