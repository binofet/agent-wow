def load_character(path):
    try:
        with os.fdopen(c.private_open(path, os.O_RDONLY),'r') as source:
            raw=source.read(STATE_BYTES+1)
        if len(raw)>STATE_BYTES:raise Error('Maintenance character state exceeds its bound')
        value=json.loads(raw)
        if not isinstance(value,dict):raise ValueError
        return value
    except FileNotFoundError:return {}
    except ValueError:raise Error('Invalid maintenance character state') from None

def confirmed_mail(receipt, mail_id):
    return (integer(receipt.get('mailId',0)) == integer(mail_id)
        and receipt.get('status') == 'CLAIM_CONFIRMED' and receipt.get('serverAcknowledged') is True
        and receipt.get('walletIncreaseObserved') is True and integer(receipt.get('confirmedCopper',0)) == 10000)

class RPC(sync.SyncRPC):
    EXTRA = sync.SyncRPC.EXTRA | {'buddy-mail.list', 'buddy-mail.state', 'buddy-mail.claim_stipend',
        'buddy-training.discover', 'buddy-training.state', 'buddy-training.list', 'buddy-training.buy',
        'buddy-actions.travel_trainer', 'buddy-actions.travel_to'}

    def fork(self):
        return RPC(self.url, self.timeout)

    def call(self, method, params):
        if method not in ('buddy-actions.travel_trainer','buddy-actions.travel_to'):
            return super().call(method, params)
        self.request_id += 1
        request_id = self.request_id
        request = urllib.request.Request(self.url, data=json.dumps({'jsonrpc':'2.0','id':request_id,
            'method':method,'params':params}, allow_nan=False).encode(), headers={'Content-Type':'application/json'})
        try:
            with self.opener.open(request, timeout=35) as response:
                raw=response.read(262145)
            value=json.loads(raw) if len(raw)<=262144 else None
        except (OSError,ValueError,urllib.error.URLError):
            raise Error('Class trainer travel response is unconfirmed') from None
        if (not isinstance(value,dict) or value.get('jsonrpc')!='2.0' or type(value.get('id')) is not int
                or value['id']!=request_id or 'error' in value or not isinstance(value.get('result'),dict)):
            raise Error('Class trainer travel response is unconfirmed')
        return value['result']

def point(value):
    return (isinstance(value,dict) and value.get('positionKnown') is True and value.get('mapKnown') is True
        and all(type(value.get(k,0)) in (int,float) and math.isfinite(value.get(k,0))
                and abs(value.get(k,0))<40000 for k in ('x','y','z')))

def profession_active(guid):
    folder=ROOT/'data/professions'/str(guid)
    try:
        if folder.is_symlink():return True
        with os.fdopen(c.private_open(folder/'lock',os.O_RDONLY),'r') as lock:
            return c.is_locked(lock)
    except FileNotFoundError:return False
    except (OSError,Error):return True

def harvest_after_maintenance(actor, worker, prior_query):
    if worker is None:return
    if not harvest.maintenance_idle(actor):
        if actor.next_query!=prior_query or 'harvest' not in actor.status:
            message=('Harvest waits for maintenance out-of-combat safety' if actor.status.get('phase')=='waiting_out_of_combat'
                else 'Harvest yields to stop or higher-priority work')
            actor.status['harvest']=worker.report_wait(harvest.Error(message))
        return
    if actor.next_query==prior_query:return
    try:actor.status['harvest']=worker.tick()
    except (harvest.Error,harvest.prof.Error,OSError,KeyError,TypeError,ValueError) as exc:
        actor.status['harvest']=worker.report_wait(exc)

class Maintenance:
    def __init__(self, name, guid, rpc, save, stored=None, now=time.time, stopped=lambda:False,
                 reserve_copper=DEFAULT_RESERVE):
        if (name, guid) not in {(n, g) for n, g, _ in ROSTER}:
            raise Error('Maintenance supports only the configured companion profiles')
        if type(reserve_copper) is not int or not 0 <= reserve_copper <= CLASS_PURCHASE_CAP:
            raise Error('Class training wallet reserve is invalid')
        self.name, self.guid, self.rpc, self.save, self.now = name, guid, rpc, save, now
        self.reserve_copper = reserve_copper
        self.persistence_failed = False
        identity = {'version': 2, 'name': name, 'guid': guid, 'ownerGuid': 3}
        legacy = {'name': name, 'guid': guid, 'ownerGuid': 3, 'budgetCopper': 10000}
        self.data = copy.deepcopy(stored) if stored else {'identity': identity, 'reservedCopper': 0,
            'spentCopper': 0, 'training': [], 'rejections': {}, 'mail': None}
        migrating = self.data.get('identity') == legacy
        if self.data.get('identity') not in (identity, legacy):
            raise Error('Maintenance state identity is invalid')
        rows = self.data.get('training')
        total = self.data.get('reservedCopper')
        if (type(total) is not int or not 0 <= total <= (10000 if migrating else AUDIT_MAX)
                or not isinstance(rows, list) or len(rows) > (128 if migrating else HISTORY_LIMIT)
                or self.data.get('mail') is not None and not isinstance(self.data['mail'], dict)):
            raise Error('Maintenance state bounds are invalid')
        for i, row in enumerate(rows):
            if (not isinstance(row, dict) or not isinstance(row.get('session'), str)
                    or not 1 <= len(row['session']) <= 128 or type(row.get('spell')) is not int
                    or not 0 < row['spell'] <= 2**32-1 or type(row.get('cost')) is not int
                    or not 0 <= row['cost'] <= (10000 if migrating else CLASS_PURCHASE_CAP)
                    or not 0 < integer(row.get('npc',0)) <= 2**64-1
                    or type(row.get('baselineId')) is not int or row['baselineId'] < 0
                    or row.get('status') not in ('reserved','confirmed','rejected','known_at_trainer')
                    or row['status'] == 'reserved' and i != len(rows)-1):
                raise Error('Training reservation is invalid')
            if row.get('eligibility') is not None:self.checked_eligibility(row['eligibility'])
        if migrating:
            if sum(row['cost'] for row in rows) != total:
                raise Error('Legacy training budget does not match reservations')
            self.data.update(identity=identity, spentCopper=sum(r['cost'] for r in rows if r['status']=='confirmed'),
                rejections={str(r['spell']):{'attempts':1,'eligibility':None} for r in rows if r['status']=='rejected'},
                training=rows[-HISTORY_LIMIT:])
        spent = self.data.get('spentCopper')
        rejected = self.data.get('rejections')
        if (type(spent) is not int or not 0 <= spent <= total or not isinstance(rejected,dict)
                or len(rejected)>REJECTION_LIMIT or sum(r['cost'] for r in self.data['training'])>total
                or sum(r['cost'] for r in self.data['training'] if r['status']=='confirmed')>spent):
            raise Error('Training audit totals or rejection records are invalid')
        for spell, record in rejected.items():
            if (not isinstance(spell,str) or not spell.isascii() or not spell.isdigit()
                    or str(int(spell))!=spell or not 0<int(spell)<=2**32-1 or not isinstance(record,dict)
                    or type(record.get('attempts')) is not int or not 1<=record['attempts']<=REJECT_ATTEMPTS):
                raise Error('Training rejection record is invalid')
            if record.get('eligibility') is not None:self.checked_eligibility(record['eligibility'])
        self.status = {'name': name, 'guid': guid, 'phase': 'starting', 'exhaustedTrainerCount': 0}
        self.next_query = 0
        self.stopped, self.travel_attempts = stopped, {}
        self.exhausted_trainers, self.exhausted_body = {}, None
        self.endpoint = getattr(rpc, "url", None)
        expected = "http://127.0.0.1:"+str(next(p for n,g,p in ROSTER if g==guid))+"/rpc"
        if self.endpoint is not None and self.endpoint != expected:
            raise Error("Maintenance endpoint differs from the fixed profile")

    @staticmethod
    def checked_eligibility(value):
        if (not isinstance(value,dict) or set(value)!={'level','skill','rank'}
                or any(type(value[k]) is not int for k in value)
                or not 1<=value['level']<=80 or not 0<=value['skill']<=2**32-1
                or not -1<=value['rank']<=65535):
            raise Error('Training eligibility evidence is invalid')
        return value

    def persist(self):
        if len(json.dumps(self.data,indent=2).encode())>STATE_BYTES:
            raise Error('Maintenance character state exceeds its bound')
        try:self.save(self.data)
        except Exception:
            self.persistence_failed=True
            raise

    def settle_training(self, row, result):
        if row['status']!='reserved':return
        row['status']=result
        if result=='confirmed':self.data['spentCopper']+=row['cost']
        if result=='rejected':
            key=str(row['spell']);previous=self.data['rejections'].get(key,{})
            if key not in self.data['rejections'] and len(self.data['rejections'])>=REJECTION_LIMIT:
                raise Error('Class training rejection evidence exceeds its bound')
            self.data['rejections'][key]={'attempts':min(REJECT_ATTEMPTS,previous.get('attempts',0)+1),
                'eligibility':row.get('eligibility')}
        else:self.data['rejections'].pop(str(row['spell']),None)
        self.persist()

    def eligibility(self, world, spell):
        own=world['self'];level=integer(own.get('level',0))
        if own.get('levelKnown') is not True or not 1<=level<=80:return None
        skill=integer(spell.get('requiredSkill',0));rank=-1
        if skill==0:rank=0
        elif world.get('selfSkillsKnown') is True:
            rows=world.get('selfSkills',[])
            if (not isinstance(rows,list) or len(rows)!=128
                    or {integer(r.get('slot',0)) for r in rows}!=set(range(128))):return None
            matches=[r for r in rows if integer(r.get('skillId',0))==skill]
            if len(matches)==1:rank=integer(matches[0].get('value',0))
        return self.checked_eligibility({'level':level,'skill':skill,'rank':rank})

    def retry_allowed(self, spell, evidence):
        previous=self.data['rejections'].get(str(spell))
        if previous is None:return True
        old=previous.get('eligibility')
        if old is None:
            previous['eligibility']=evidence;self.persist()
            return False  # A migrated rejection has no older eligibility to compare.
        if (old['rank']<0 and evidence['skill']==old['skill'] and evidence['rank']>=0
                and evidence['level']<=old['level']):
            previous['eligibility']=dict(evidence,level=old['level']);self.persist()
            return False
        return (previous['attempts']<REJECT_ATTEMPTS and
            (evidence['level']>old['level'] or evidence['skill']==old['skill'] and evidence['skill']>0
                and old['rank']>=0 and evidence['rank']>old['rank']))

    def reconcile_training(self, state):
        if not self.data['training'] or self.data['training'][-1]['status']!='reserved':return None
        pending=self.data['training'][-1];purchase=state.get('lastPurchase',{})
        if (sync.session_id(state)==pending['session'] and integer(purchase.get('spellId',0))==pending['spell']
                and integer(purchase.get('id',0))>pending['baselineId']
                and integer(purchase.get('npcGuid',0))==integer(pending['npc'])
                and integer(purchase.get('costCopper',0))==pending['cost']):
            if (purchase.get('status')=='TRAINING_CONFIRMED' and purchase.get('serverSuccessObserved') is True
                    and (purchase.get('learnedSpellObserved') is True or purchase.get('refreshedTrainerKnows') is True)):
                self.settle_training(pending,'confirmed')
            elif purchase.get('status')=='SERVER_REJECTED':self.settle_training(pending,'rejected')
            elif purchase.get('status')=='KNOWN_AT_TRAINER' and purchase.get('refreshedTrainerKnows') is True:
                self.settle_training(pending,'known_at_trainer')
        return pending if pending['status']=='reserved' else None

    def trainer_prerequisites(self, world, skills):
        own=world.get('self',{})
        if own.get('levelKnown') is not True or not 1<=integer(own.get('level',0))<=80:return None
        ranks=[]
        if skills:
            rows=world.get('selfSkills',[])
            if (world.get('selfSkillsKnown') is not True or not isinstance(rows,list) or len(rows)!=128
                    or {integer(r.get('slot',0)) for r in rows}!=set(range(128))):return None
            for skill in skills:
                found=[integer(r.get('value',0)) for r in rows if integer(r.get('skillId',0))==skill]
                if len(found)>1:return None
                ranks.append((skill,found[0] if found else 0))
        return integer(own['level']),tuple(ranks)

    def trainer_exhausted(self, body, npc, world, state):
        if body!=self.exhausted_body:
            self.exhausted_trainers.clear();self.exhausted_body=body
            self.status['exhaustedTrainerCount']=0
        cached=self.exhausted_trainers.get(integer(npc))
        if cached is None:return False
        current=self.trainer_prerequisites(world,cached['skills'])
        if current is None or state.get('copperKnown') is not True:return False
        budget=min(CLASS_PURCHASE_CAP,max(0,integer(state.get('copper',0))-self.reserve_copper))
        if current!=cached['prerequisites'] or cached['nextCost'] is not None and budget>=cached['nextCost']:
            self.exhausted_trainers.pop(integer(npc),None)
            self.status['exhaustedTrainerCount']=len(self.exhausted_trainers);return False
        return True

    def remember_exhausted_trainer(self, body, npc, world, state, spells, attempted, budget):
        # Only a fresh, complete normal class list can suppress a later visit.
        # Errors, unresolved purchases and definite failures never become exhaustion.
        purchase=state.get('lastPurchase')
        if (state.get('actionInFlight') is True or purchase and
                purchase.get('status') not in ('TRAINING_CONFIRMED','KNOWN_AT_TRAINER')
                or any(r['status'] in ('reserved','rejected') and integer(r['npc'])==integer(npc)
                    for r in self.data['training'])):return
        skills=set();costs=[]
        for spell in spells:
            sid,usable=integer(spell.get('spellId',0)),integer(spell.get('usable',0))
            points=spell.get('pointCost')
            if (not 0<sid<=2**32-1 or usable not in (0,1,2) or not isinstance(points,list)
                    or len(points)!=2 or any(integer(v) for v in points)
                    or str(sid) in self.data['rejections']):return
            if usable!=2:
                abilities=spell.get('requiredAbilities',[])
                if (not isinstance(abilities,list) or len(abilities)>3
                        or any(integer(v)>2**32-1 for v in abilities)):return
                # Unavailable at the current level with an unobserved spell
                # prerequisite cannot establish durable trainer exhaustion.
                if (usable==1 and integer(spell.get('requiredLevel',0))<=integer(world['self'].get('level',0))
                        and any(integer(v) for v in abilities)):return
                skill=integer(spell.get('requiredSkill',0))
                if skill:skills.add(skill)
                cost=integer(spell.get('costCopper',0))
                if usable==0 and sid not in attempted and budget<cost<=CLASS_PURCHASE_CAP:costs.append(cost)
        skills=tuple(sorted(skills));prerequisites=self.trainer_prerequisites(world,skills)
        if prerequisites is None:return
        if body!=self.exhausted_body:
            self.exhausted_trainers.clear();self.exhausted_body=body
        if integer(npc) not in self.exhausted_trainers and len(self.exhausted_trainers)>=128:
            self.exhausted_trainers.pop(next(iter(self.exhausted_trainers)))
        self.exhausted_trainers[integer(npc)]={'skills':skills,'prerequisites':prerequisites,
            'nextCost':min(costs) if costs else None}
        self.status['exhaustedTrainerCount']=len(self.exhausted_trainers)

    def activity_phase(self):
        if c.quest_task_snapshot(self.guid).get('active') is True:
            return 'waiting_for_requested_quest_task'
        town=c.party_town_snapshot(self.guid)
        town_busy=(town.get('active') is True and town.get('busy') is not False or town.get('active') is not True and
            harvest.routine_locked(ROOT/'data/party-town'/str(self.guid)/'lock'))
        if (c.area_quest_snapshot(self.guid).get('active') is True or town_busy or profession_active(self.guid)):
            return 'waiting_for_requested_routine'
        return None

    def activities(self):
        return self.activity_phase() is not None

    def endpoint_bound(self):
        if self.endpoint is not None and getattr(self.rpc,'url',None)!=self.endpoint:
            raise Error('Maintenance endpoint changed')

    def travel_scene(self, expected_session=None, anchor=None, controls=None, leased=False, lease_owner='training'):
        self.endpoint_bound()
        if self.stopped() or self.activities():raise Error('Class training defers to an active routine or stop')
        state=self.rpc.call('buddy-training.state',{})
        body=sync.session_id(state)
        if expected_session is not None and body!=expected_session:raise Error('Class training body changed')
        if state.get('copperKnown') is not True or integer(state.get('copper',0))==0:
            raise Error('Class training travel needs a positive actual wallet')
        world=self.rpc.call('buddy-world.snapshot',{})
        actions=self.rpc.call('buddy-actions.status',{})
        own,owner=world.get('self',{}),world.get('owner') or {}
        if (not c.BuddyControls.quest_scene_safe(actions,world,self.guid)
                or own.get('levelKnown') is not True or own.get('classKnown') is not True
                or integer(own.get('movementFlags',0)) & 0x080000ff
                or any(actions.get(k) is True for k in ('practicing','autoAttackRequested'))
                or state.get('actionInFlight') is True):
            raise Error('Class training needs a safe actual idle character')
        interaction=actions.get('interactionOwner','')
        if interaction and not (leased and interaction==lease_owner):
            raise Error('Another interaction owns the character')
        if not leased and any(actions.get(k) is True for k in ('moving','traveling')):
            raise Error('Class training waits for stationary movement')
        if controls is not None and any(actions.get(k,False) is not v for k,v in controls.items()):
            raise Error('Human control intent changed during training travel')
        if not isinstance(owner,dict) or integer(owner.get('guid',0)) not in (0,3):
            raise Error('Training owner identity changed')
        current=None
        if owner.get('present') is True:
            if (integer(owner.get('guid',0))!=3 or not point(owner)
                    or any(owner.get(k) is not True for k in ('aliveKnown','alive','unitFlagsKnown','movementFlagsKnown'))
                    or integer(owner.get('unitFlags',0)) & 0x80000
                    or integer(owner.get('movementFlags',0)) & 0x1ff
                    or integer(owner.get('extraMovementFlags',0))
                    or integer(owner.get('mapId',0))!=integer(own.get('mapId',0))):
                raise Error('Class training waits for Joel to stop out of combat')
            current=(integer(owner.get('mapId',0)), *(owner.get(k,0) for k in ('x','y','z')))
        if anchor is not None:
            old=anchor[0]
            if ((old is None)!=(current is None) or old is not None and
                    (old[0]!=current[0] or math.dist(old[1:],current[1:])>.35)):
                raise Error('Joel moved or returned during class training travel')
        return state,world,actions,current

    def route_call(self, method, params, guard, deadline, renew=None):
        if time.monotonic()>=deadline:raise Error('Class trainer travel time limit reached')
        traveler=self.rpc.fork() if isinstance(self.rpc,RPC) else self.rpc
        result,finished=queue.Queue(maxsize=1),threading.Event()
        def route():
            try:result.put((traveler.call(method,params),None))
            except Exception as exc:result.put((None,exc))
            finally:finished.set()
        threading.Thread(target=route,daemon=True).start()
        next_guard=time.monotonic()+.5
        while not finished.wait(.1):
            if self.stopped() or time.monotonic()>=deadline:raise Error('Class trainer travel stopped')
            if time.monotonic()>=next_guard:
                guard()
                if renew is not None:renew()
                next_guard=time.monotonic()+.5
        response,error=result.get_nowait()
        if error is not None:raise Error('Class trainer travel is unconfirmed')
        guard()
        if time.monotonic()>=deadline:raise Error('Class trainer travel time limit reached')
        return response

    def release_route(self, body, owner, token):
        self.endpoint_bound()
        fresh=self.rpc.call('buddy-training.state',{})
        if sync.session_id(fresh)!=body:raise Error('Body changed; no stale trainer cleanup')
        released=self.rpc.call('buddy-actions.release_interaction',{'owner':owner,'token':token})
        if released.get('interactionOwner','') or released.get('moving') is True or released.get('motionUnconfirmed') is True:
            raise Error('Class trainer lease cleanup is unconfirmed')

    @staticmethod
    def own_class_trainers(nearby, own):
        expected=INN_TRAINERS.get(integer(own.get('classId',0))) if own.get('classKnown') is True else None
        return [row for row in nearby if integer(row.get('creature',{}).get('entry',0)) not in INN_TRAINERS.values()
                or integer(row.get('creature',{}).get('entry',0))==expected]

    @staticmethod
    def inn_route(creature, own, pos):
        if (integer(pos.get('mapId',0))!=0 or integer(creature.get('mapId',0))!=0
                or integer(creature.get('entry',0))!=INN_TRAINERS.get(integer(own.get('classId',0)))
                or not -9480<=creature.get('x',0)<=-9455 or not 8<=creature.get('y',0)<=39
                or not 63<=creature.get('z',0)<=65 or not -9490<=pos['x']<=-9410
                or not 0<=pos['y']<=85 or not 54<=pos['z']<=65.5):
            return None
        x,y,z=(pos[k] for k in ('x','y','z'))
        if z>=62.8:return []
        if -9474.5<=x<=-9472.5 and 14<=y<=23.5 and z>=60:
            return [(INN_STAIRS[3],.75)]
        if -9478.5<=x<=-9473 and 13<=y<=15 and 59.5<=z<=61:
            return [(p,.75) for p in INN_STAIRS[2:]]
        if -9478.5<=x<=-9475.5 and 15<y<=22.5 and 56.8<=z<=60.7:
            return [(p,.75) for p in INN_STAIRS[1:]]
        if -9468<=x<=-9462 and 29<=y<=35.5 and 56<=z<=58.3:
            return [((-9467.,30.,56.96606),.75)]+[(p,.75) for p in INN_STAIRS]
        route=[]
        if x>-9435 and 45<=y<=70:
            route.append(((-9432.,60.,56.625515),.5))
        route.append(((-9465.93,24.9355,56.52882),.5))
        return route+[(p,.75) for p in INN_STAIRS]

    def travel_inn(self, body, creature, owner, controls, key, route, deadline, extra_guard=None):
        npc=integer(creature['guid'])
        binding=tuple(creature.get(k,0) for k in ('mapId','x','y','z','positionRevision'))
        lease=self.rpc.call('buddy-actions.acquire_interaction',{'owner':'exploration','leaseMs':30000})
        token=lease.get('token')
        control=lease.get('state',{})
        if not isinstance(token,str) or not 1<=len(token)<=128:raise Error('Inn exploration lease is unconfirmed')
        def guard():
            if time.monotonic()>=deadline:raise Error('Class trainer inn route time limit reached')
            scene=self.travel_scene(body,anchor=(owner,),controls=controls,leased=True,lease_owner='exploration')
            fresh=self.rpc.call('buddy-training.discover',{})
            if sync.session_id(fresh.get('state',{}))!=body:raise Error('Inn trainer body changed')
            rows=fresh.get('nearby',[])
            if not isinstance(rows,list) or len(rows)>97:raise Error('Inn trainer observations exceed bound')
            matches=[row.get('creature',{}) for row in rows if integer(row.get('creature',{}).get('guid',0))==npc]
            if len(matches)!=1:raise Error('Actual inn trainer is no longer observed')
            current=matches[0]
            if (tuple(current.get(k,0) for k in ('mapId','x','y','z','positionRevision'))!=binding
                    or current.get('present') is not True or not point(current)
                    or any(current.get(k) is not True for k in ('aliveKnown','alive','healthKnown'))
                    or integer(current.get('health',0))==0 or integer(current.get('npcFlags',0))&0x30!=0x30
                    or integer(current.get('movementFlags',0))&0x080000ff or integer(current.get('unitFlags',0))&0x80000
                    or self.inn_route(current,scene[1]['self'],scene[2]['position']) is None):
                raise Error('Actual inn trainer or character context changed')
            trajectory=current.get('trajectory',{})
            if trajectory.get('known') is True and (trajectory.get('stopped') is not True or trajectory.get('transportRelative') is True):
                raise Error('Actual inn trainer moved')
            if extra_guard is not None:extra_guard(scene[0],scene[1])
            return scene
        renew_at=[0.]
        def renew(force=False):
            if not force and time.monotonic()<renew_at[0]:return
            guard()
            renewed=self.rpc.call('buddy-actions.acquire_interaction',{'owner':'exploration','token':token,'leaseMs':30000})
            if renewed.get('token')!=token or renewed.get('state',{}).get('interactionOwner')!='exploration':
                raise Error('Inn route renewal is unconfirmed')
            renew_at[0]=time.monotonic()+20
        try:
            if (not isinstance(control,dict) or control.get('interactionOwner')!='exploration'
                    or control.get('moving') is True or control.get('motionUnconfirmed') is True):
                raise Error('Inn exploration stop is unconfirmed')
            guard()
            if key is not None:self.travel_attempts[key]=self.travel_attempts.get(key,0)+1
            for goal,radius in route:
                renew(True)
                self.status['phase']='traveling_verified_inn_stair_landings' if key is not None else 'returning_verified_inn_stair_landings'
                response=self.route_call('buddy-actions.travel_to',{'token':token,'mapId':0,
                    'x':goal[0],'y':goal[1],'z':goal[2],'arrivalDistance':radius},guard,deadline,renew)
                scene=guard()
                pos=scene[2]['position']
                if (response.get('reason')!='exploration_within_distance' or response.get('moving') is True
                        or response.get('motionUnconfirmed') is True
                        or math.dist(tuple(pos[k] for k in ('x','y','z')),goal)>radius+.01):
                    self.status['phase']='inn_stair_route_stopped_before_precise_arrival'
                    return False
            return True
        finally:
            self.release_route(body,'exploration',token)

    def return_from_exhausted_inn(self,body,creature):
        if integer(creature.get('entry',0)) not in INN_TRAINERS.values():return
        npc=integer(creature.get('guid',0));cached=self.exhausted_trainers.get(npc)
        if (cached is None or cached.get('returnAttempted') is True or self.exhausted_body!=body
                or any(row['status']=='reserved' for row in self.data['training'])
                or (self.data['mail'] or {}).get('status')=='reserved'):return
        state,world,actions,owner=self.travel_scene(body)
        pos=actions['position'];own=world['self']
        if (self.inn_route(creature,own,pos)!=[] or not -9480<=pos['x']<=-9455
                or not 8<=pos['y']<=39 or not 62.8<=pos['z']<=65.5
                or npc>>48!=0xf130 or not npc&0xffffff or npc>>24&0xffffff!=integer(creature.get('entry',0))
                or creature.get('present') is not True or not point(creature)
                or any(creature.get(k) is not True for k in ('aliveKnown','alive','healthKnown'))
                or not integer(creature.get('health',0)) or integer(creature.get('npcFlags',0))&0x30!=0x30
                or integer(creature.get('movementFlags',0))&0x080000ff or integer(creature.get('unitFlags',0))&0x80000
                or not self.trainer_exhausted(body,npc,world,state)):return
        controls={k:actions.get(k,False) for k in ('following','healing','assisting')}
        def still_exhausted(state,world):
            if self.exhausted_trainers.get(npc) is not cached or not self.trainer_exhausted(body,npc,world,state):
                raise Error('Inn return no longer has a current exhausted class offer')
        cached['returnAttempted']=True  # One finite route per positively observed exhausted visit.
        if self.travel_inn(body,creature,owner,controls,None,[(p,.75) for p in reversed(INN_STAIRS)],
                time.monotonic()+75,extra_guard=still_exhausted):
            self.status['phase']='no_affordable_unattempted_class_training'

    def travel_trainer(self, discovery, candidate):
        body=sync.session_id(discovery['state'])
        state,world,actions,owner=self.travel_scene(body)
        creature=candidate.get('creature',{})
        npc=integer(creature.get('guid',0))
        pos=actions['position']
        if (npc>>48!=0xf130 or npc&0xffffff==0 or npc>>24&0xffffff!=integer(creature.get('entry',0))
                or not point(creature) or creature.get('present') is not True
                or any(creature.get(k) is not True for k in ('aliveKnown','alive','healthKnown'))
                or integer(creature.get('health',0))==0 or integer(creature.get('npcFlags',0))&0x30!=0x30
                or integer(creature.get('mapId',0))!=integer(pos.get('mapId',0))
                or integer(creature.get('movementFlags',0))&0x080000ff
                or integer(creature.get('unitFlags',0))&0x80000):
            raise Error('Only an actual stationary same-map class trainer can be visited')
        trajectory=creature.get('trajectory',{})
        if trajectory.get('known') is True and (trajectory.get('stopped') is not True or trajectory.get('transportRelative') is True):
            raise Error('Class trainer is moving')
        distance=math.sqrt(sum((creature.get(k,0)-pos.get(k,0))**2 for k in ('x','y','z')))
        key=(body,npc,integer(world['self'].get('level',0)))
        if (not 4<distance<=100 or self.travel_attempts.get(key,0)>=3
                or key not in self.travel_attempts and len(self.travel_attempts)>=128):
            self.status['phase']='class_trainer_outside_local_travel_or_attempt_limit'
            return None
        controls={k:actions.get(k,False) for k in ('following','healing','assisting')}
        route=self.inn_route(creature,world['self'],pos)
        deadline=time.monotonic()+(75 if route else 36)
        if route and not self.travel_inn(body,creature,owner,controls,key,route,deadline):
            return None
        lease=self.rpc.call('buddy-actions.acquire_interaction',{'owner':'training','leaseMs':30000})
        token=lease.get('token')
        if not isinstance(token,str) or not 1<=len(token)<=128:
            raise Error('Class trainer lease is unconfirmed')
        try:
            self.travel_scene(body,anchor=(owner,),controls=controls,leased=True)
            if not route:self.travel_attempts[key]=self.travel_attempts.get(key,0)+1
            self.status['phase']='traveling_to_observed_class_trainer'
            response=self.route_call('buddy-actions.travel_trainer',{'token':token,'npcGuid':str(npc)},
                lambda:self.travel_scene(body,anchor=(owner,),controls=controls,leased=True),deadline)
            if (response.get('reason')!='trainer_travel_within_distance' or response.get('moving') is True
                    or response.get('motionUnconfirmed') is True):
                self.status['phase']='class_trainer_route_stopped_before_arrival'
                return None
        finally:
            # Exact lease release also stops owned travel, even after cancellation.
            self.release_route(body,'training',token)
        state,world,actions,_=self.travel_scene(body,anchor=(owner,),controls=controls)
        fresh=self.rpc.call('buddy-training.discover',{})
        if sync.session_id(fresh.get('state',{}))!=body:raise Error('Trainer discovery body changed')
        nearby=fresh.get('nearby',[])
        if not isinstance(nearby,list) or len(nearby)>97:raise Error('Trainer observations exceed bound')
        matches=[row for row in nearby if row.get('interactable') is True
            and integer(row.get('creature',{}).get('guid',0))==npc]
        if len(matches)!=1:
            self.status['phase']='class_trainer_arrival_not_observed'
            return None
        return fresh,matches[0],world['self'],(body,owner,controls)

    def tick(self):
        if self.persistence_failed:raise Error('Maintenance persistence failed; restart from the durable journal')
        activity=self.activity_phase()
        if self.stopped() or activity is not None:
            self.status['phase'] = activity or 'waiting_for_requested_routine'
            return
        if self.now() < self.next_query:
            return
        self.next_query = self.now() + 10
        world = self.rpc.call('buddy-world.snapshot', {})
        own, owner = world.get('self', {}), world.get('owner')
        if owner is None:
            owner = {}
        if (not isinstance(own, dict) or not isinstance(owner, dict)
                or integer(own.get('guid', 0)) != self.guid
                or integer(owner.get('guid', 0)) not in (0, 3)):
            raise Error('Maintenance character identity changed')
        # Local own mail and class training do not borrow Joel's party or
        # presence as authority. A fresh observed fight still takes priority.
        if (any(own.get(key) is not True for key in ('present','aliveKnown','alive','unitFlagsKnown'))
                or integer(own.get('unitFlags', 0)) & 0x80000
                or (integer(owner.get('guid', 0)) == 3 and owner.get('present') is True and owner.get('unitFlagsKnown') is True
                    and integer(owner.get('unitFlags', 0)) & 0x80000)):
            self.status['phase'] = 'waiting_out_of_combat'
            return
        a = self.rpc.call('buddy-actions.status', {})
        if any(a.get(k) for k in ('moving','castPending','motionUnconfirmed','autoAttacking','autoAttackRequested',
                                 'autoAttackUnconfirmed','interactionOwner','traveling','practicing')):
            self.status['phase'] = 'waiting_for_idle_companion'
            return
        pos = a.get('position', {})
        if (not isinstance(pos, dict) or own.get('mapKnown') is not True
                or pos.get('known') is not True or pos.get('mapKnown') is not True
                or integer(pos.get('mapId',0)) != integer(own.get('mapId',0))
                or any(type(pos.get(k)) not in (int,float) or not math.isfinite(pos[k])
                       or abs(pos[k]) >= 40000 for k in ('x','y','z'))):
            self.status['phase'] = 'waiting_for_known_companion_position'
            return
        if self.data['mail'] and self.data['mail'].get('status') == 'reserved':
            state=self.rpc.call('buddy-mail.state',{})
            if (state.get('sessionId') == self.data['mail']['sessionId']
                    and confirmed_mail(state.get('lastClaim',{}),self.data['mail']['mailId'])):
                self.data['mail']['status']='confirmed'
                self.persist()
        boxes = world.get('mailboxes', [])
        mailbox_near = (pos.get('known') is True and pos.get('mapKnown') is True
            and isinstance(boxes, list) and len(boxes) <= 32
            and all(type(pos.get(k)) in (int,float) and math.isfinite(pos[k]) for k in ('x','y','z'))
            and any(m.get('present') is True and m.get('positionKnown') is True and m.get('mapKnown') is True
                and integer(m.get('mapId',0)) == integer(pos.get('mapId',0))
                and all(type(m.get(k)) in (int,float) and math.isfinite(m[k]) for k in ('x','y','z'))
                and sum((m[k]-pos[k])**2 for k in ('x','y','z')) <= 25 for m in boxes))
        if mailbox_near and self.data['mail'] is None:
            mail = self.rpc.call('buddy-mail.list', {})
            if mail.get('listCurrent') is True and mail.get('listKnown') is True and not mail.get('claimReserved'):
                rows = mail.get('stipends', [])
                if rows and isinstance(rows, list) and len(rows) <= 50:
                    row = rows[0]
                    if integer(row.get('copper', 0)) == 10000 and integer(row.get('mailId', 0)) > 0:
                        request = {'sessionId': sync.session_id(mail), 'listRevision': mail['listRevision'],
                                   'mailboxGuid': mail['mailboxGuid'], 'mailId': row['mailId']}
                        self.data['mail'] = dict(request, status='reserved')
                        self.persist()  # A restart must not replay an ambiguous claim.
                        receipt = self.rpc.call('buddy-mail.claim_stipend', request).get('lastClaim', {})
                        if confirmed_mail(receipt,row['mailId']):
                            self.data['mail']['status'] = 'confirmed'
                            self.persist()
                        self.status['phase'] = 'stipend_' + self.data['mail']['status']
                        return
        pending=None
        if self.data['training'] and self.data['training'][-1]['status']=='reserved':
            pending=self.reconcile_training(self.rpc.call('buddy-training.state',{}))
        discovery = self.rpc.call('buddy-training.discover', {})
        state = discovery.get('state', {})
        nearby = discovery.get('nearby', [])
        if not isinstance(nearby, list) or len(nearby) > 97:
            raise Error('Trainer observations exceed bound')
        if sync.session_id(state)!=self.exhausted_body:
            self.exhausted_trainers.clear();self.exhausted_body=sync.session_id(state)
            self.status['exhaustedTrainerCount']=0
        nearby=self.own_class_trainers(nearby,own)
        if pending is not None:
            nearby=[r for r in nearby if integer(r.get('creature',{}).get('guid',0))==integer(pending['npc'])]
        else:
            before=len(nearby)
            exhausted_nearby=nearby
            nearby=[r for r in nearby if not self.trainer_exhausted(sync.session_id(state),
                r.get('creature',{}).get('guid',0),world,state)]
            if before and not nearby:
                self.status['phase']='no_affordable_unattempted_class_training'
                for row in exhausted_nearby:
                    self.return_from_exhausted_inn(sync.session_id(state),row.get('creature',{}))
                return
        trainers = [row for row in nearby if row.get('interactable') is True]
        travel_guard=None
        if not trainers:
            candidates=[row for row in nearby if row.get('blockedReason')=='trainer_outside_conservative_range'
                and row.get('distanceKnown') is True and type(row.get('distance')) in (int,float)
                and math.isfinite(row['distance']) and 4<row['distance']<=100
                and self.travel_attempts.get((sync.session_id(state),integer(row.get('creature',{}).get('guid',0)),integer(own.get('level',0))),0)<3]
            if not candidates:
                self.status['phase'] = 'waiting_for_training_confirmation' if pending else 'waiting_near_class_trainer_or_mailbox'
                return
            arrival=self.travel_trainer(discovery,min(candidates,key=lambda row:(row['distance'],integer(row['creature']['guid']))))
            if arrival is None:return
            discovery,trainer,own,travel_guard=arrival
            state,trainers=discovery['state'],[trainer]
        npc = trainers[0].get('creature', {}).get('guid')
        listed_body=sync.session_id(state)
        state = self.rpc.call('buddy-training.list', {'sessionId': listed_body, 'npcGuid': npc})
        if sync.session_id(state)!=listed_body:raise Error('Class trainer offer belongs to a changed body')
        offer = state.get('offer', {})
        if (integer(offer.get('npcGuid', 0)) != integer(npc) or integer(offer.get('expiresInMs', 0)) <= 0
                or integer(offer.get('trainerType', 0)) != 0 or state.get('copperKnown') is not True):
            self.status['phase'] = 'waiting_for_current_class_training_offer'
            return
        spells = offer.get('spells', [])
        if not isinstance(spells, list) or len(spells) > 256:
            raise Error('Training offer exceeds bound')
        if pending is not None:
            # This list was requested NOW, under the normal actual-NPC/class/lease gates.
            known=any(integer(s.get('spellId',0))==pending['spell'] and integer(s.get('usable',0))==2 for s in spells)
            if known:
                if sync.session_id(state)==pending['session']:
                    # The same body must also positively retire its own ambiguity.
                    if self.reconcile_training(state) is not None:
                        self.status['phase']='waiting_for_training_confirmation';return
                else:
                    pending['knowledgeSession']=sync.session_id(state)
                    self.settle_training(pending,'known_at_trainer')
            else:
                # New body + Usable0 is not proof the old connection was fully retired.
                self.status['phase']='waiting_for_training_confirmation';return
        known_ids={str(integer(s.get('spellId',0))) for s in spells if integer(s.get('usable',0))==2}
        if known_ids.intersection(self.data['rejections']):
            for key in known_ids:self.data['rejections'].pop(key,None)
            self.persist()
        attempted={r['spell'] for r in self.data['training'] if r['status'] in ('confirmed','known_at_trainer')}
        wallet=integer(state.get('copper',0))
        budget=min(CLASS_PURCHASE_CAP,max(0,wallet-self.reserve_copper))
        choices=[]
        for spell in spells:
            evidence=self.eligibility(world,spell)
            if (evidence is not None and integer(spell.get('usable',0))==0 and integer(spell.get('spellId',0))>0
                    and not any(integer(v) for v in spell.get('pointCost',[]))
                    and 0<=integer(spell.get('costCopper',0))<=budget
                    and integer(spell.get('requiredLevel',0))<=evidence['level']
                    and integer(spell['spellId']) not in attempted
                    and self.retry_allowed(integer(spell['spellId']),evidence)):
                choices.append(spell)
        if not choices:
            self.remember_exhausted_trainer(listed_body,npc,world,state,spells,attempted,budget)
            self.status['phase'] = 'no_affordable_unattempted_class_training'
            self.return_from_exhausted_inn(listed_body,trainers[0].get('creature',{}))
            return
        spell = min(choices, key=lambda s:(integer(s.get('costCopper',0)), integer(s['spellId'])))
        cost, spell_id = integer(spell.get('costCopper',0)), integer(spell['spellId'])
        if travel_guard is not None:
            body,owner,controls=travel_guard
            self.travel_scene(body,anchor=(owner,),controls=controls)
        if str(spell_id) not in self.data['rejections'] and len(self.data['rejections'])>=REJECTION_LIMIT:
            self.status['phase']='training_rejection_evidence_full';return
        if self.data['reservedCopper']>AUDIT_MAX-cost:
            raise Error('Training audit counter exceeds its bound')
        self.data['training']=self.data['training'][-(HISTORY_LIMIT-1):]
        self.data['training'].append({'session':sync.session_id(state), 'spell':spell_id, 'cost':cost,
            'eligibility':self.eligibility(world,spell),
            'npc':str(npc), 'baselineId':integer(state.get('lastPurchase',{}).get('id',0)), 'status':'reserved'})
        self.data['reservedCopper'] += cost
        self.persist()  # Persist the unresolved operation before any purchase packet.
        self.rpc.call('buddy-training.buy', {'sessionId':sync.session_id(state), 'npcGuid':npc,
            'offerRevision':offer['revision'], 'spellId':spell_id, 'expectedCostCopper':cost, 'maxSpendCopper':max(1,budget), 'reserveCopper':self.reserve_copper})
        self.status['phase'] = 'waiting_for_training_confirmation'


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command',choices=('run','status','stop'))
    parser.add_argument('--state-dir',type=Path,default=ROOT/'data/party-maintenance')
    parser.add_argument('--max-hours',type=float,default=8)
    parser.add_argument('--reserve-copper',type=int,default=DEFAULT_RESERVE)
    args=parser.parse_args()
    if not math.isfinite(args.max_hours) or not 0 < args.max_hours <= 8:
        parser.error('Runtime must be greater than0 and at most8hours')
    if not 0<=args.reserve_copper<=CLASS_PURCHASE_CAP:parser.error('Wallet reserve must be0..1000000copper')
    folder=c.ensure_state(args.state_dir)
    with os.fdopen(c.private_open(folder/'lock',os.O_RDWR|os.O_CREAT),'r+') as lock:
        record=c.read_json(folder/'status.json')
        if record and record.get('identity') != IDENTITY:
            raise Error('Directory tracks a different maintenance routine')
        if args.command != 'run':
            running=c.is_locked(lock)
            if args.command == 'status':print(json.dumps(dict(record,running=running),indent=2))
            elif running:
                instance=record.get('instance','')
                if len(instance)!=32 or any(x not in '0123456789abcdef' for x in instance):raise Error('Unconfirmed maintenance instance')
                c.write_json(folder/'stop.json',{'identity':IDENTITY,'instance':instance})
                print('Party maintenance stop requested.')
            else:print('Party maintenance is not running.')
            return
        try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:raise Error('Party maintenance already runs') from None
        record={'identity':IDENTITY,'instance':uuid.uuid4().hex,'pid':os.getpid(),'phase':'running'}
        stop_requested=False
        def stop(signum,frame):
            nonlocal stop_requested
            stop_requested=True
        signal.signal(signal.SIGINT,stop);signal.signal(signal.SIGTERM,stop)
        deadline=time.monotonic()+args.max_hours*3600
        def stopped():
            return stop_requested or time.monotonic()>=deadline or c.read_json(folder/'stop.json')=={'identity':IDENTITY,'instance':record['instance']}
        profiles=[]
        for name,guid,port in ROSTER:
            path=folder/('character-'+str(guid)+'.json')
            stored=load_character(path)
            profiles.append(Maintenance(name,guid,RPC('http://127.0.0.1:'+str(port)+'/rpc',timeout=8),
                lambda value,path=path:c.write_json(path,value),stored or None,stopped=stopped,reserve_copper=args.reserve_copper))
        harvesters={}
        for guid in harvest.ROLES:
            path=folder/('harvest-'+str(guid)+'.json')
            harvesters[guid]=harvest.Worker(guid,harvest.RPC('http://127.0.0.1:'+str(harvest.ROLES[guid][1])+'/rpc'),
                save=lambda value,path=path:c.write_json(path,value),stored=harvest.load_ledger(path),stopped=stopped)
        def status():
            record.update(updatedAt=time.time(),characters=[p.status for p in profiles])
            c.write_json(folder/'status.json',record)
        try:
            while not stopped():
                for p in profiles:
                    if stopped():break
                    prior_query=p.next_query
                    try:p.tick()
                    except (Error,KeyError,TypeError,ValueError):p.status['phase']='service_request_or_observation_unavailable'
                    # Harvest is the last, lowest-priority opportunity. It never
                    # holds a standing profession lock or changes intent toggles.
                    harvest_after_maintenance(p,harvesters.get(p.guid),prior_query)
                    status()
                until=time.monotonic()+1
                while time.monotonic()<until and not stopped():time.sleep(.1)
        finally:
            record['phase']='stopped';status()

if __name__=='__main__':
    try:main()
    except (Error,OSError) as e:raise SystemExit('Party maintenance: '+str(e))
