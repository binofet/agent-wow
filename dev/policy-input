#!/usr/bin/env python3
"""Send a structured command to a character's attached live Lua policy."""
import argparse
import importlib.machinery
import importlib.util
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('policy_input_transport', str(ROOT / 'dev/converse'))
spec = importlib.util.spec_from_loader(loader.name, loader)
transport = importlib.util.module_from_spec(spec)
loader.exec_module(transport)


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--rpc-url', required=True)
    p.add_argument('--guid', type=int, required=True)
    p.add_argument('--session-id', required=True)
    p.add_argument('--kind', default='command')
    p.add_argument('--value', required=True, help='JSON object interpreted by the Lua policy')
    a = p.parse_args()
    value = json.loads(a.value)
    if not isinstance(value, dict):
        p.error('--value must be a JSON object')
    result = transport.RPC(a.rpc_url).call('session.send_event', dict(
        sessionId=a.session_id, characterGuid=str(a.guid), kind=a.kind, value=value))
    print(json.dumps(result))


if __name__ == '__main__':
    main()
