#!/usr/bin/env python3
"""Write the editable flightpath Lua child to stdout; does not attach or run it."""

import argparse
from pathlib import Path
import sys


def compose(behaviors, task_runtime=False):
    parts = []
    modules = [] if task_runtime else [("tasks", "task-stack.lua")]
    modules.append(("planner", "flightpath-plan.lua"))
    for name, filename in modules:
        source = (behaviors / filename).read_text(encoding="utf-8")
        parts.append(f"local {name}=(function()\n{source}\nend)()\n")
    parts.append((behaviors / "flightpath-activation.lua").read_text(encoding="utf-8"))
    return "".join(parts)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task-runtime", action="store_true",
                        help="omit TaskStack for dev/task-runtime, which adds it before --source")
    args = parser.parse_args()
    try:
        source = compose(Path(__file__).resolve().parent.parent / "behaviors", args.task_runtime)
    except (OSError, UnicodeError) as error:
        parser.exit(1, f"{error}\n")
    sys.stdout.write(source)


if __name__ == "__main__":
    main()
