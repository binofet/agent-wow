#!/usr/bin/env python3
"""Send public worldserver console commands over the maintained Quasar SSH transport."""
import os,subprocess,sys,json
commands=sys.argv[1:]
assert commands and all('\n' not in x and '\r' not in x for x in commands)
script='''import socket,subprocess,time,re,json
commands=COMMANDS
ids=subprocess.run(['docker','ps','--filter','label=com.docker.compose.project=warcraft-buddy-realm','--filter','label=com.docker.compose.service=worldserver','--format','{{.ID}}'],capture_output=True,text=True,check=True).stdout.split()
assert len(ids)==1
s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(5);s.connect('/var/run/docker.sock')
s.sendall(('POST /containers/'+ids[0]+'/attach?stream=1&stdin=1&stdout=1&stderr=1 HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: Upgrade\\r\\nUpgrade: tcp\\r\\nContent-Length: 0\\r\\n\\r\\n').encode())
head=b''
while b'\\r\\n\\r\\n' not in head:head+=s.recv(4096)
assert b'101' in head.split(b'\\r\\n',1)[0]
s.sendall(('\\n'.join(commands)+'\\n').encode())
s.settimeout(.5);out=b'';until=time.monotonic()+4
while time.monotonic()<until and len(out)<65536:
 try:out+=s.recv(4096)
 except socket.timeout:pass
s.close()
text=re.sub(r'\\x1b\\[[0-9;?]*[A-Za-z]','',out.decode(errors='replace'))
print(text[:12000])
'''.replace('COMMANDS',repr(commands))
subprocess.run(['ssh','-i',os.path.expanduser('~/.ssh/id_ed5519_quasar'),'-o','IdentitiesOnly=yes','-o','BatchMode=yes','quasar','cd /home/jmax/dev/warcraft_buddy && python3 -'],input=script,text=True,check=True)
