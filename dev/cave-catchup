class EncounterRejected(Error):
    """Actual matching module FailedPrecondition; not a transport timeout."""



def number(value):
    if isinstance(value, str) and re.fullmatch(r'0|[1-9][0-9]{0,19}', value): value = int(value)
    if type(value) is not int or not 0 <= value < 2**64: raise Error('Invalid bounded server integer')
    return value


def session(value):
    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9._-]{1,128}', value):
        raise Error('Actual body session is unknown')
    return value


def point(row, known='positionKnown'):
    return (isinstance(row, dict) and row.get(known) is True and row.get('mapKnown') is True
        and all(type(row.get(k)) in (int, float) and math.isfinite(row[k]) and abs(row[k]) < 40000 for k in ('x', 'y', 'z')))


def distance(a, b): return math.dist(tuple(a[k] for k in ('x', 'y', 'z')), tuple(b[k] for k in ('x', 'y', 'z')))


def ordinary_patrol(row):
    if not point(row) or number(row.get('movementFlags', 0)) & ~0x780001ff: return False
    t = row.get('trajectory')
    if (not isinstance(t, dict) or t.get('known') is not True or t.get('stopped') is True
            or t.get('cyclic') is True or t.get('transportRelative') is True or t.get('destinationKnown') is not True
            or not 1 <= number(t.get('durationMs', 0)) <= 120000): return False
    end = {k: t.get('destination'+k.upper()) for k in ('x', 'y', 'z')}
    def area(p): return all(type(p[k]) in (int, float) and math.isfinite(p[k]) for k in p) and -10000 <= p['x'] <= -9700 and 50 <= p['y'] <= 320 and -10 <= p['z'] <= 65
    return area({k: row[k] for k in end}) and area(end) and distance(row, end) <= 60


def creature_position(row):
    """Actual fresh patrol header or bounded elapsed endpoint, never interpolation."""
    if not point(row) or number(row.get('movementFlags', 0)) & ~0x780001ff: return None
    t = row.get('trajectory') or {}
    if not isinstance(t, dict): return None
    if t.get('known') is True:
        if t.get('transportRelative') is True: return None
        if t.get('stopped') is not True:
            if not ordinary_patrol(row): return None
            age, duration = number(t.get('ageMs', 0)), number(t.get('durationMs', 0))
            if age >= duration:
                if age-duration > 5000: return None
                return dict(row, **{k: t['destination'+k.upper()] for k in ('x', 'y', 'z')})
            if age > 750 or number(row.get('positionAgeMs', 0)) > 750: return None
            return row
        return row
    return None if number(row.get('movementFlags', 0)) & 0x080000ff else row


def neighbor_near(row, target):
    p = creature_position(row)
    if p is not None: return distance(p, target) < 8
    if ordinary_patrol(row):
        t = row['trajectory']; age = number(t.get('ageMs', 0)); duration = number(t['durationMs'])
        end = {k: t['destination'+k.upper()] for k in ('x', 'y', 'z')}
        # Only displacement bounds, not a guessed point on the patrol path.
        return distance(row, target) < 8+7*age/1000 and distance(end, target) < 8+7*abs(duration-age)/1000
    return point(row) and distance(row, target) < 8


def decode(raw):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            if key in result: raise ValueError('duplicate key')
            result[key] = value
        return result
    return json.loads(raw, object_pairs_hook=unique, parse_constant=lambda _: (_ for _ in ()).throw(ValueError('nonfinite JSON')))


def read_private(path):
    try:
        with os.fdopen(c.private_open(path, os.O_RDONLY), 'rb') as source: raw = source.read(MAX_LEDGER + 1)
        if len(raw) > MAX_LEDGER: raise Error('Cave state exceeds its bound')
        value = decode(raw)
        if not isinstance(value, dict): raise ValueError('object required')
        return value
    except FileNotFoundError: return None
    except ValueError: raise Error('Cave state is invalid') from None


def write_private(path, value):
    body = (json.dumps(value, allow_nan=False, separators=(',', ':')) + '\n').encode()
    if len(body) > MAX_LEDGER or path.is_symlink(): raise Error('Cave state exceeds its bound or is unsafe')
    fd, temporary = tempfile.mkstemp(prefix='.cave-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as output:
            os.fchmod(output.fileno(), 0o600); output.write(body); output.flush(); os.fsync(output.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(directory)
        finally: os.close(directory)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)


class RPC(c.RPC):
    READS = frozenset(('buddy-world.snapshot', 'buddy-actions.status', 'buddy-party.state', 'buddy-quests.state', 'buddy-loot.state', 'buddy-trade.state', 'buddy-professions.state'))

    def fork(self, timeout=35): return RPC(self.url, timeout=timeout)

    def call(self, method, params, timeout=None):
        if method not in self.READS | {'buddy-actions.fargodeep_encounter', 'buddy-actions.acquire_interaction',
                'buddy-actions.release_interaction', 'buddy-actions.travel_to'} or not isinstance(params, dict) or self.request_id >= 8192:
            raise Error('Cave RPC method or finite request bound is invalid')
        self.request_id += 1
        identity = self.request_id
        request = urllib.request.Request(self.url, data=json.dumps({'jsonrpc': '2.0', 'id': identity,
            'method': method, 'params': params}, allow_nan=False).encode(), headers={'Content-Type': 'application/json'})
        try:
            with self.opener.open(request, timeout=min(self.timeout, timeout or self.timeout)) as response: raw = response.read(262145)
            value = decode(raw) if len(raw) <= 262144 else None
        except (OSError, ValueError, http.client.HTTPException): raise Error('Cave RPC outcome is unconfirmed') from None
        if (not isinstance(value, dict) or value.get('jsonrpc') != '2.0' or type(value.get('id')) is not int
                or value['id'] != identity or ('error' in value) == ('result' in value)):
            raise Error('Cave RPC outcome is unconfirmed')
        fault = value.get('error')
        if isinstance(fault, dict):
            data = fault.get('data') or {}
            if (method == 'buddy-actions.fargodeep_encounter' and params.get('enabled') is True
                    and fault.get('code') == -32000 and isinstance(data, dict) and data.get('module') == 'buddy-actions'
                    and data.get('method') == 'fargodeep_encounter' and data.get('grpc_status') == 'FailedPrecondition'):
                raise EncounterRejected('Encounter activation was rejected before acceptance')
            raise Error('Cave RPC outcome is unconfirmed')
        if not isinstance(value.get('result'), dict): raise Error('Cave RPC outcome is unconfirmed')
        return value['result']


def own_log(world):
    rows = world.get('selfQuestLog')
    if world.get('selfQuestLogKnown') is not True or not isinstance(rows, list) or len(rows) != 25:
        raise Error('Complete own quest log is required')
    slots, quests = set(), {}
    for row in rows:
        slot, qid = number(row.get('slot', 0)), number(row.get('questId', 0))
        if slot >= 25 or slot in slots or qid and qid in quests: raise Error('Own quest slots are invalid')
        slots.add(slot)
        if qid:
            state = number(row.get('state', 0))
            if row.get('failed') is True or state & 2: raise Error('An own quest has failed')
            quests[qid] = row.get('complete') is True and bool(state & 1)
    if any(qid not in quests for qid in GOALS): raise Error('Both collection quests must be in each own log')
    return quests


def carried_counts(world):
    bags = world.get('inventoryBags')
    if world.get('inventoryKnown') is not True or not isinstance(bags, list) or len(bags) != 5:
        raise Error('All five carried bag observations are required')
    seen, guids, counts, free = set(), set(), {772: 0, 773: 0}, 0
    for bag in bags:
        index = number(bag.get('bag', 0))
        if index > 4 or index in seen or bag.get('slotKnown') is not True: raise Error('Bag references are unknown')
        seen.add(index)
        size, slots = number(bag.get('slotCount', 0)), bag.get('slots', [])
        if index and number(bag.get('containerGuid', 0)) == 0:
            if size or slots: raise Error('Empty bag has invented contents')
            continue
        if bag.get('contentsKnown') is not True or not 1 <= size <= 36 or index == 0 and size != 16 or not isinstance(slots, list) or len(slots) != size:
            raise Error('Carried bag contents are incomplete')
        positions = set()
        for row in slots:
            at, guid = number(row.get('slot', 0)), number(row.get('itemGuid', 0))
            if number(row.get('bag', 0)) != index or at >= size or at in positions: raise Error('Carried slots are invalid')
            positions.add(at)
            if not guid:
                free += 1; continue
            if guid in guids or row.get('metadataKnown') is not True: raise Error('Carried item metadata is unknown')
            guids.add(guid)
            entry, count = number(row.get('entry', 0)), number(row.get('stackCount', 0))
            if not entry or not count or count > 2**32-1: raise Error('Carried item stack is unknown')
            if entry in counts: counts[entry] += count
    return counts, free


class Catchup:
    def __init__(self, rpcs, sessions, save=lambda _: None, stored=None, now=time.monotonic, stopped=lambda: False, max_seconds=600):
        if set(rpcs) != set(ROSTER) or set(sessions) != set(ROSTER) or not 1 <= max_seconds <= 600:
            raise Error('Cave catchup requires the fixed three-body roster and a finite budget')
        if any(hasattr(rpc, 'url') and rpc.url != f'http://127.0.0.1:{ROSTER[g][1]}/rpc' for g, rpc in rpcs.items()):
            raise Error('Cave actor endpoint differs from the fixed roster')
        self.rpcs, self.sessions, self.save, self.now, self.stopped = rpcs, {str(g): session(s) for g, s in sessions.items()}, save, now, stopped
        self.deadline, self.done = now() + max_seconds, False
        self.data = stored or {'identity': copy.deepcopy(IDENTITY), 'sessions': dict(self.sessions), 'encounters': []}
        rows = self.data.get('encounters')
        if self.data.get('identity') != IDENTITY or self.data.get('sessions') != self.sessions or not isinstance(rows, list) or len(rows) > 96:
            raise Error('Cave journal identity, sessions or bounds differ')
        for row in rows:
            if (not isinstance(row, dict) or row.get('phase') not in ('arming', 'active', 'loot', 'settled', 'unconfirmed', 'stopped')
                    or number(row.get('engager', 0)) not in ROSTER or number(row.get('entry', 0)) not in ENTRIES
                    or not isinstance(row.get('requests'), dict) or set(row['requests']) - set(self.sessions)
                    or type(row.get('deadObserved', False)) is not bool): raise Error('Cave encounter journal is invalid')
            target = number(row.get('target', 0))
            if target >> 48 != 0xf130 or target >> 24 & 0xffffff != row['entry'] or not target & 0xffffff: raise Error('Cave target binding is invalid')
            if any(type(row.get(k)) not in (int, float) or not math.isfinite(row[k]) or row[k] < 0 for k in ('started',)):
                raise Error('Cave encounter time is invalid')
            if 'lootAt' in row and (type(row['lootAt']) not in (int, float) or not math.isfinite(row['lootAt']) or row['lootAt'] < 0):
                raise Error('Cave loot time is invalid')
            for request in row['requests'].values():
                if not isinstance(request, dict) or request.get('phase') not in ('reserved', 'sent', 'observed', 'stopped') or not 0 < number(request.get('questRevision', 0)) < 2**64:
                    raise Error('Cave request reservation is invalid')
            approaches = row.get('lootApproaches', [])
            if not isinstance(approaches, list) or len(approaches) > 3: raise Error('Corpse approach history exceeds its bound')
            for leg in approaches:
                if (not isinstance(leg, dict) or leg.get('phase') not in ('reserved', 'arrived', 'preempted', 'yielded')
                        or leg.get('targetGuid') != row['target'] or not isinstance(leg.get('bodySessions'), dict)
                        or set(leg['bodySessions']) != set(self.sessions)
                        or any(not session(v) for v in leg['bodySessions'].values())
                        or type(leg.get('cleanupResolved', False)) is not bool): raise Error('Saved corpse approach is invalid')
            for key in ('lootWaitAt','lootWaitPauseAt'):
                if key in row and (type(row[key]) not in (int,float) or not math.isfinite(row[key]) or row[key]<0):
                    raise Error('Corpse loot clock is invalid')
            history=row.get('lootWaitHistory',[])
            if not isinstance(history,list) or len(history)>3 or any(type(t) not in (int,float) or not math.isfinite(t) or t<0 for t in history):
                raise Error('Corpse loot clock history is invalid')
        self.search_legs, self.idle_polls = 0, 0
        search = self.data.get('search')
        if 'search' in self.data and search is None: raise Error('Saved corridor search is invalid')
        if search is not None:
            if (not isinstance(search, dict) or search.get('route') != SEARCH_ROUTE
                    or type(search.get('cursor')) is not int or not 0 <= search['cursor'] < len(SEARCH_STATIONS)
                    or type(search.get('direction')) is not int or search['direction'] not in (-1, 1)
                    or not isinstance(search.get('legs'), list) or not 1 <= len(search['legs']) <= SEARCH_HISTORY):
                raise Error('Saved corridor search is invalid')
            for leg in search['legs']:
                if (not isinstance(leg, dict) or type(leg.get('station')) is not int or not 0 <= leg['station'] < len(SEARCH_STATIONS)
                        or leg.get('phase') not in ('reserved', 'arrived', 'yielded', 'preempted')
                        or type(leg.get('cleanupResolved', False)) is not bool
                        or leg.get('phase') == 'arrived' and leg.get('cleanupResolved') is not True
                        or type(leg.get('started')) not in (int, float) or not math.isfinite(leg['started']) or leg['started'] < 0):
                    raise Error('Saved corridor leg is invalid')
                if leg['phase'] == 'preempted' and not self.known_preemption(leg):
                    raise Error('Saved corridor preemption lacks positive movement receipts')
        self.status = {'identity': copy.deepcopy(IDENTITY), 'phase': 'starting', 'observationsCurrent': False, 'characters': []}
        controls = self.data.get('controls')
        if controls is not None and (not isinstance(controls, list) or len(controls) != 3 or any(not isinstance(row, list) or len(row) != 4 or any(type(v) is not bool for v in row) for row in controls)):
            raise Error('Saved cave control intent is invalid')

    def persist(self): self.save(copy.deepcopy(self.data))

    def endpoint(self, guid):
        rpc = self.rpcs[guid]
        if hasattr(rpc, 'url') and rpc.url != f'http://127.0.0.1:{ROSTER[guid][1]}/rpc':
            self.done = True; raise Error('Cave actor endpoint changed')
        return rpc

    def read(self, target=0, timeout=None, check=None):
        result, groups = {}, []
        for guid in self.rpcs:
            def call(method, params):
                if check is not None and not check(): raise Error('Corridor read interrupted')
                endpoint = self.endpoint(guid)
                return endpoint.call(method, params, timeout=timeout) if timeout is not None else endpoint.call(method, params)
            first = call('buddy-party.state', {})
            world = call('buddy-world.snapshot', {'creatureGuid': str(target)} if target else {})
            actions = call('buddy-actions.status', {})
            loot = call('buddy-loot.state', {})
            quests = call('buddy-quests.state', {})
            trade = call('buddy-trade.state', {})
            professions = call('buddy-professions.state', {})
            final = call('buddy-party.state', {})
            expected = self.sessions[str(guid)]
            if any(session(value.get('sessionId')) != expected for value in (first, final, loot, quests, trade, professions)):
                self.done = True; raise Error('A cave actor body session changed')
            own, pos = world.get('self', {}), actions.get('position', {})
            if number(own.get('guid', 0)) != guid: self.done = True; raise Error('Cave actor identity changed')
            group = final.get('group', {})
            members = group.get('members', [])
            if group.get('known') is not True or group.get('inGroup') is not True or not isinstance(members, list) or not 3 <= len(members) <= 40:
                raise Error('Actual current party membership is required')
            online = [number(m.get('guid', 0)) for m in members if m.get('online') is True]
            if len(online) != len(set(online)) or not set(ROSTER) <= set(online): raise Error('All three companions must be online in the same party')
            groups.append(number(group.get('groupGuid', 0)))
            if not groups[-1] or number(first.get('group', {}).get('groupGuid', 0)) != groups[-1]: raise Error('Party changed while reading')
            log, (counts, free) = own_log(world), carried_counts(world)
            if not point(pos, 'known') or number(pos.get('mapId', 0)) != 0 or not point(own) or number(own.get('mapId', 0)) != 0:
                raise Error('Actual same-map own position is required')
            result[guid] = {'world': world, 'actions': actions, 'loot': loot, 'self': own, 'position': pos, 'log': log,
                'counts': counts, 'free': free, 'questRevision': number(world.get('selfQuestLogRevision', 0)), 'quests': quests, 'trade': trade, 'professions': professions}
        if len(set(groups)) != 1: raise Error('Companions are not in one server-confirmed party')
        self.status.update(observationsCurrent=True, characters=[{'guid': g, 'sessionId': self.sessions[str(g)],
            'goldDust': result[g]['counts'][773], 'largeCandles': result[g]['counts'][772],
            'quest47Complete': result[g]['log'][47], 'quest60Complete': result[g]['log'][60],
            'quest62Complete': result[g]['log'].get(62, False), 'freeSlots': result[g]['free'],
            'encounterPhase': self.phase(result[g]['actions'].get('fargodeep', {}).get('phase')),
            'assistReason': self.phase(result[g]['actions'].get('assistReason')),
            'navReason': self.phase(result[g]['actions'].get('navReason'))} for g in ROSTER])
        return result

    @staticmethod
    def phase(value):
        return value if isinstance(value, str) and re.fullmatch(r'[A-Za-z0-9_.:-]{0,128}', value) else ''

    @staticmethod
    def combat(scene): return bool(number(scene['self'].get('unitFlags', 0)) & 0x80000)

    @staticmethod
    def controls(scenes):
        return [[scenes[g]['actions'].get(k) is True for k in ('following', 'healing', 'assisting')]
            + [scenes[g]['loot'].get('enabled') is True] for g in ROSTER]

    @staticmethod
    def scope(actions, row):
        f = actions.get('fargodeep', {})
        return isinstance(f, dict) and number(f.get('targetGuid', 0)) == row['target'] and number(f.get('engagerGuid', 0)) == row['engager']

    def safe_pull(self, scenes, owned=None):
        for guid, scene in scenes.items():
            p, a, loot = scene['self'], scene['actions'], scene['loot']
            if (any(p.get(k) is not True for k in ('present', 'aliveKnown', 'alive', 'healthKnown', 'unitFlagsKnown', 'classKnown', 'powerKnown'))
                    or number(p.get('classId', 0)) != ROSTER[guid][2] or self.combat(scene)
                    or not number(p.get('maxHealth', 0)) or number(p.get('health', 0))*100 < number(p['maxHealth'])*95
                    or number(p.get('health', 0)) > number(p['maxHealth'])
                    or not scene['free'] or not scene['questRevision'] or a.get('assisting') is not True): return False
            if number(p.get('powerType', 0)) != (3 if guid == 5 else 0): return False
            if guid != 5 and (not number(p.get('maxPower', 0)) or number(p.get('power', 0))*100 < number(p['maxPower'])*60): return False
            if guid == 5 and number(p.get('power', 0)) < 90: return False
            if (any(a.get(k) is True for k in ('following', 'practicing', 'moving', 'traveling', 'motionUnconfirmed', 'autoAttackUnconfirmed', 'castPending'))
                    or a.get('interactionOwner') or loot.get('enabled') is not True or loot.get('phase') != 'idle'
                    or number(loot.get('pendingCorpseGuid', 0)) or number(loot.get('pendingGameObjectGuid', 0))): return False
            if a.get('fargodeep', {}).get('active') is True and (owned is None or not self.scope(a, owned)): return False
            prof, operation = scene['professions'], scene['professions'].get('operation') or {}
            if (scene['quests'].get('actionInFlight') is True or not c.trade_idle(scene['trade']) or prof.get('active') is True
                    or prof.get('closing') is True or operation.get('cleanupUnconfirmed') is True
                    or operation and (operation.get('status') not in ('COMPLETED', 'SERVER_REJECTED', 'BLOCKED', 'CANCELLED') or operation.get('leaseReleased') is not True)):
                return False
        return scenes[1]['actions'].get('healing') is True

    def search_read(self, cleanup=False, target=0):
        return self.read(target, timeout=.5, check=None if cleanup else lambda: not self.stopped() and self.now() < self.deadline)

    def safe_search(self, scenes, tokens=None):
        """Reuse pull safety, allowing only our own harvest-tagged movement."""
        tokens = tokens or {}
        if self.controls(scenes) != self.data.get('controls'): return False
        adjusted = {}
        for guid, scene in scenes.items():
            own, a = scene['self'], scene['actions']
            if ((scene['world'].get('owner') or {}).get('present') is True
                    or own.get('movementFlagsKnown') is not True
                    or number(own.get('unitFlags', 0)) & (0x1|0x4|0x40000|0x100000|0x400000|0x800000|0x1000000|0x2000000|0x8000000)
                    or number(own.get('movementFlags', 0)) & ~0x700001ff or number(own.get('extraMovementFlags', 0))
                    or a.get('autoAttacking') is True or a.get('autoAttackRequested') is True
                    or a.get('fargodeep', {}).get('active') is True): return False
            for creature in scene['world'].get('nearbyCreatures', []):
                if (creature.get('present') is True and creature.get('alive') is True
                        and creature.get('attackVictimKnown') is True
                        and number(creature.get('attackVictimGuid', 0)) in (1, 3, 4, 5)
                        and number(creature.get('attackAgeMs', 0)) <= 5000): return False
            adjusted[guid] = dict(scene, actions=dict(a))
            if guid in tokens:
                if (a.get('interactionOwner') != 'exploration' or a.get('interactionHarvest') is not True
                        or not number(a.get('interactionLeaseRemainingMs', 0))): return False
                # The unchanged pull guard still checks casts, uncertain motion,
                # other modules, resources, logs and complete carried inventory.
                adjusted[guid]['actions'].update(interactionOwner='', moving=False, traveling=False)
        return self.safe_pull(adjusted)

    def release_search(self, guid, token):
        result = {'guid': guid, 'releaseAck': False, 'custodyResolved': False}
        try:
            if session(self.endpoint(guid).call('buddy-party.state', {}, timeout=.5).get('sessionId')) != self.sessions[str(guid)]: return result
            try:
                a = self.endpoint(guid).call('buddy-actions.release_interaction', {'owner': 'exploration', 'token': token}, timeout=.5)
                result['releaseAck'] = True
            except Error:
                # Danger can already have revoked this harvest token. Fresh
                # stopped absence is distinct proof, never a fabricated ACK.
                if session(self.endpoint(guid).call('buddy-party.state', {}, timeout=.5).get('sessionId')) != self.sessions[str(guid)]: return result
                a = self.endpoint(guid).call('buddy-actions.status', {}, timeout=.5)
            if session(self.endpoint(guid).call('buddy-party.state', {}, timeout=.5).get('sessionId')) != self.sessions[str(guid)]: return result
            result['custodyResolved'] = not a.get('interactionOwner') and not any(a.get(k) is True for k in ('moving', 'traveling', 'motionUnconfirmed'))
        except Error: pass
        return result

    @staticmethod
    def search_priority(scenes):
        for guid, scene in scenes.items():
            if scene['self'].get('unitFlagsKnown') is True and Catchup.combat(scene):
                return {'kind': 'actual_own_combat', 'observerGuid': guid}
            for creature in scene['world'].get('nearbyCreatures', []):
                if (creature.get('present') is True and creature.get('aliveKnown') is True and creature.get('alive') is True
                        and creature.get('attackVictimKnown') is True and number(creature.get('attackVictimGuid', 0)) in (1, 4, 5)
                        and number(creature.get('attackAgeMs', 0)) <= 5000):
                    return {'kind': 'actual_fresh_party_attacker', 'observerGuid': guid}
        return None

    def known_preemption(self, leg):
        """Positive movement receipts, distinct from a later idle snapshot."""
        evidence, replies = leg.get('priorityObservation') or {}, leg.get('routeResults') or {}
        cleanup = leg.get('cleanup')
        return (isinstance(cleanup, list) and len(cleanup) == 3
            and {number(v.get('guid', 0)) for v in cleanup} == set(ROSTER)
            and all(v.get('custodyResolved') is True for v in cleanup)
            and leg.get('cleanupResolved') is True and leg.get('bodySessions') == self.sessions
            and isinstance(evidence, dict) and evidence.get('kind') in ('actual_own_combat', 'actual_fresh_party_attacker', 'normal_server_priority')
            and number(evidence.get('observerGuid', 0)) in ROSTER
            and isinstance(replies, dict) and set(replies) == set(self.sessions)
            and (evidence['kind'] != 'normal_server_priority' or replies.get(str(evidence['observerGuid']), {}).get('reason') in SEARCH_PRIORITY_REASONS)
            and all(isinstance(r, dict) and r.get('normalStopped') is True and point(r.get('position'), 'known')
                and number(r['position'].get('mapId', 0)) == 0 for r in replies.values()))

    @staticmethod
    def stopped_route_result(answer):
        pos = answer.get('position') or {}
        return {'normalStopped': point(pos, 'known') and number(pos.get('mapId', 0)) == 0
                and answer.get('interactionOwner', '') in ('', 'exploration') and not any(answer.get(k) is True for k in ('moving', 'traveling', 'motionUnconfirmed', 'autoAttackUnconfirmed')),
            'reason': Catchup.phase(answer.get('reason')), 'position': dict(pos)}

    def stopped_arrival_evidence(self, leg, goal=None):
        """All-three recorded arrival/progress and resolved custody, not RPC success."""
        clean, before, after = leg.get('cleanup'), leg.get('before'), leg.get('after')
        if (leg.get('phase') != 'yielded' or leg.get('cleanupResolved') is not True
                or leg.get('bodySessions', self.data['sessions']) != self.sessions
                or not isinstance(clean, list) or len(clean) != 3
                or {number(v.get('guid', 0)) for v in clean} != set(ROSTER)
                or not all(v.get('custodyResolved') is True for v in clean)
                or not isinstance(before, dict) or set(before) != set(self.sessions)
                or not isinstance(after, dict) or set(after) != set(self.sessions)): return False
        goal = station(leg['station']) if goal is None else goal
        return all(point(before[g], 'known') and point(after[g], 'known')
            and number(before[g].get('mapId', 0)) == 0 and number(after[g].get('mapId', 0)) == 0
            and number(after[g].get('revision', 0)) > number(before[g].get('revision', 0))
            and distance(after[g], goal) <= SEARCH_ARRIVAL+1e-4 for g in self.sessions)

    def observe_stopped_arrival(self, scenes):
        saved = self.data['search']; leg = saved['legs'][-1]
        if not self.stopped_arrival_evidence(leg) or not self.safe_search(scenes): return False
        goal = station(leg['station'])
        if not all(distance(scene['position'], goal) <= SEARCH_ARRIVAL+1e-4
                and number(scene['position'].get('revision', 0)) >= number(leg['after'][str(g)].get('revision', 0)) for g, scene in scenes.items()): return False
        direction = saved['direction'] if saved['cursor'] == leg['station'] else (1 if leg['station'] > saved['cursor'] else -1)
        saved.update(cursor=leg['station'], direction=direction)
        leg.update(phase='arrived', arrivalObservation={'kind': 'actual_station_after_resolved_stop',
            'sessions': dict(self.sessions), 'observedAt': self.now(),
            'positions': {str(g): dict(scene['position']) for g, scene in scenes.items()},
            'oldRpcSuccessClaimed': False})
        self.persist(); self.idle_polls = 0
        self.status.update(phase='corridor_station_observed_after_stop', searchStation=leg['station'])
        return True

    def move_cohort(self, leg, goal, observe, guard, arrival_guard=None):
        """Shared normal NAV transport; caller owns the durable leg reservation."""
        tokens, pool, futures, results, releases = {}, None, {}, {}, []
        cause = 'corridor_guard_changed'
        try:
            for guid in ROSTER:
                fresh = observe()
                if not guard(fresh, tokens): raise Error('Corridor custody or party safety changed')
                lease = self.endpoint(guid).call('buddy-actions.acquire_interaction', {'owner': 'exploration', 'leaseMs': 30000, 'harvest': True}, timeout=.5)
                token, a = lease.get('token'), lease.get('state') or {}
                if not isinstance(token, str) or not 1 <= len(token) <= 128: raise Error('Corridor lease outcome is unconfirmed')
                tokens[guid] = token
                if (a.get('interactionOwner') != 'exploration' or a.get('interactionHarvest') is not True
                        or not number(a.get('interactionLeaseRemainingMs', 0))) or any(a.get(k) is True for k in ('moving', 'traveling', 'motionUnconfirmed')):
                    raise Error('Stopped guarded corridor custody was not confirmed')
            if not guard(observe(), tokens): raise Error('Corridor safety changed before movement')
            # Each blocking route uses a distinct connection/request sequence;
            # watchdog reads never share its RPC instance or request counter.
            routes = {g: self.endpoint(g).fork(timeout=35) for g in ROSTER}
            def travel(guid):
                if self.stopped() or self.now() >= self.deadline: raise Error('Corridor start interrupted')
                return routes[guid].call('buddy-actions.travel_to',
                    dict(token=tokens[guid], mapId=0, arrivalDistance=SEARCH_ARRIVAL, **goal), timeout=35)
            pool = concurrent.futures.ThreadPoolExecutor(max_workers=3)
            futures = {g: pool.submit(travel, g) for g in ROSTER}
            while True:
                fresh = observe()
                priority = self.search_priority(fresh)
                if priority is not None: leg['priorityObservation'] = priority
                for guid, future in futures.items():
                    if future.done() and guid not in results:
                        answer = future.result()
                        results[guid] = answer
                        if (answer.get('reason') != 'exploration_within_distance' or any(answer.get(k) is True for k in ('moving', 'traveling', 'motionUnconfirmed'))):
                            cause = 'corridor_route_not_confirmed'; raise Error('Corridor route did not confirm arrival')
                if not guard(fresh, tokens): raise Error('Corridor safety changed during movement')
                if len(results) == 3: break
                time.sleep(.2)
        except (Error, OSError): pass
        finally:
            # Revoke every exact owned token before waiting for route RPCs.
            releases = [self.release_search(g, token) for g, token in tokens.items()]
            if pool: pool.shutdown(wait=True)
            # Normal completion of the synchronous RPC proves that its movement
            # controller returned. A lost/error response never gains this proof
            # from release or a later idle snapshot, even if position advanced.
            summaries = {}
            for guid, future in futures.items():
                try:
                    answer = future.result()
                    summaries[str(guid)] = self.stopped_route_result(answer)
                    if answer.get('reason') in SEARCH_PRIORITY_REASONS:
                        leg['priorityObservation'] = {'kind': 'normal_server_priority', 'observerGuid': guid}
                except (Error, OSError): summaries[str(guid)] = {'normalStopped': False, 'responseUnconfirmed': True}
            leg['routeResults'] = summaries
            leg['cleanup'] = releases
            leg['cleanupResolved'] = len(tokens) == 3 and all(v['custodyResolved'] for v in releases)
        after = None
        try:
            after = observe(cleanup=True)
            leg['after'] = {str(g): dict(v['position']) for g, v in after.items()}
            arrival = all(distance(v['position'], goal) <= SEARCH_ARRIVAL+1e-4 for v in after.values())
            progress = all(distance(leg['before'][str(g)], goal) <= SEARCH_ARRIVAL+1e-4 or
                (number(v['position'].get('revision', 0)) > number(leg['before'][str(g)].get('revision', 0))
                    and distance(leg['before'][str(g)], goal)-distance(v['position'], goal) >= .5) for g, v in after.items())
            if (len(results) == 3 and all(v.get('reason') == 'exploration_within_distance' for v in results.values())
                    and leg['cleanupResolved'] and not self.stopped() and self.now() < self.deadline
                    and (arrival_guard or guard)(after) and arrival and progress): return 'arrived', after, ''
            if not arrival or not progress: cause = 'corridor_arrival_or_progress_unconfirmed'
        except Error: cause = 'corridor_after_observation_unavailable'
        if self.known_preemption(leg) and not self.stopped() and self.now() < self.deadline:
            return 'preempted', after, 'known_stopped_priority_preemption'
        return 'yielded', after, cause

    def recent_corpse_arrival(self):
        if not self.data['encounters']: return None
        row=self.data['encounters'][-1]; legs=row.get('lootApproaches',[])
        if row['phase'] not in ('settled','stopped') or not legs: return None
        leg=legs[-1]; clean=leg.get('cleanup') or []
        if (leg['phase']=='arrived' and leg.get('bodySessions')==self.sessions and leg.get('cleanupResolved') is True
                and len(clean)==3 and {number(v.get('guid',0)) for v in clean}==set(ROSTER)
                and all(v.get('custodyResolved') is True for v in clean)): return row['target']
        return None

    @staticmethod
    def reconnect_station(scenes):
        candidates=[i for i in range(len(SEARCH_STATIONS)) if all(distance(v['position'],station(i))<=60 for v in scenes.values())]
        if not candidates: return None
        same_floor=[i for i in candidates if all(abs(v['position']['z']-station(i)['z'])<=2 for v in scenes.values())]
        return min(same_floor or candidates,key=lambda i:(max(distance(v['position'],station(i)) for v in scenes.values()),i))

    def search(self, scenes):
        """One journaled, physically planned cohort leg; no same-goal retries."""
        saved = self.data.get('search')
        if self.search_legs >= SEARCH_LEGS or saved and len(saved['legs']) >= SEARCH_HISTORY:
            self.done = True; self.status['phase'] = 'finite_corridor_search_limit'; return
        if self.deadline-self.now() < 36:
            self.done = True; self.status['phase'] = 'finite_corridor_search_time_remaining'; return
        if saved and saved['legs'][-1]['phase'] not in ('arrived', 'preempted'):
            # An interrupted process cannot reissue a reserved movement leg.
            self.done = True; self.status['phase'] = 'corridor_previous_leg_requires_reconciliation'; return
        if not self.safe_search(scenes):
            self.status['phase'] = 'waiting_for_safe_idle_corridor_search'; return
        reanchor=None; reconnect=None; corpse_arrival=self.recent_corpse_arrival()
        if saved is None:
            anchors = [i for i in range(len(SEARCH_STATIONS)) if all(
                abs(s['position']['z']-station(i)['z']) <= 2 and distance(s['position'], station(i)) <= 18 for s in scenes.values())]
            if not anchors:
                reconnect=self.reconnect_station(scenes) if corpse_arrival else None
                if reconnect is None:
                    self.done = True; self.status['phase'] = 'corridor_not_near_current_party_floor'; return
                cursor=reconnect
                reanchor={'kind':'fresh_safe_origin_reconnect','priorCursor':None,'corpseTargetGuid':corpse_arrival}
            else: cursor = min(anchors, key=lambda i: (max(distance(s['position'], station(i)) for s in scenes.values()), i))
            saved = {'route': SEARCH_ROUTE, 'cursor': cursor, 'direction': 1, 'legs': []}
            self.data['search'] = saved
        else:
            cursor = saved['cursor']
            if saved['legs'][-1]['phase'] == 'preempted':
                previous = saved['legs'][-1]
                if not self.known_preemption(previous): raise Error('Corridor preemption is unconfirmed')
                previous['freshResumeObservation'] = {'sessions': dict(self.sessions), 'observedAt': self.now()}
                if all(distance(v['position'], station(previous['station'])) <= SEARCH_ARRIVAL+1e-4 for v in scenes.values()):
                    cursor = previous['station']; saved['cursor'] = cursor
            elif any(abs(s['position']['z']-station(cursor)['z']) > 2 or distance(s['position'], station(cursor)) > 28 for s in scenes.values()):
                reconnect=self.reconnect_station(scenes)
                if reconnect is None:
                    self.done = True; self.status['phase'] = 'corridor_party_left_current_station_floor'; return
                reanchor={'kind':'fresh_safe_origin_reconnect','priorCursor':cursor,'corpseTargetGuid':corpse_arrival or 0}
        direction = saved['direction']
        # First regroup at the floor-matched station if the cohort is spread;
        # otherwise advance in ordered 14.2--15.7yd corridor intervals.
        if all(distance(s['position'], station(cursor)) <= SEARCH_ARRIVAL+1e-4 for s in scenes.values()):
            if not 0 <= cursor+direction < len(SEARCH_STATIONS): direction = -direction
            goal_index = cursor+direction
        else: goal_index = cursor
        if saved['legs'] and saved['legs'][-1]['phase'] == 'preempted':
            previous_goal = saved['legs'][-1]['station']
            if not all(distance(v['position'], station(previous_goal)) <= SEARCH_ARRIVAL+1e-4 for v in scenes.values()):
                goal_index = previous_goal
            if corpse_arrival and any(distance(v['position'],station(cursor))>28 or abs(v['position']['z']-station(cursor)['z'])>2 for v in scenes.values()):
                reconnect=self.reconnect_station(scenes)
                if reconnect is not None: reanchor={'kind':'fresh_safe_origin_reconnect','priorCursor':cursor,'corpseTargetGuid':corpse_arrival}
            if reconnect is None and any(distance(v['position'], station(goal_index)) > 40 for v in scenes.values()):
                self.done = True; self.status['phase'] = 'corridor_preempted_party_left_bounded_goal'; return
        if reconnect is not None:
            goal_index=reconnect
            direction=saved['direction'] if cursor==goal_index else (1 if goal_index>cursor else -1)
        goal = station(goal_index)
        leg = {'station': goal_index, 'phase': 'reserved', 'cleanupResolved': False, 'started': self.now(),
            'bodySessions': dict(self.sessions), 'before': {str(g): dict(s['position']) for g, s in scenes.items()}}
        if reanchor is not None:
            leg['reanchor']=dict(reanchor, sessions=dict(self.sessions), observedAt=self.now())
        saved['legs'].append(leg); self.search_legs += 1; self.persist()
        outcome, after, cause = self.move_cohort(leg, goal, self.search_read, self.safe_search)
        if outcome == 'arrived':
            saved.update(cursor=goal_index, direction=direction)
            leg['phase'] = 'arrived'; self.persist(); self.idle_polls = 0
            self.status.update(phase='corridor_station_arrived_reobserve', searchStation=goal_index, searchLegs=self.search_legs)
            return
        if outcome == 'preempted':
            leg.update(phase='preempted', outcome=cause)
            self.persist(); self.idle_polls = 0
            self.status.update(phase='waiting_for_safe_party_after_known_corridor_preemption', searchLegs=self.search_legs)
            return
        leg.update(phase='yielded', outcome=cause); self.persist()
        if after is not None and not self.stopped() and self.now() < self.deadline:
            try:
                if self.observe_stopped_arrival(after): return
            except Error: pass
        self.done = True; self.status.update(phase='corridor_search_yielded_no_retry', searchLegs=self.search_legs)

    def corpse_views(self, scenes, row, expected=None):
        """Exact currently observed dead target; no history or patrol projection."""
        views, missing = {}, False
        for guid, scene in scenes.items():
            value = scene['world'].get('requestedCreature')
            if value is None:
                missing = True; continue
            if isinstance(value,dict): value=dict(value,**{k:value.get(k,0) for k in ('x','y','z')})
            if (not isinstance(value, dict) or number(value.get('guid', 0)) != row['target']
                    or number(value.get('entry', 0)) != row['entry'] or row['entry'] not in ENTRIES
                    or value.get('present') is not True or value.get('aliveKnown') is not True or value.get('alive',False) is not False
                    or value.get('healthKnown') is not True or number(value.get('health', 0)) != 0
                    or value.get('levelKnown') is not True or not 5 <= number(value.get('level', 0)) <= 7
                    or value.get('unitFlagsKnown') is not True or value.get('dynamicFlagsKnown') is not True
                    or not number(value.get('dynamicFlags', 0)) & 8 or not point(value) or number(value.get('mapId', 0)) != 0
                    or not number(value.get('positionRevision', 0))
                    or not (-10000 <= value['x'] <= -9700 and 50 <= value['y'] <= 320 and -10 <= value['z'] <= 65)):
                raise Error('Exact dead corpse context changed')
            views[str(guid)] = {k: value[k] for k in ('x','y','z')}
            views[str(guid)].update(positionRevision=number(value['positionRevision']))
            if expected is not None and views[str(guid)] != expected[str(guid)]:
                raise Error('Bound corpse position or revision changed')
        if views and any(distance(v, next(iter(views.values()))) > .05 for v in views.values()):
            raise Error('Companion corpse positions disagree')
        return None if missing else views

    def corpse_context(self, scenes, row):
        if (row['phase'] != 'loot' or row.get('deadObserved') is not True
                or set(row['requests']) != set(self.sessions) or any(r.get('phase') != 'stopped' for r in row['requests'].values())
                or any(s['actions'].get('fargodeep', {}).get('active') is True
                    or number(s['actions'].get('fargodeep', {}).get('targetGuid', 0)) not in (0,row['target'])
                    or number(s['actions'].get('fargodeep', {}).get('targetGuid', 0)) and not self.scope(s['actions'], row) for s in scenes.values())):
            return False
        return True

    def corpse_guard(self, scenes, row, expected, tokens=None):
        return self.corpse_context(scenes,row) and self.safe_search(scenes,tokens) and self.corpse_views(scenes,row)==expected

    def corpse_loot_idle(self, scenes, row):
        """Expected same-source normal loot may begin immediately after release."""
        if not self.corpse_context(scenes,row): return False
        adjusted = {}
        for guid, scene in scenes.items():
            a, loot = scene['actions'], scene['loot']; pending = number(loot.get('pendingCorpseGuid', 0))
            if (pending not in (0,row['target']) or number(loot.get('pendingGameObjectGuid', 0))
                    or 'unconfirmed' in str(loot.get('phase', '')).lower()): return False
            adjusted[guid] = dict(scene, actions=dict(a), loot=dict(loot), free=max(1,scene['free']))
            if pending == row['target']:
                if a.get('interactionOwner', '') not in ('','loot'): return False
                adjusted[guid]['actions'].update(interactionOwner='', moving=False, traveling=False)
                adjusted[guid]['loot'].update(phase='idle', pendingCorpseGuid='0')
                # A confirmed normal pickup may just have filled the last slot;
                # it changes future readiness, not an already observed arrival.
                adjusted[guid]['free'] = max(1, scene['free'])
        return self.safe_search(adjusted)

    def corpse_arrival_guard(self, scenes, row, expected):
        views = self.corpse_views(scenes, row, expected)
        # Missing after cleanup is not authority for another route. It cannot
        # erase positive movement arrival merely because normal loot removed
        # the object before the final snapshot.
        return (views is None or views == expected) and self.corpse_loot_idle(scenes, row)

    def corpse_arrival_observed(self, leg, goal, scenes, row, views):
        return (self.stopped_arrival_evidence(leg, goal) and self.corpse_arrival_guard(scenes,row,views)
            and all(distance(v['position'], goal) <= SEARCH_ARRIVAL+1e-4
                and number(v['position'].get('revision',0)) >= number(leg['after'][str(g)].get('revision',0)) for g,v in scenes.items()))

    def prepare_corpse_loot(self, scenes, row):
        """Return true while movement/recovery owns this tick; never opens loot."""
        legs = row.get('lootApproaches', [])
        if legs and legs[-1]['phase'] == 'reserved':
            self.done = True; self.status['phase'] = 'reserved_corpse_approach_no_replay'; return True
        try: views = self.corpse_views(scenes, row)
        except Error:
            self.done = True; self.status['phase'] = 'bound_corpse_context_changed_no_retry'; return True
        if views is None:
            # Absence is never movement authority. Keep prior unknown movement
            # quarantined, and leave ordinary missing-corpse settlement alone.
            if legs and legs[-1]['phase'] in ('yielded','preempted'):
                self.done = True; self.status['phase'] = 'corpse_approach_target_absent_no_replay'; return True
            if any(s['loot'].get('phase') != 'idle' or number(s['loot'].get('pendingCorpseGuid',0)) or
                    any(number(v.get('guid',0)) == row['target'] for v in s['world'].get('lootableCorpses',[])) for s in scenes.values()):
                self.status['phase']='waiting_for_current_corpse_before_cohort_approach'; return True
            return False
        goal = {k: views['1'][k] for k in ('x','y','z')}
        guard = lambda fresh, tokens=None: self.corpse_guard(fresh, row, views, tokens)
        near = all(distance(s['position'], goal) <= 12 and abs(s['position']['z']-goal['z']) <= 1.5 for s in scenes.values())
        if legs and legs[-1]['phase'] == 'yielded':
            previous = legs[-1]
            if not self.corpse_arrival_observed(previous,goal,scenes,row,views):
                self.done = True; self.status['phase'] = 'corpse_approach_unconfirmed_no_replay'; return True
            previous.update(phase='arrived', arrivalObservation={'kind':'actual_bound_corpse_after_resolved_stop',
                'sessions':dict(self.sessions), 'observedAt':self.now(), 'oldRpcSuccessClaimed':False})
            self.persist()
        if legs and legs[-1]['phase'] == 'preempted' and not self.known_preemption(legs[-1]):
            self.done = True; self.status['phase'] = 'corpse_approach_unconfirmed_no_replay'; return True
        if near:
            if not self.corpse_loot_idle(scenes,row):
                if 'lootWaitAt' in row: row.setdefault('lootWaitPauseAt', self.now()); self.persist()
                self.status['phase']='waiting_for_safe_party_before_corpse_loot_clock'; return True
            if 'lootWaitPauseAt' in row:
                row['lootWaitAt'] += max(0,self.now()-row.pop('lootWaitPauseAt')); self.persist()
            return False
        if not any(number(s['world']['requestedCreature'].get('dynamicFlags', 0)) & 1 for s in scenes.values()): return False
        if not guard(scenes):
            self.status['phase'] = 'waiting_for_safe_idle_party_before_corpse_approach'; return True
        if len(legs) >= 3 or self.deadline-self.now() < 36 or any(distance(v['position'], goal) > 60 for v in scenes.values()):
            self.done = True; self.status['phase'] = 'finite_bound_corpse_approach_limit'; return True
        if 'lootWaitAt' in row:
            row.setdefault('lootWaitHistory', []).append(row.pop('lootWaitAt')); row.pop('lootWaitPauseAt',None)
        leg = {'targetGuid':row['target'], 'phase':'reserved', 'cleanupResolved':False, 'started':self.now(),
            'bodySessions':dict(self.sessions), 'targetViews':copy.deepcopy(views), 'goal':goal,
            'before':{str(g):dict(v['position']) for g,v in scenes.items()}}
        row.setdefault('lootApproaches', []).append(leg); self.persist()
        observe = lambda cleanup=False: self.search_read(cleanup=cleanup, target=row['target'])
        outcome, after, cause = self.move_cohort(leg, goal, observe, guard, lambda fresh:self.corpse_arrival_guard(fresh,row,views))
        leg.update(phase=outcome, outcome=cause); self.persist()
        if outcome == 'yielded':
            if after is not None and self.corpse_arrival_observed(leg,goal,after,row,views):
                leg.update(phase='arrived', arrivalObservation={'kind':'actual_bound_corpse_after_resolved_stop',
                    'sessions':dict(self.sessions), 'observedAt':self.now(), 'oldRpcSuccessClaimed':False}); self.persist()
            else:
                self.done = True; self.status['phase'] = 'corpse_approach_unconfirmed_no_replay'; return True
        self.status['phase'] = 'bound_corpse_cohort_arrived_reobserve' if leg['phase'] == 'arrived' else 'waiting_for_safe_party_after_known_corpse_preemption'
        return True

    def candidate(self, scenes):
        attempted = {row['target'] for row in self.data['encounters']}
        candidates, all_observed = {}, {}
        for scene in scenes.values():
            rows = scene['world'].get('nearbyCreatures', [])
            if not isinstance(rows, list) or len(rows) > 32: raise Error('Cave creature observation bound exceeded')
            for row in rows:
                guid, entry = number(row.get('guid', 0)), number(row.get('entry', 0))
                all_observed[guid] = row
                current = creature_position(row)
                if (guid in attempted or guid >> 48 != 0xf130 or not guid & 0xffffff or guid >> 24 & 0xffffff != entry or entry not in ENTRIES
                        or row.get('present') is not True or row.get('aliveKnown') is not True or row.get('alive') is not True
                        or row.get('healthKnown') is not True or not number(row.get('health', 0))
                        or number(row.get('health', 0)) != number(row.get('maxHealth', 0)) or row.get('levelKnown') is not True
                        or not 5 <= number(row.get('level', 0)) <= 7 or current is None or number(row.get('mapId', 0)) != 0
                        or any(s['self'].get('levelKnown') is not True or number(row['level']) > number(s['self'].get('level', 0))+1 for s in scenes.values())
                        or row.get('unitFlagsKnown') is not True or row.get('dynamicFlagsKnown') is not True
                        or number(row.get('unitFlags', 0)) & (0x80000|0x2|0x80|0x100|0x10000|0x2000000|0x80000000)
                        or number(row.get('unitFlags2', 0)) & 1 or number(row.get('dynamicFlags', 0)) or number(row.get('npcFlags', 0))
                        or row.get('targetKnown') is not True or number(row.get('targetGuid', 0))
                        or row.get('attackVictimKnown') is True and number(row.get('attackVictimGuid', 0))
                        or any(distance(current, other['position']) > 28 for other in scenes.values())): continue
                candidates[guid] = current
        candidates = {guid: row for guid, row in candidates.items() if not any(
            other_guid != guid and other.get('present') is True and other.get('aliveKnown') is True and other.get('alive') is True
            and not number(other.get('npcFlags', 0)) and other.get('mapKnown') is True and number(other.get('mapId', 0)) == 0 and neighbor_near(other, row)
            for other_guid, other in all_observed.items())}
        return min(candidates.values(), key=lambda row: (max(distance(row, s['position']) for s in scenes.values()), number(row['guid']))) if candidates else None

    def cleanup(self, row):
        clean = True
        for guid, rpc in self.rpcs.items():
            if str(guid) not in row['requests']: continue
            try:
                p = rpc.call('buddy-party.state', {})
                if session(p.get('sessionId')) != self.sessions[str(guid)]: clean = False; continue
                a = rpc.call('buddy-actions.status', {})
                if a.get('fargodeep', {}).get('active') is True:
                    if not self.scope(a, row): clean = False; continue
                    # Disable is bound to this exact body/target/engager too.
                    a = rpc.call('buddy-actions.fargodeep_encounter', {'enabled': False, 'sessionId': self.sessions[str(guid)],
                        'targetGuid': str(row['target']), 'engagerGuid': str(row['engager'])})
                if a.get('fargodeep', {}).get('active') is True or any(a.get(k) is True for k in ('moving', 'motionUnconfirmed', 'autoAttackUnconfirmed', 'autoAttacking', 'autoAttackRequested', 'castPending')):
                    clean = False
                else: row['requests'][str(guid)]['phase'] = 'stopped'
            except Error: clean = False
        self.persist()
        return clean

    def abandon_terminal(self, row, cause):
        """Retire this GUID only after exact cleanup and fresh positive idle proof."""
        if not self.cleanup(row): return False
        scenes = self.read(row['target'])
        if self.stopped() or self.now() >= self.deadline or self.controls(scenes) != self.data.get('controls'): return False
        for scene in scenes.values():
            p, a, loot = scene['self'], scene['actions'], scene['loot']
            operation = scene['professions'].get('operation') or {}
            f = a.get('fargodeep') or {}
            if (any(p.get(k) is not True for k in ('present', 'aliveKnown', 'alive', 'healthKnown', 'unitFlagsKnown'))
                    or not 0 < number(p.get('health', 0)) <= number(p.get('maxHealth', 0)) or self.combat(scene)
                    or (scene['world'].get('owner') or {}).get('present') is True
                    or any(a.get(k) is True for k in ('moving', 'motionUnconfirmed', 'castPending', 'autoAttacking', 'autoAttackRequested', 'autoAttackUnconfirmed', 'traveling', 'practicing'))
                    or a.get('interactionOwner') or f.get('active') is True
                    or f.get('phase') in ('explicit_follow_stop', 'explicit_assist_stop', 'authorization_expired')
                    or loot.get('phase') != 'idle' or number(loot.get('pendingCorpseGuid', 0)) or number(loot.get('pendingGameObjectGuid', 0))
                    or scene['quests'].get('actionInFlight') is True or not c.trade_idle(scene['trade'])
                    or scene['professions'].get('active') is True or scene['professions'].get('closing') is True
                    or operation and (operation.get('status') not in ('COMPLETED', 'SERVER_REJECTED', 'BLOCKED', 'CANCELLED') or operation.get('leaseReleased') is not True or operation.get('cleanupUnconfirmed') is True)):
                return False
        row['abandonment'] = {'kind': 'outcome_unknown_target_quarantined', 'cause': cause,
            'sessions': dict(self.sessions), 'observedAt': self.now()}
        row['phase'] = 'stopped'; self.persist()
        self.status['phase'] = 'terminal_encounter_cleaned_target_quarantined'
        return True

    def arm(self, scenes, target):
        if len(self.data['encounters']) >= 96: raise Error('Finite encounter journal is full')
        engager = next(g for g in (4, 1, 5) if not all(scenes[g]['log'][q] for q in GOALS))
        row = {'target': number(target['guid']), 'entry': number(target['entry']), 'engager': engager, 'phase': 'arming',
            'deadObserved': False, 'requests': {}, 'started': self.now()}
        self.data['encounters'].append(row); self.persist()
        try:
            for guid in [g for g in ROSTER if g != engager] + [engager]:
                # A new read before each arming keeps support-before-pull order
                # bound to current bodies, actual logs and safe party state.
                fresh = self.read(row['target'])
                if not self.safe_pull(fresh, row) or self.controls(fresh) != self.data.get('controls'):
                    raise Error('Party safety or human control intent changed before encounter arming')
                if guid == engager and any(not self.scope(fresh[g]['actions'], row) or fresh[g]['actions'].get('fargodeep', {}).get('active') is not True for g in ROSTER if g != engager):
                    raise Error('Supports were not actually armed before the pull')
                if self.stopped() or self.now() >= self.deadline: raise Error('Finite catchup stopped before arming')
                row['requests'][str(guid)] = {'phase': 'reserved', 'questRevision': fresh[guid]['questRevision']}; self.persist()
                answer = self.rpcs[guid].call('buddy-actions.fargodeep_encounter', {'enabled': True, 'sessionId': self.sessions[str(guid)],
                    'targetGuid': str(row['target']), 'engagerGuid': str(engager), 'expectedQuestLogRevision': str(fresh[guid]['questRevision'])})
                row['requests'][str(guid)]['phase'] = 'sent'; self.persist()
                if not self.scope(answer, row) or answer.get('fargodeep', {}).get('active') is not True: raise Error('Encounter activation is unconfirmed')
                row['requests'][str(guid)]['phase'] = 'observed'; self.persist()
            row['phase'] = 'active'; self.persist()
        except EncounterRejected:
            row['activationRejection'] = {'guid': guid, 'status': 'FailedPrecondition'}
            row['phase'] = 'unconfirmed'; self.persist()
            if self.abandon_terminal(row, 'activation_failed_precondition'): return
            self.done = True; self.status['phase'] = 'rejected_encounter_cleanup_unconfirmed'; return
        except Error:
            row['phase'] = 'unconfirmed'; self.persist(); self.cleanup(row)
            self.done = True; self.status['phase'] = 'encounter_arming_unconfirmed_no_replay'; return
        self.status.update(phase='waiting_for_actual_combat_and_loot', targetGuid=str(row['target']), engagerGuid=row['engager'])

    def tick(self):
        if self.done: return
        row = next((r for r in reversed(self.data['encounters']) if r['phase'] not in ('settled', 'stopped')), None)
        if self.stopped() or self.now() >= self.deadline:
            self.status.update(phase='stopped' if self.stopped() else 'finite_deadline', observationsCurrent=False)
            if row and not self.cleanup(row): self.status['phase'] = 'cleanup_unconfirmed'
            self.done = True; return
        search = self.data.get('search')
        last_leg = search['legs'][-1] if search else None
        if last_leg and last_leg['phase'] not in ('arrived', 'preempted') and not self.stopped_arrival_evidence(last_leg):
            self.done = True; self.status['phase'] = 'corridor_previous_leg_requires_reconciliation'; return
        self.status['observationsCurrent'] = False
        scenes = self.read(row['target'] if row else 0)
        if self.data.get('controls') is not None and self.controls(scenes) != self.data['controls']:
            if row: self.cleanup(row)
            self.done = True; self.status['phase'] = 'stopped_after_control_intent_changed'; return
        if any(s['self'].get('aliveKnown') is not True or s['self'].get('alive') is not True for s in scenes.values()):
            if row: self.cleanup(row)
            self.done = True; self.status['phase'] = 'yielded_to_normal_death_recovery'; return
        if last_leg and last_leg['phase'] == 'yielded':
            if not self.safe_search(scenes):
                self.status['phase'] = 'waiting_for_safe_stopped_arrival_observation'; return
            if not self.observe_stopped_arrival(scenes):
                self.done = True; self.status['phase'] = 'corridor_previous_leg_requires_reconciliation'; return
        if search and search['legs'][-1]['phase'] == 'preempted' and row is None:
            if not self.known_preemption(search['legs'][-1]):
                self.done = True; self.status['phase'] = 'corridor_previous_leg_requires_reconciliation'; return
            if not self.safe_search(scenes):
                self.status['phase'] = 'waiting_for_safe_party_after_known_corridor_preemption'; return
        if row:
            for guid, scene in scenes.items():
                target = scene['world'].get('requestedCreature')
                world_dead = (isinstance(target, dict) and number(target.get('guid', 0)) == row['target'] and target.get('present') is True
                        and target.get('aliveKnown') is True and target.get('alive') is False and target.get('healthKnown') is True and number(target.get('health', 0)) == 0)
                terminal = scene['actions'].get('fargodeep') or {}
                retained_dead = (self.scope(scene['actions'], row) and terminal.get('active') is not True
                    and terminal.get('phase') == 'target_death_observed')
                if not row['deadObserved'] and (world_dead or retained_dead):
                    row['deadObserved'] = True
                    row['deathObservation'] = {'source': 'world_current_corpse' if world_dead else 'actions_retained_bound_death',
                        'observerGuid': guid, 'sessionId': self.sessions[str(guid)], 'targetGuid': str(row['target']), 'engagerGuid': row['engager']}
                    self.persist()
            # A positive bound receipt resolves only the death observation.
            # It never re-arms the old GUID or supplies item/quest progress.
            if row['deadObserved'] and row['phase'] in ('arming', 'unconfirmed'):
                row['phase'] = 'active'; self.persist()
            if row['phase'] == 'unconfirmed':
                designated = scenes[row['engager']]['actions']
                terminal = designated.get('fargodeep') or {}
                if (not row['deadObserved'] and self.scope(designated, row) and terminal.get('active') is not True
                        and terminal.get('phase') == 'additional_attacker_observed'
                        and self.abandon_terminal(row, 'additional_attacker_observed')):
                    return
                self.cleanup(row); self.done = True; self.status['phase'] = 'encounter_outcome_unconfirmed_no_replay'; return
            if row['phase'] in ('arming', 'active'):
                if row['phase'] == 'arming':
                    # A process restart cannot resend any reserved activation.
                    row['phase'] = 'unconfirmed'; self.persist(); self.cleanup(row)
                    self.done = True; self.status['phase'] = 'reserved_encounter_requires_reconciliation_no_replay'; return
                if any(self.combat(s) for s in scenes.values()):
                    self.status['phase'] = 'actual_party_combat_in_progress'; return
                designated = scenes[row['engager']]['actions']
                terminal = designated.get('fargodeep') or {}
                if (not row['deadObserved'] and self.scope(designated, row) and terminal.get('active') is not True
                        and terminal.get('phase') in AUTO_TERMINAL):
                    cause = terminal['phase']
                    if self.abandon_terminal(row, cause): return
                    row['phase'] = 'unconfirmed'; self.persist(); self.done = True
                    self.status['phase'] = 'terminal_encounter_cleanup_unconfirmed'; return
                if row['deadObserved']:
                    if not self.cleanup(row): self.status['phase'] = 'waiting_for_exact_encounter_cleanup'; return
                    row['phase'], row['lootAt'] = 'loot', self.now(); self.persist()
                elif not any(s['actions'].get('fargodeep', {}).get('active') is True for s in scenes.values()):
                    row['phase'] = 'unconfirmed'; self.persist(); self.done = True
                    self.status['phase'] = 'encounter_ended_without_observed_dead_target'; return
                else:
                    self.status['phase'] = 'waiting_for_actual_engagement'; return
            if row['phase'] == 'loot':
                if self.prepare_corpse_loot(scenes, row): return
                if 'lootWaitAt' not in row:
                    row['lootWaitAt'] = self.now(); self.persist()
                pending = any(number(s['loot'].get('pendingCorpseGuid', 0)) or s['loot'].get('phase') != 'idle' for s in scenes.values())
                eligible = any(any(number(t.get('guid', 0)) == row['target'] for t in s['world'].get('lootableCorpses', [])) for s in scenes.values())
                if pending or eligible or self.now()-row['lootWaitAt'] < 2:
                    self.status['phase'] = 'waiting_for_each_own_server_permitted_loot'
                    if self.now()-row['lootWaitAt'] > 35:
                        self.done = True; self.status['phase'] = 'loot_uncollected_or_cleanup_unconfirmed_no_new_pull'
                    return
                row['phase'] = 'settled'; self.persist()
        if all(all(s['log'][qid] for qid in GOALS) for s in scenes.values()):
            self.done = True; self.status['phase'] = 'own_collection_quests_complete_for_all_three'; return
        if not self.safe_pull(scenes): self.status['phase'] = 'waiting_for_safe_healthy_idle_party'; return
        if self.data.get('controls') is None:
            self.data['controls'] = self.controls(scenes); self.persist()
        target = self.candidate(scenes)
        if target is None:
            self.idle_polls += 1
            self.status['phase'] = 'waiting_for_actual_nearby_isolated_kobold'
            if self.idle_polls >= 3: self.search(scenes)
            return
        self.idle_polls = 0
        self.arm(scenes, target)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('run', 'status', 'stop'))
    parser.add_argument('--session', action='append', default=[], metavar='GUID=BODY_SESSION')
    parser.add_argument('--max-seconds', type=int, default=600)
    parser.add_argument('--state-dir', type=Path, default=c.ROOT/'data/cave-catchup')
    args = parser.parse_args(argv)
    folder = c.ensure_state(args.state_dir)
    if args.command == 'status': print(json.dumps(read_private(folder/'status.json') or {})); return 0
    if args.command == 'stop':
        status = read_private(folder/'status.json') or {}
        if status.get('identity') != IDENTITY or not isinstance(status.get('instance'), str): raise Error('No matching owned cave job')
        write_private(folder/'stop.json', {'identity': IDENTITY, 'instance': status['instance']}); return 0
    sessions = {}
    for value in args.session:
        parts = value.split('=', 1)
        if len(parts) != 2 or not parts[0].isdigit() or int(parts[0]) in sessions: raise Error('Use three unique GUID=BODY_SESSION bindings')
        sessions[int(parts[0])] = session(parts[1])
    with os.fdopen(c.private_open(folder/'lock', os.O_RDWR | os.O_CREAT), 'r+') as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError: raise Error('Another cave catchup job already owns the party') from None
        instance, stopped = uuid.uuid4().hex, [False]
        def stopping():
            marker = read_private(folder/'stop.json') or {}
            return stopped[0] or marker.get('identity') == IDENTITY and marker.get('instance') == instance
        for name in (signal.SIGINT, signal.SIGTERM): signal.signal(name, lambda *_: stopped.__setitem__(0, True))
        rpcs = {g: RPC(f'http://127.0.0.1:{port}/rpc', timeout=3) for g, (_, port, _) in ROSTER.items()}
        worker = Catchup(rpcs, sessions, save=lambda v: write_private(folder/'ledger.json', v), stored=read_private(folder/'ledger.json'), stopped=stopping, max_seconds=args.max_seconds)
        try:
            while not worker.done:
                try: worker.tick()
                except Error as error:
                    worker.status.update(phase='observation_or_binding_unavailable', reason=str(error), observationsCurrent=False)
                    if worker.done: break
                worker.status.update(instance=instance, active=not worker.done, updatedAt=time.time())
                write_private(folder/'status.json', worker.status)
                if not worker.done: time.sleep(1)
        finally:
            row = next((r for r in reversed(worker.data['encounters']) if r['phase'] not in ('settled', 'stopped')), None)
            if row and not worker.cleanup(row): worker.status['phase'] = 'cleanup_unconfirmed'
            worker.status.update(instance=instance, active=False, updatedAt=time.time())
            write_private(folder/'status.json', worker.status)
    return 0


if __name__ == '__main__':
    try: raise SystemExit(main())
    except (Error, OSError, ValueError) as error: print(str(error), file=__import__('sys').stderr); raise SystemExit(1)
