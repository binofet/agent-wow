#!/usr/bin/env python3
"""Maintain caster mana, water, and room for nearby party loot."""
import argparse
import concurrent.futures
import fcntl
import json
from pathlib import Path
import signal
import time

from party_bag_pressure import maintain_bag_pressure, safe_junk_entries
from party_mana_drink import maintain_drink
from party_mana_supply import maintain_supply, runtime

CASTERS = {8086: "1", 8087: "4", 8402: "8"}
PARTY = {**CASTERS, 8088: "5"}
METHODS = {
    "world": "buddy-world.snapshot",
    "actions": "buddy-actions.status",
    "inventory": "buddy-inventory.state",
    "party": "buddy-party.state",
    "trade": "buddy-trade.state",
    "spell_toolkit": "buddy-actions.spell_toolkit",
}


class RPCError(RuntimeError):
    pass


_RPC_CLIENTS = {}


def rpc(port, method, params=None):
    if port not in _RPC_CLIENTS:
        _RPC_CLIENTS[port] = runtime.RPC(f"http://127.0.0.1:{port}/rpc",
            request_bytes=8*1024*1024, response_bytes=8*1024*1024)
    try:
        return _RPC_CLIENTS[port].call(method, params or {}, timeout=1.5)
    except runtime.Error as error:
        raise RPCError(str(error)) from error


def observe(port):
    try:
        world = rpc(port, METHODS["world"])
        player = world.get("self", {})
        if str(player.get("guid")) != PARTY[port] or not player.get("present"):
            return None
        view = {"world": world}
        for key, method in METHODS.items():
            if key != "world" and (port in CASTERS or key != "spell_toolkit"):
                view[key] = rpc(port, method)
        session = view["actions"].get("sessionId")
        if not session or any(view[key].get("sessionId") != session for key in ("party", "inventory", "trade")):
            return None
        try:
            view["loot"] = rpc(port, "buddy-loot.state")
        except (KeyError, OSError, ValueError, RPCError):
            view["loot"] = {}
        return view
    except (KeyError, OSError, ValueError, RPCError):
        return None


def run(state_dir):
    catalog_path = Path(__file__).resolve().parents[1] / "pkg/gamecatalog/catalog.json"
    junk_entries = safe_junk_entries(json.loads(catalog_path.read_text()))
    state_dir.mkdir(parents=True, exist_ok=True)
    with (state_dir / "worker.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        stop = False

        def stopping(*_):
            nonlocal stop
            stop = True

        signal.signal(signal.SIGTERM, stopping)
        signal.signal(signal.SIGINT, stopping)
        rests, supply, bag_attempts = {}, {}, {}
        previous, views = None, {}
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(PARTY)) as readers:
            try:
                while not stop:
                    views = {port: view for port, view in zip(PARTY, readers.map(observe, PARTY)) if view}
                    drink = maintain_drink(rpc, views, rests)
                    for port, view in views.items():
                        view["mana_rest_active"] = port in rests
                    bags = maintain_bag_pressure(rpc, views, bag_attempts, junk_entries)
                    try:
                        water = maintain_supply(rpc, views, supply)
                    except (KeyError, OSError, ValueError, RPCError) as error:
                        water = str(error)
                    status = {
                        "phases": {"drinking": drink, "water": water, "bag_space": bags},
                        "casters": {
                            str(port): {"mana": view["world"]["self"].get("power", 0),
                                        "max_mana": view["world"]["self"].get("maxPower", 0),
                                        "drinks": view["inventory"].get("manaDrinkCount", 0)}
                            for port, view in views.items() if port in CASTERS
                        },
                    }
                    if "error" in supply:
                        status["water_error"] = supply["error"]
                    if status != previous:
                        tmp = state_dir / "status.next.json"
                        tmp.write_text(json.dumps(status, sort_keys=True) + "\n")
                        tmp.replace(state_dir / "status.json")
                        previous = status
                    time.sleep(1)
            finally:
                for port, view in views.items():
                    if port in rests and rests[port].get("restoreFollow") is True:
                        try:
                            current = rpc(port, METHODS["actions"])
                            if current.get("sessionId") == rests[port].get("sessionId"):
                                rpc(port, "buddy-actions.follow", {"enabled": True})
                        except (OSError, RPCError):
                            pass


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state-dir", type=Path, required=True)
    run(parser.parse_args().state_dir)
