#!/usr/bin/env python3
"""Edit an embodied companion's live Lua policy directly; no coding queue."""
import argparse
import copy
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import tempfile
import time
import policy_binding

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('self_edit_converse', str(ROOT / 'dev/converse'))
spec = importlib.util.spec_from_loader(loader.name, loader)
c = importlib.util.module_from_spec(spec)
loader.exec_module(c)
DATA = ROOT / 'data/self-edit'
MAX_SOURCE_BYTES = 8 * 1024 * 1024  # Legacy hosts without a reflected source budget.


def digest(source):
    return hashlib.sha256(source.encode()).hexdigest()


def private_folder(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise c.ConversationError('Owned private policy directory required')


def save_source(path, source):
    """Retain the candidate before the RPC so a lost reply is reconcilable."""
    fd, temporary = tempfile.mkstemp(prefix='.policy-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            output.write(source)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_source(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd) as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise c.ConversationError('Regular Lua source required')
        result = source.read()
    if not result.encode():
        raise c.ConversationError('Lua source must not be empty')
    return result


def owned(rpc, guid, sid):
    body = rpc.call('buddy-actions.status', {})
    behavior = rpc.call('buddy-actions.behavior', {})
    if (behavior.get('sessionId') != sid or body.get('sessionId') != sid
            or c.integer(behavior.get('selfGuid', 0)) != guid
            or c.integer(body.get('selfGuid', 0)) != guid):
        raise c.ConversationError('Requested character/body changed; refresh observations')
    return behavior


def inspect_spell(guid, sid, rpc, spell_id=0):
    """Read one learned spell and the installed cast inputs; never cast here."""
    if (type(guid) is not int or not 0<guid<2**48 or not isinstance(sid,str)
            or not re.fullmatch(r'[A-Za-z0-9._-]{1,128}',sid)
            or type(spell_id) is not int or not 0<=spell_id<2**32):
        raise c.ConversationError('Exact body and uint32 spell ID required')
    def body():
        state=rpc.call('buddy-actions.status',{})
        if state.get('sessionId')!=sid or c.integer(state.get('selfGuid',0))!=guid:
            raise c.ConversationError('Requested character/body changed; refresh observations')
    body()
    toolkit=rpc.call('buddy-actions.spell_toolkit',{})
    if (toolkit.get('sessionId')!=sid or c.integer(toolkit.get('selfGuid',0))!=guid
            or toolkit.get('spellbookKnown') is not True):
        raise c.ConversationError('Actual same-body learned spellbook required')
    rows=toolkit.get('spells',[])
    if not isinstance(rows,list) or len(rows)>4096:
        raise c.ConversationError('Bounded learned spellbook required')
    known={}
    for row in rows:
        value=c.integer(row.get('spellId',0)) if isinstance(row,dict) else 0
        if not 0<value<2**32 or value in known:
            raise c.ConversationError('Unique actual learned spell IDs required')
        known[value]=row
    catalog=rpc.call('session.describe',{})
    if catalog.get('sessionId')!=sid or str(catalog.get('characterGuid'))!=str(guid):
        raise c.ConversationError('Cast capability catalog belongs to another body')
    methods=[copy.deepcopy(row) for row in catalog.get('methods',[]) if isinstance(row,dict)
        and row.get('name') in ('buddy-actions.cast_spell','buddy-actions.cast_self','buddy-actions.cancel_spell')]
    inputs={}
    def schema(name):
        if name in inputs:return
        value=catalog.get('messages',{}).get(name)
        if not isinstance(value,dict):return
        inputs[name]=copy.deepcopy(value)
        for field in value.get('fields',[]):
            if isinstance(field,dict) and field.get('kind')=='message':schema(field.get('type'))
    for method in methods:schema(method.get('inputType'))
    body()
    result=dict(sessionId=sid,characterGuid=str(guid),spellbookRevision=toolkit.get('spellbookRevision','0'),
        catalogRevision=catalog.get('revision'),castMethods=methods,castInputs=inputs,
        effectClassificationIsNotCastAvailability=True)
    if spell_id:
        result.update(spellId=spell_id,learned=spell_id in known,spell=copy.deepcopy(known.get(spell_id)))
    else:
        result['spells']=[{key:copy.deepcopy(row[key]) for key in
            ('spellId','metadataKnown','name','genericCastSupported','selfCastSupported','channeled','passive','classificationReason')
            if key in row and (key!='name' or row.get('metadataKnown') is True)} for row in rows]
    return result


def edit(command, guid, sid, rpc, source=None, expected=None, data=None):
    if (type(guid) is not int or not 0 < guid < 2**48 or not isinstance(sid, str)
            or not re.fullmatch(r'[A-Za-z0-9._-]{1,128}', sid)):
        raise c.ConversationError('Explicit character and body identity required')
    if command not in ('show', 'apply', 'builtin'):
        raise c.ConversationError('Unknown policy command')
    if command != 'show' and (not isinstance(expected, str)
                             or not re.fullmatch(r'|[a-f0-9]{64}', expected)):
        raise c.ConversationError('Explicit expected revision required')
    if command == 'apply' and (not isinstance(source, str) or not source.encode()):
        raise c.ConversationError('Bounded Lua source required')
    root = Path(data) if data is not None else DATA
    private_folder(root)
    actor = root / str(guid)
    private_folder(actor)
    fd = os.open(actor / 'edit.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'r+') as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise c.ConversationError('Owned private edit lock required')
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise c.ConversationError('Another direct edit is in progress; refresh before editing') from None
        identity = dict(sessionId=sid, characterGuid=str(guid))
        def read_session_policy():
            view = rpc.call('session.policy_source', identity)
            if view.get('sessionId') != sid or view.get('characterGuid') != str(guid):
                raise c.ConversationError('Requested character/body changed; refresh observations')
            return view

        try:
            before = read_session_policy()
        except c.CapabilityUnavailable:
            before = owned(rpc, guid, sid)
            session_policy = False
        else:
            session_policy = True
        source_limit=before.get('sourceLimitBytes',MAX_SOURCE_BYTES)
        if type(source_limit) is not int or source_limit<=0:
            raise c.ConversationError('Host source budget unavailable')
        if command=='apply' and len(source.encode())>source_limit:
            raise c.ConversationError(f'Lua source must contain 1..{source_limit} bytes (configured host source budget)')
        revision = before.get('revision', '')
        if command == 'show':
            result = dict(characterGuid=str(guid), sessionId=sid, status=before,
                          schema='behaviors/contract_generated.lua', nativeSource='modules/buddy-actions',
                          scope=['heal_target', 'heal_spell', 'damage_spell'], sourceKnown=False)
            if session_policy:
                result.update(runtime='session', scope=['attached_session_policy'],
                              sourceKnown=True, source=before['source'])
            elif revision:
                candidates = [actor / (revision + '.lua'), ROOT / 'behaviors/party.lua']
                for path in candidates:
                    try:
                        content = read_source(path)
                    except FileNotFoundError:
                        continue
                    if digest(content) == revision:
                        result.update(sourceKnown=True, source=content)
                        break
            return result
        if revision != expected:
            raise c.ConversationError('Live policy changed; read it before editing')
        binding = policy_binding.capture(actor, sid, expected) if session_policy else None
        target = digest(source) if command == 'apply' else ''
        if command == 'apply':
            save_source(actor / (target + '.lua'), source)
        started = time.monotonic()
        if session_policy:
            request = dict(identity, expectedRevision=expected)
            if command == 'apply':
                request['source'] = source
            else:
                request['useBuiltin'] = True
            if command == 'builtin' or revision != target:
                applied = rpc.call('session.reload_policy', request)
                if command == 'builtin':
                    target = applied.get('revision')
        elif revision != target:
            # One CAS write, including during combat. Native spell eligibility,
            # leases and packet receipts remain owned by the running controller.
            # A timeout never triggers a second write here.
            rpc.call('buddy-actions.reload_behavior', dict(sessionId=sid, selfGuid=str(guid),
                     expectedRevision=expected, source=source if command == 'apply' else '',
                     useBuiltin=command == 'builtin'))
        after = read_session_policy() if session_policy else owned(rpc, guid, sid)
        if after.get('revision', '') != target:
            raise c.ConversationError('Policy is not current; inspect quarantine or concurrent edit')
        durable = False
        confirmed_source = after.get('source') if session_policy else None
        if isinstance(confirmed_source, str) and digest(confirmed_source) == target:
            save_source(actor / (target + '.lua'), confirmed_source)
            durable = policy_binding.promote(actor, binding, target, sid)
        return dict(characterGuid=str(guid), sessionId=sid, revision=target,
                    startupBindingConfirmed=durable,
                    phase='already_current' if revision == target else 'live', reconnected=False,
                    elapsedMs=round((time.monotonic() - started) * 1000, 2),
                    evaluations=after.get('evaluations', '0'))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('show', 'apply', 'builtin', 'spell'))
    parser.add_argument('--guid', type=int, required=True)
    parser.add_argument('--session-id', required=True)
    parser.add_argument('--rpc-url', required=True)
    parser.add_argument('--expected-revision')
    parser.add_argument('--source', type=Path)
    parser.add_argument('--spell-id',type=int,default=0,help='Exact learned ID; 0 lists the observed spellbook')
    args = parser.parse_args()
    if args.command == 'apply' and args.source is None:
        parser.error('apply requires --source')
    if args.command in ('apply','builtin') and args.expected_revision is None:
        parser.error('apply/builtin requires --expected-revision (empty string for native policy)')
    if args.command=='spell':
        print(json.dumps(inspect_spell(args.guid,args.session_id,c.RPC(args.rpc_url),args.spell_id),ensure_ascii=False))
        return
    source = read_source(args.source) if args.command == 'apply' else None
    print(json.dumps(edit(args.command, args.guid, args.session_id, c.RPC(args.rpc_url),
                          source, args.expected_revision), ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, c.ConversationError) as error:
        raise SystemExit('Direct edit: ' + str(error))
