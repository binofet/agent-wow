disenchant = load('party_town_disenchant', 'party-disenchant')
Error, integer, ROOT = c.ConversationError, c.integer, c.ROOT
ROSTER = {1: ("Arlen", 8086), 4: ("Mira", 8087), 5: ("Rook", 8088)}
MUTATIONS = {"buddy-inventory.move", "buddy-inventory.equip", "buddy-inventory.equip_gear", "buddy-inventory.sell", "buddy-mail.claim_bag_attachment"}
CONTROLS = (("loot", "buddy-loot.enable", "enabled", "loot"),
            ("assist", "buddy-actions.assist", "assisting", "actions"),
            ("healing", "buddy-actions.healing", "healing", "actions"),
