#!/usr/bin/env python3
"""Write an editable Lua encounter bundle for a character profile."""

import argparse
from pathlib import Path
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--intent", type=Path, help="Lua module returning an encounter plan and damage preferences")
    args = parser.parse_args()
    behaviors = Path(__file__).resolve().parent.parent / "behaviors"
    modules = [
        ("encounter_mission_repair", behaviors / "mission-repair.lua"),
        ("encounter_tactics", behaviors / "encounter-tactics.lua"),
        ("encounter_gear", behaviors / "gear.lua"),
        ("encounter_auto_equipment", behaviors / "auto-equipment.lua"),
        ("encounter_disposal", behaviors / "item-disposal.lua"),
        ("encounter_trade_consent", behaviors / "trade-consent.lua"),
        ("encounter_stipend_selection", behaviors / "stipend-selection.lua"),
        ("encounter_quest_rewards", behaviors / "quest-rewards.lua"),
        ("encounter_corpse_loot", behaviors / "corpse-loot.lua"),
        ("encounter_gathering", behaviors / "gathering.lua"),
        ("encounter_spells", behaviors / "encounter-spells.lua"),
        ("encounter_warrior", behaviors / "classes/warrior.lua"),
        ("encounter_healing", behaviors / "healing.lua"),
        ("encounter_starter_objectives", behaviors / "starter-objectives.lua"),
        ("encounter_buttons", behaviors / "encounter-buttons.lua"),
        ("encounter_starter_spells", behaviors / "starter-spells.lua"),
        ("encounter_self_mana", behaviors / "self-mana.lua"),
        ("encounter_mana_supply", behaviors / "mana-supply.lua"),
        ("encounter_support", behaviors / "support.lua"),
        ("encounter_control_recovery", behaviors / "control-recovery.lua"),
        ("encounter_consumables", behaviors / "consumables.lua"),
        ("encounter_formation", behaviors / "follow-formation.lua"),
        ("encounter_buffs", behaviors / "buffs.lua"),
        ("encounter_death_recovery", behaviors / "death-recovery.lua"),
        ("encounter_movement", behaviors / "encounter-movement.lua"),
        ("encounter_priors", behaviors / "encounter-priors.lua"),
        ("encounter_commands", behaviors / "encounter-commands.lua"),
        ("encounter_spell_invocation", behaviors / "spell-invocation.lua"),
        ("encounter_instance_entry", behaviors / "instance-entry.lua"),
        ("encounter_tasks", behaviors / "encounter-tasks.lua"),
        ("encounter_loot_roll", behaviors / "loot-roll.lua"),
    ]
    if args.intent:
        modules.append(("encounter_intent", args.intent))
    try:
        parts = [f"local {name} = (function()\n{source.read_text(encoding='utf-8')}\nend)()\n"
                 for name, source in modules]
        parts.append((behaviors / "encounter-session.lua").read_text(encoding="utf-8"))
    except (OSError, UnicodeError) as error:
        parser.exit(1, f"{error}\n")
    sys.stdout.write("".join(parts))


if __name__ == "__main__":
    main()
