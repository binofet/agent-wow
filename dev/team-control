def reset_admission(s, guid):
    """A normal logout may retire sticky latches; it never confirms their ACKs."""
    actual = s['actions']; own = s['world'].get('self', {})
    check(own.get('movementFlagsKnown') is True and number(own.get('movementFlags', 0)) & 0xff == 0
          and not actual.get('moving') and not actual.get('autoAttackRequested'), 'Reset waits for actual stationary out-of-combat state')
    admitted = copy.deepcopy(s)
    admitted['actions']['motionUnconfirmed'] = False
    admitted['actions']['autoAttackUnconfirmed'] = False
    if actual.get('autoAttackUnconfirmed') is True:
        # Retained AutoAttacking can belong to the same missing STOP receipt.
        # Only the new normal LogoutComplete/PID exit can retire this body.
        admitted['actions']['autoAttacking'] = False
    safe(admitted, guid)
    return s


def safe(s, guid, moving=False, restoring=False):
    own, a = s['world'].get('self', {}), s['actions']
    check(time.monotonic()-s['observedAt'] <= 5, 'Observation expired')
    guard_actions = dict(a)
    if restoring:
        # Restoring a toggle/local process is not a new cast. A freshly enabled
        # ordinary buff/heal may already be using the common cast reservation.
        guard_actions['castPending'] = False
    check(c.BuddyControls.quest_scene_safe(guard_actions, s['world'], guid), 'Own combat, cast, attack, or movement uncertainty')
    check(own.get('healthKnown') is True and 0 < number(own.get('health', 0)) <= number(own.get('maxHealth', 0))
          and number(own['health'])/number(own['maxHealth']) >= .85, 'Own health unsafe or unknown')
    group = s['party'].get('group', {})
    members = group.get('members', [])
    check(group.get('known') is True and group.get('inGroup') is True and isinstance(members, list) and len(members) <= 40
          and any(number(m.get('guid', 0)) == guid and m.get('self') is True and m.get('online') is True for m in members), 'Actual current party required')
    check(not a.get('practicing') and not a.get('fargodeep', {}).get('active') and not a.get('recovery', {}).get('active'), 'Finite combat or recovery active')
    if not moving:
        check(not a.get('moving') and not a.get('traveling') and number(own.get('movementFlags', 0)) & 0xff == 0, 'Actual movement must settle')
    check(not a.get('interactionOwner'), 'Interaction lease busy')
    owner = s['world'].get('owner', {})
    if owner.get('present') is True:
        check(number(owner.get('guid', 0)) == 3 and owner.get('unitFlagsKnown') is True and owner.get('movementFlagsKnown') is True
              and number(owner.get('unitFlags', 0)) & 0x80000 == 0, 'Observed owner fighting or unknown')
    check(c.trade_idle(s['trade']), 'Trade or disposal unsettled')
    for name in ('professions', 'inventory', 'quest-items'):
        row = s[name]; op = row.get('operation') or {}
