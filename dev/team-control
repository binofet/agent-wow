def progress(s):
    inv, quests = s['inventory'], s['quests']
    check(inv.get('inventoryKnown') is True and inv.get('equipmentKnown') is True and quests.get('questLogKnown') is True,
          'Full carried inventory, equipment and own quest baseline required')
    bags, gear, log = inv.get('inventoryBags', []), inv.get('equipment', []), quests.get('questLog', [])
    check(len(bags) == 5 and {number(b.get('bag', 0)) for b in bags} == set(range(5))
          and len(gear) == 19 and {number(e.get('slot', 0)) for e in gear} == set(range(19))
          and len(log) == 25 and {number(q.get('slot', 0)) for q in log} == set(range(25)), 'Complete private vectors required')
    items = []
    for b in bags:
        check(b.get('slotKnown') is True and b.get('contentsKnown') is True and len(b.get('slots', [])) == number(b.get('slotCount', 0)), 'Bag contents unknown')
        items.append(('bag', number(b.get('bag', 0)), number(b.get('containerGuid', 0))))
        for item in b.get('slots', []):
            check(not number(item.get('itemGuid', 0)) or item.get('metadataKnown') is True, 'Owned item metadata unknown')
            items.append(('item', number(b.get('bag', 0)), number(item.get('slot', 0)), number(item.get('itemGuid', 0)),
                          number(item.get('entry', 0)), number(item.get('stackCount', 0))))
    for item in gear:
        check(item.get('slotKnown') is True and (not number(item.get('itemGuid', 0)) or item.get('metadataKnown') is True), 'Equipment metadata unknown')
        items.append(('gear', number(item.get('slot', 0)), number(item.get('itemGuid', 0)), number(item.get('entry', 0)), number(item.get('stackCount', 0))))
    # Login compacts/reorders the quest-log slots. Compare actual progress by
    # quest ID; display positions and empty rows are not progression.
    active = [q for q in log if number(q.get('questId', 0))]
    check(len({number(q['questId']) for q in active}) == len(active), 'Duplicate active quest IDs')
    value = dict(items=sorted(items), quests=sorted((number(q['questId']),
        number(q.get('state', 0)), tuple(q.get('objectiveCounts', []))) for q in active))
    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()


