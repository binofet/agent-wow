def check(value, reason):
    if not value: raise Error(reason)


def number(value):
    if type(value) is int and value >= 0: return value
    if isinstance(value, str) and re.fullmatch('[0-9]{1,20}', value): return int(value)
    raise Error('Invalid bounded public number')


def token(value):
    check(isinstance(value, str) and re.fullmatch('[A-Za-z0-9_.-]{1,128}', value), 'Invalid body or operation binding')
    return value


def trusted_interpreter(path):
    if not isinstance(path, str) or not Path(path).is_absolute(): return False
    candidates = [Path(sys.executable)]
    # Homebrew's framework launcher and its actual macOS application binary
    # are distinct inodes. Both paths come from THIS running interpreter's
    # trusted installation, never from controller status or an addon request.
    if sys.platform == 'darwin':
        candidates.append(Path(sys.exec_prefix)/'Resources/Python.app/Contents/MacOS/Python')
    return any(candidate.is_file() and os.path.samefile(path, candidate) for candidate in candidates)


def load_json(path, limit=524288):
    try:
        with os.fdopen(c.private_open(path, os.O_RDONLY), 'rb') as stream: raw = stream.read(limit+1)
    except FileNotFoundError: return {}
    check(len(raw) <= limit, 'Private record exceeds bound')
    value = json.loads(raw); check(isinstance(value, dict), 'Private object required'); return value


def save_json(path, value):
    raw = json.dumps(value, allow_nan=False, sort_keys=True).encode()
    check(len(raw) <= 524288, 'Team ledger full; no old request tombstones are discarded')
    temporary = path.with_name('.team-'+uuid.uuid4().hex)
    try:
        with os.fdopen(c.private_open(temporary, os.O_CREAT|os.O_EXCL|os.O_WRONLY), 'wb') as stream:
            stream.write(raw+b'\n'); stream.flush(); os.fsync(stream.fileno())
        check(not path.is_symlink(), 'Private ledger cannot be a symlink')
        os.replace(temporary, path)
        descriptor = os.open(path.parent, os.O_RDONLY)
        try: os.fsync(descriptor)
        finally: os.close(descriptor)
    finally:
        temporary.unlink(missing_ok=True)


class RPC:
    def __init__(self, guid):
        check(guid in ROSTER, 'Fixed subject required')
        self.url = f'http://127.0.0.1:{ROSTER[guid][1]}/rpc'
        # Reuse the maintained loopback validation/no-proxy/no-redirect opener.
        self.opener = c.RPC(self.url, timeout=2).opener
    def call(self, method, params, timeout=2):
        check(method in METHODS, 'Unrecognized team RPC')
        request_id = uuid.uuid4().hex
        request = urllib.request.Request(self.url, data=json.dumps(dict(jsonrpc='2.0', id=request_id,
            method=method, params=params), allow_nan=False).encode(), headers={'Content-Type': 'application/json'})
        try:
            with self.opener.open(request, timeout=timeout) as reply: raw = reply.read(262145)
            check(len(raw) <= 262144, 'Response too large')
            value = json.loads(raw)
            check(value.get('jsonrpc') == '2.0' and value.get('id') == request_id and 'error' not in value
                  and isinstance(value.get('result'), dict), 'Matching result unavailable')
            return value['result']
        except (OSError, ValueError, Error):
            # Do not retain arbitrary response text, command arguments or secrets.
            raise Error('Public '+method+' result unavailable; mutation outcomes are never retried') from None


def scene(rpc, guid):
    start = time.monotonic(); party = rpc.call('buddy-party.state', {})
    sid = token(party.get('sessionId'))
    def read(name): return rpc.call('buddy-actions.status' if name == 'actions' else f'buddy-{name}.state', {})
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(READS)) as pool:
        values = dict(zip(READS, pool.map(read, READS)))
    world = rpc.call('buddy-world.snapshot', {})
    final = rpc.call('buddy-party.state', {})
    check(time.monotonic()-start <= 8 and final.get('sessionId') == sid, 'Fresh body frame unavailable')
    own = world.get('self', {}); actions = values['actions']
    check(number(own.get('guid', 0)) == guid and actions.get('sessionId') == sid
          and number(actions.get('selfGuid', 0)) == guid, 'Current body identity mismatch')
    for name in ('professions', 'inventory', 'quests', 'training', 'quest-items', 'mail', 'loot', 'trade'):
        check(values[name].get('sessionId') == sid, 'Module body changed: '+name)
    check(party.get('group') == final.get('group'), 'Party changed during observation')
    return dict(values, world=world, party=final, sessionId=sid, observedAt=time.monotonic())


