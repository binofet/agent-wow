class ConversationError(Exception):
    pass


class CursorReset(ConversationError):
    pass


class CapabilityUnavailable(ConversationError):
    pass


class Stopped(ConversationError):
    pass


def integer(value, label="counter"):
    if isinstance(value, bool) or not isinstance(value, (int, str)):
        raise ConversationError(f"Invalid {label} in chat response")
    try:
        result = int(value)
    except ValueError:
        raise ConversationError(f"Invalid {label} in chat response") from None
    if result < 0 or result > 2**64 - 1 or str(result) != str(value):
        raise ConversationError(f"Invalid {label} in chat response")
    return result


def plain_text(text, limit=255):
    if not isinstance(text, str) or not text.strip():
        raise ConversationError("Reply text is empty")
    try:
        encoded = text.encode("utf-8")
    except UnicodeError:
        raise ConversationError("Reply text is not valid UTF-8") from None
    if len(encoded) > limit:
        raise ConversationError("Reply exceeds the chat byte limit")
    if any(unicodedata.category(c).startswith("C") or c == "|" for c in text):
        raise ConversationError("Reply contains controls or game markup")
    if text != text.strip() or text.startswith(("/", ".", "!")):
        raise ConversationError("Reply resembles a command or has surrounding whitespace")
    return text


def validate_reply(value):
    allowed = {"text", "emote", "action", *NUMERIC_ARGS}
    if (not isinstance(value, dict) or not {"text", "emote"}.issubset(value)
            or not set(value).issubset(allowed)):
        raise ConversationError("Model response does not match the reply schema")
    text = plain_text(value["text"])
    if value["emote"] not in ("NONE", "WAVE", "BOW", "CHEER"):
        raise ConversationError("Model returned an unsupported emote")
    action = value.get("action", "NONE")
    if action not in ACTIONS:
        raise ConversationError("Model returned an unsupported game action")
    result = {"text": text, "emote": value["emote"], "action": action}
    for key in NUMERIC_ARGS:
        if key in value:
            arg = value[key]
            if type(arg) is not int or not 0 <= arg <= 2**32 - 1:
                raise ConversationError("Model returned an invalid numeric game argument")
            result[key] = arg
    return result


class RPC:
    def __init__(self, url, timeout=5):
        parsed = urllib.parse.urlsplit(url)
        if (parsed.scheme != "http" or parsed.hostname != "127.0.0.1"
                or parsed.username or parsed.password or parsed.query or parsed.fragment
                or parsed.path != "/rpc"):
            raise ConversationError("RPC must be an HTTP 127.0.0.1 /rpc endpoint")
        try:
            if parsed.port is None:
                raise ValueError
        except ValueError:
            raise ConversationError("RPC requires a valid explicit loopback port") from None
        self.url, self.timeout, self.request_id = url, timeout, 0
        # No proxy environment, cookies, or redirects for this local control endpoint.
        class NoRedirect(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, req, fp, code, msg, headers, newurl):
                return None
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())

    def call(self, method, params, timeout=None):
        if method not in ("buddy-chat.poll", "buddy-chat.send", "buddy-chat.emote", "buddy-chat.owner_feed",
                          "buddy-party.state", "buddy-party.accept",
                          "buddy-world.snapshot",
                          "buddy-quests.discover", "buddy-quests.state", "buddy-quests.offer", "buddy-quests.accept",
                          "buddy-quests.journal", "buddy-quests.turn_in", "buddy-quests.claim_reward",
                          "buddy-loot.state", "buddy-loot.enable",
                          "buddy-trade.state", "buddy-trade.open", "buddy-trade.offer_item",
                          "buddy-trade.offer_gold", "buddy-trade.cancel", "buddy-trade.lookup_items",
                          "buddy-quest-items.state",
                          "buddy-inventory.state",
                          "buddy-actions.status", "buddy-actions.follow",
                          "buddy-actions.healing", "buddy-actions.heal_once", "buddy-actions.assist"):
            raise ConversationError("Unsupported chat method")
        self.request_id += 1
        body = json.dumps({"jsonrpc": "2.0", "id": self.request_id,
                           "method": method, "params": params}).encode()
        request = urllib.request.Request(self.url, data=body,
                                         headers={"Content-Type": "application/json"})
        try:
            request_timeout = self.timeout if timeout is None else min(self.timeout, timeout)
            if method == "buddy-trade.lookup_items":
                request_timeout = min(request_timeout, .45)
            with self.opener.open(request, timeout=request_timeout) as response:
                raw = response.read(256 * 1024 + 1)
            if len(raw) > 256 * 1024:
                raise ConversationError("Chat RPC response exceeds the limit")
            result = json.loads(raw)
        except (OSError, ValueError, urllib.error.URLError):
            raise ConversationError("Chat RPC is unavailable or returned invalid JSON") from None
        if (not isinstance(result, dict) or result.get("jsonrpc") != "2.0"
                or type(result.get("id")) is not int or result["id"] != self.request_id):
            raise ConversationError("Chat RPC response identity does not match")
        if "error" in result:
            error = result["error"]
            message = error.get("message", "") if isinstance(error, dict) else ""
            if method == "buddy-chat.poll" and ("cursor is newer than this module session" in message
                                               or "chat module session changed" in message):
                raise CursorReset("Chat body restarted")
            if isinstance(error, dict) and error.get("code") == -32601:
                raise CapabilityUnavailable("This game control is not installed")
            # Do not log server messages, which could contain reflected player text.
            raise ConversationError("Chat RPC rejected the request")
        if not isinstance(result.get("result"), dict):
            raise ConversationError("Chat RPC returned a non-object result")
        return result["result"]


def codex_command(binary, workspace, schema, output):
    command = [str(binary), "exec", "--ephemeral", "--ignore-user-config",
               "--skip-git-repo-check", "--sandbox", "read-only", "--color", "never",
               "--json", "--output-schema", str(schema), "--output-last-message", str(output),
               "--cd", str(workspace), "-c", 'web_search="disabled"',
               "-c", "apps._default.enabled=false"]
    for feature in DISABLED_FEATURES:
        command.extend(("--disable", feature))
    return command + ["-"]


def inspect_events(raw):
    """Fail closed if CLI reports tools, errors, or an incomplete generation.

    Feature flags remove ordinary tools. This check is additional detection, not
    a replacement for the CLI's read-only sandbox and disabled integrations.
    """
    completed, turn_started = False, False
    for line in raw.splitlines():
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except (ValueError, UnicodeError):
            raise ConversationError("Codex returned non-JSON events") from None
        if not isinstance(event, dict):
            raise ConversationError("Codex returned an invalid event")
        kind = event.get("type")
        if kind in ("item.started", "item.updated", "item.completed"):
            item = event.get("item", {})
            if (not turn_started and kind == "item.completed" and isinstance(item, dict)
                    and item.get("type") == "error"
                    and item.get("message") == DISABLED_CODE_MODE_WARNING):
                # Installed CLI emits this diagnostic because we intentionally
                # removed the code-mode host. No model turn/tools have begun.
                continue
            if not isinstance(item, dict) or item.get("type") not in ("agent_message", "reasoning"):
                raise ConversationError("Codex attempted a tool; no reply was sent")
        elif kind == "turn.started":
            turn_started = True
        elif kind == "turn.completed":
            completed = True
        elif kind != "thread.started":
            raise ConversationError("Codex reported an error or unexpected event")
    if not completed:
        raise ConversationError("Codex did not complete a reply")


class CodexBrain:
    def __init__(self, binary, state_dir, timeout=120, stopped=lambda: False, character_name="Arlen", character_class="priest"):
        self.binary, self.state_dir = Path(binary), Path(state_dir)
        self.timeout, self.stopped = timeout, stopped
        self.persona = character_persona(character_name, character_class)

    def generate(self, history, control_state=None):
        # Keep the empty working directory outside the repository's project
        # configuration ancestry. Schema/replies/events stay in private state.
        # Auth stays in the normal CLI store; never copy/read OAuth credentials.
        with (tempfile.TemporaryDirectory(prefix="reply-", dir=self.state_dir) as folder,
              tempfile.TemporaryDirectory(prefix="warcraft-buddy-brain-") as workspace):
            folder = Path(folder)
            workspace = Path(workspace)
            schema, output = folder / "schema.json", folder / "reply.json"
            schema.write_text(json.dumps(REPLY_SCHEMA))
            prompt = (self.persona + "\nCurrent observations and control state JSON:\n"
                      + json.dumps(control_state or {}, ensure_ascii=False)
                      + "\nConversation JSON:\n" + json.dumps(history, ensure_ascii=False))
            # Files, rather than pipes, bound memory use and prevent pipe deadlock.
            with tempfile.TemporaryFile(dir=folder) as events, tempfile.TemporaryFile(dir=folder) as errors:
                process = subprocess.Popen(codex_command(self.binary, workspace, schema, output),
                                           stdin=subprocess.PIPE, stdout=events, stderr=errors,
                                           start_new_session=True)
                try:
                    process.stdin.write(prompt.encode())
                    process.stdin.close()
                    deadline = time.monotonic() + self.timeout
                    while process.poll() is None:
                        if self.stopped():
                            raise Stopped("Conversation stop requested")
                        if time.monotonic() >= deadline:
                            raise ConversationError("Codex reply timed out")
                        if events.tell() > 1024 * 1024 or errors.tell() > 1024 * 1024:
                            raise ConversationError("Codex output exceeds the limit")
                        time.sleep(0.1)
                    if process.returncode:
                        raise ConversationError("Codex reply failed; verify codex login status")
                    if errors.tell() > 1024 * 1024:
                        raise ConversationError("Codex output exceeds the limit")
                    events.seek(0)
                    raw = events.read(1024 * 1024 + 1)
                    if len(raw) > 1024 * 1024:
                        raise ConversationError("Codex output exceeds the limit")
                    inspect_events(raw)
                    if not output.is_file() or output.stat().st_size > 4096:
                        raise ConversationError("Codex did not produce a bounded JSON reply")
                    try:
                        value = json.loads(output.read_text())
                    except (ValueError, UnicodeError):
                        raise ConversationError("Codex reply is invalid JSON") from None
                    return validate_reply(value)
                finally:
                    if process.poll() is None:
                        try:
                            os.killpg(process.pid, signal.SIGTERM)
                        except ProcessLookupError:
                            pass  # The tracked child exited between poll and signal.
                        try:
                            process.wait(timeout=2)
                        except subprocess.TimeoutExpired:
                            try:
                                os.killpg(process.pid, signal.SIGKILL)
                            except ProcessLookupError:
                                pass
                            process.wait(timeout=2)
                    if process.stdin and not process.stdin.closed:
                        process.stdin.close()


class BuddyControls:
    """Only fixed-owner game controls; the model never supplies RPC methods."""
    def __init__(self, rpc, player_name="Joel", character_class="priest", owner_quest_context=None, character_guid=1):
        self.rpc, self.player_name = rpc, player_name
        self.character_class = character_class
        self.owner_quest_context = owner_quest_context
        self.character_guid = character_guid
        self.party, self.actions = {}, {}
        self.party_available = self.actions_available = False
        self.attempted_invites = set()
        self.party_session = ""
        self.events = []
        self.previous_group = None
        self.previous_cast_go = None
        self.quests, self.loot, self.trade, self.journal = {}, {}, {}, {}
        self.quests_available = self.loot_available = self.trade_available = self.journal_available = False
        self.previous_quest_confirmation = None
        self.previous_loot_items = self.previous_completed_trades = None
        self.reward_items = {"available": False, "items": []}
        self.quest_items, self.quest_items_available = {}, False
        self.inventory, self.inventory_names, self.inventory_session = {"available": False}, {}, ""

    def refresh(self):
        try:
            party = self.rpc.call("buddy-party.state", {})
            self.party_available = True
            session = party.get("sessionId", "")
            if not isinstance(session, str) or not 1 <= len(session) <= 128:
                raise ConversationError("Party session identifier is invalid")
            if session != self.party_session:
                self.attempted_invites.clear()
                self.party_session = session
            self.party = party
            group = party.get("group", {})
            in_group = isinstance(group, dict) and group.get("known") is True and group.get("inGroup") is True
            if self.previous_group is False and in_group:
                self.events.append("server_confirmed_party_join")
            self.previous_group = in_group
            invitation = party.get("pendingInvite", {})
            if isinstance(invitation, dict) and invitation.get("inviterName") == self.player_name:
                sequence = integer(invitation.get("sequence", "0"), "invite sequence")
                key = (session, sequence)
                if (sequence and invitation.get("decision", "PENDING") in ("PENDING", 0)
                        and key not in self.attempted_invites and len(self.attempted_invites) < 256):
                    # Reserve before writing: a timeout cannot cause a repeated accept.
                    self.attempted_invites.add(key)
                    result = self.rpc.call("buddy-party.accept", {
                        "sessionId": session, "inviteSequence": str(sequence), "inviterName": self.player_name})
                    if result.get("transportWritten") is not True:
                        raise ConversationError("Party acceptance write was not confirmed")
        except ConversationError:
            self.party_available = False
        try:
            self.actions = self.rpc.call("buddy-actions.status", {})
            casts = integer(self.actions.get("serverCastGo", "0"), "completed cast counter")
            if self.previous_cast_go is not None and casts > self.previous_cast_go:
                self.events.append("server_confirmed_spell_cast")
            self.previous_cast_go = casts
            self.actions_available = True
        except ConversationError:
            self.actions_available = False
        for name, method in (("quests", "buddy-quests.state"), ("loot", "buddy-loot.state"),
                             ("trade", "buddy-trade.state"), ("journal", "buddy-quests.journal"),
                             ("quest_items", "buddy-quest-items.state")):
            try:
                setattr(self, name, self.rpc.call(method, {"refresh": False} if name == "journal" else {}))
                if name == "quest_items":
                    value = self.quest_items
                    if (integer(value.get("selfGuid", 0)) != self.character_guid
                            or not isinstance(value.get("sessionId"), str) or not 1 <= len(value["sessionId"]) <= 128
                            or not 0 < integer(value.get("questId", 0)) < 2**32):
                        raise ConversationError("Quest executor identity is unavailable")
                setattr(self, name + "_available", True)
            except ConversationError:
                setattr(self, name + "_available", False)
        acceptance = self.quests.get("lastAcceptance", {}) if self.quests_available else {}
        if (isinstance(acceptance, dict) and acceptance.get("status") in ("CONFIRMED_IN_LOG", 2)):
            key = (self.quests.get("sessionId"), acceptance.get("questId"), acceptance.get("confirmedLogRevision"))
            if self.previous_quest_confirmation is not None and key != self.previous_quest_confirmation:
                self.events.append("server_confirmed_quest_in_own_log")
            self.previous_quest_confirmation = key
        for name, field, previous, event in (
                ("loot", "itemsStoredConfirmed", "previous_loot_items", "server_confirmed_loot_items_stored"),
                ("trade", "completedTrades", "previous_completed_trades", "server_confirmed_trade_completed")):
            if getattr(self, name + "_available"):
                try:
                    count = integer(getattr(self, name).get(field, "0"), field)
                    old = getattr(self, previous)
                    if old is not None and count > old:
                        self.events.append(event)
                    setattr(self, previous, count)
                except ConversationError:
                    setattr(self, name + "_available", False)
        self.events = self.events[-8:]
        try:
            raw = self.rpc.call("buddy-inventory.state", {})
            inventory = inventory_context(raw, self.character_guid)
            if inventory["sessionId"] != self.inventory_session:
                self.inventory_names, self.inventory_session = {}, inventory["sessionId"]
            missing = list(dict.fromkeys(row["entry"] for row in inventory.get("items", [])
                                       if row.get("metadataKnown") and row["entry"] not in self.inventory_names))[:6]
            if missing:
                try:
                    reply = self.rpc.call("buddy-trade.lookup_items", {"itemIds": missing})
                    rows = reply.get("items", [])
                    if reply.get("sessionId") == self.inventory_session and isinstance(rows, list) and len(rows) <= 6:
                        for row in rows:
                            if isinstance(row, dict) and row.get("available") is True and integer(row.get("itemId", 0)) in missing:
                                name = plain_text(row.get("name"), 120)
                                if len(self.inventory_names) < 128:
                                    self.inventory_names[integer(row["itemId"])] = name
                except ConversationError:
                    pass
            self.inventory = inventory_context(raw, self.character_guid, self.inventory_names)
        except ConversationError:
            self.inventory = {"available": False}

    def context(self):
        goal = quest_sync_snapshot(self.character_guid)
        standing = party_quest_sync_snapshot(self.character_guid)
        area = area_quest_snapshot(self.character_guid)
        task = quest_task_snapshot(self.character_guid, getattr(self.rpc, "url", None))
        if self.quest_items_available and task.get("bodySessionId") != self.quest_items.get("sessionId"):
            task["observationsCurrent"] = False
        state = {"abilities": {"following": self.actions_available,
                              "healing": self.actions_available and self.actions.get("classKnown") is True and self.actions.get("classId") == 5 and self.character_class == "priest" and self.actions.get("knownLesserHeal") is True,
                              "quests": self.quests_available, "looting": self.loot_available,
                              "trading": self.trade_available,
                              "assisting": self.actions_available and self.actions.get("classKnown") is True and self.actions.get("classId") == CLASS_IDS[self.character_class] and self.actions.get({"priest":"knownSmite","mage":"knownFireball","rogue":"knownAutoAttack"}.get(self.character_class,"unsupported")) is True,
                              "quest_sync_stop": goal.get("active") is True or standing.get("active") is True,
                              "area_quests": self.actions_available and self.quests_available,
                              "area_quests_stop": area.get("active") is True,
                              "quest_execution": self.actions_available and self.quest_items_available,
                              "quest_execution_stop": task.get("active") is True},
                 "quest_sync": goal,
                 "party_quest_sync": standing,
                 "area_quests": area,
                 "quest_task": task,
                 "quest_execution": self.quest_items if self.quest_items_available else {"available": False},
                 "inventory": self.inventory,
                 "town_upkeep": party_town_snapshot(self.character_guid),
                 "party_maintenance": party_maintenance_snapshot(self.character_guid),
                 "controls": self.actions if self.actions_available else {},
                 "party": self.party.get("group", {}) if self.party_available else {},
                 "quests": self.quests if self.quests_available else {},
                 "journal": self.journal if self.journal_available else {"available":False,"entries":[]},
                 "owner_reported_quests": owner_quest_snapshot(self.owner_quest_context),
                 "loot": self.loot if self.loot_available else {},
                 "trade": self.trade if self.trade_available else {},
                 "reward_items": self.reward_items,
                 "recent_events": self.events[-8:]}
        state["owner_shared_quests"] = {"available": False}
        if self.party_available and owner_party_known(self.party.get("group", {}), self.character_guid):
            try:
                state["owner_shared_quests"] = validated_owner_feed(self.rpc.call("buddy-chat.owner_feed", {}))
            except ConversationError:
                pass
        try:
            state["observations"] = self.rpc.call("buddy-world.snapshot", {})
        except ConversationError:
            state["observations"] = {}
        offer = self.quests.get("turnInOffer", {}) if self.quests_available else {}
        if (isinstance(offer, dict) and isinstance(offer.get("choices"), list)
                and 1 < len(offer["choices"]) <= 6 and offer.get("rewardRequested") is not True
                and integer(offer.get("expiresInMs", 0)) > 0
                and (self.reward_items.get("questId") != integer(offer.get("questId", 0))
                     or self.reward_items.get("offerRevision") != str(integer(offer.get("revision", 0)))
                     or self.reward_items.get("available") is not True)):
            try:
                response = self.rpc.call("buddy-trade.lookup_items", {"itemIds": [integer(row.get("itemId", 0)) for row in offer["choices"] if isinstance(row, dict)]})
                self.bound(response)
                self.reward_items = dict(reward_metadata_snapshot(response), questId=integer(offer.get("questId", 0)),
                                         offerRevision=str(integer(offer.get("revision", 0))))
                state["reward_items"] = self.reward_items
            except (ConversationError, ValueError, TypeError):
                pass
        return state

    @staticmethod
    def label(value, fallback, limit=60):
        try:
            return plain_text(value, limit)
        except ConversationError:
            return fallback

    @staticmethod
    def bound(state):
        session = state.get("sessionId", "")
        if not isinstance(session, str) or not 1 <= len(session) <= 128:
            raise ConversationError("Game module session identifier is invalid")
        return {"sessionId": session, "revision": str(integer(state.get("revision", "0")))}

    @staticmethod
    def quest_candidates(nearby, actions=None, world=None, character_guid=1):
        if not isinstance(nearby, list) or len(nearby) > 64:
            raise ConversationError("Questgiver observations are invalid")
        candidates = []
        for giver in nearby:
            if not isinstance(giver, dict) or giver.get("distanceKnown") is not True:
                continue
            distance, creature = giver.get("distance", 0), giver.get("creature", {})
            if (type(distance) not in (float, int) or not math.isfinite(distance)
                    or not isinstance(creature, dict)):
                continue
            guid = integer(creature.get("guid", "0"), "questgiver GUID")
            if guid >> 48 not in (0xf130, 0xf150):
                continue
            immediate = giver.get("canInteract") is True
            reason = giver.get("blockedReason", "")
            if immediate:
                if reason or not 0 <= distance <= 4:
                    continue
            else:
                # Normal formation movement is stoppable by the quest
                # endpoint's own lease. Unknown movement and casts are not.
                moving = reason == "character_motion_or_cast_unconfirmed"
                safe_scene = BuddyControls.quest_scene_safe(actions, world, character_guid)
                safe_motion = (safe_scene and actions.get("moving") is True)
                if (giver.get("canInteract", False) is not False
                        or (not moving and reason != "questgiver_outside_conservative_range")
                        or (moving and not safe_motion)
                        or not (0 <= distance <= 8 if moving else 4 < distance <= 8)
                        or any(creature.get(key) is not True for key in
                               ("present", "mapKnown", "positionKnown", "aliveKnown", "alive"))
                        or not safe_scene
                        or integer(creature.get("mapId", "0")) != integer(actions["position"].get("mapId", "0"))
                        or integer(creature.get("npcFlags", "0")) & 2 == 0):
                    continue
                coordinates = [creature.get(key, 0) for key in ("x", "y", "z")]
                if any(type(value) not in (int, float) or not math.isfinite(value)
                       or abs(value) >= 40000 for value in coordinates):
                    continue
                flags = integer(creature.get("movementFlags", "0"))
                if flags & ~0x1ff or flags & 0xff and integer(creature.get("positionAgeMs", "0")) > 1500:
                    continue
                pos = actions["position"]
                distance = math.sqrt(sum((creature.get(k, 0) - pos.get(k, 0)) ** 2 for k in ("x", "y", "z")))
                if distance > 8:
                    continue
            candidates.append((0 if immediate else 1, distance, guid))
        return candidates

    @staticmethod
    def quest_scene_safe(actions, world, character_guid):
        if not isinstance(actions, dict) or not isinstance(world, dict):
            return False
        own, pos = world.get("self", {}), actions.get("position", {})
        if not isinstance(own, dict) or not isinstance(pos, dict):
            return False
        if (integer(own.get("guid", "0")) != character_guid
                or any(own.get(k) is not True for k in ("present", "mapKnown", "aliveKnown", "alive", "unitFlagsKnown", "movementFlagsKnown"))
                or integer(own.get("unitFlags", "0")) & (0x1 | 0x4 | 0x40000 | 0x80000 | 0x100000 | 0x400000 | 0x800000 | 0x1000000 | 0x2000000 | 0x8000000)
                or integer(own.get("movementFlags", "0")) & ~0x1ff
                or integer(own.get("extraMovementFlags", "0")) != 0
                or any(actions.get(k) is True for k in ("castPending", "motionUnconfirmed", "autoAttackUnconfirmed", "autoAttacking", "autoAttackRequested"))
                or pos.get("known") is not True or pos.get("mapKnown") is not True
                or integer(pos.get("mapId", "0")) != integer(own.get("mapId", "0"))):
            return False
        return all(type(pos.get(k, 0)) in (int, float) and math.isfinite(pos.get(k, 0))
                   and abs(pos.get(k, 0)) < 40000 for k in ("x", "y", "z"))

    def quest_discovery_candidates(self, discovery):
        nearby = discovery.get("nearby", [])
        actions = world = None
        if isinstance(nearby, list) and any(isinstance(g, dict) and g.get("canInteract") is not True and
                g.get("blockedReason") in ("character_motion_or_cast_unconfirmed", "questgiver_outside_conservative_range") for g in nearby):
            actions = self.rpc.call("buddy-actions.status", {})
            world = self.rpc.call("buddy-world.snapshot", {})
        return self.quest_candidates(nearby, actions, world, self.character_guid)

    def quest_offer(self):
        discovery = self.rpc.call("buddy-quests.discover", {})
        bound = self.bound(discovery)
        candidates = self.quest_discovery_candidates(discovery)
        if not candidates:
            return None
        _, _, guid = min(candidates)
        result = self.rpc.call("buddy-quests.offer", {"sessionId": bound["sessionId"], "npcGuid": str(guid)})
        self.quests = result.get("state", {})
        if result.get("serverResponseReceived") is not True or not isinstance(self.quests, dict):
            return None
        offer = self.quests.get("offer", {})
        if not isinstance(offer, dict) or integer(offer.get("npcGuid", "0")) != guid:
            return None
        entries = offer.get("quests", [])
        if not isinstance(entries, list) or len(entries) > 32:
            raise ConversationError("Quest offer is invalid")
        available = [q for q in entries if isinstance(q, dict) and q.get("available") is True
                     and q.get("acceptRequested", False) is not True and integer(q.get("questId", "0")) > 0]
        return offer, available

    def execute_quest(self, action, quest_id):
        if not self.quests_available:
            return "Quest pickup isn't ready yet."
        result = self.quest_offer()
        if not result:
            return "I couldn't read a quest offer from a nearby questgiver yet."
        if action == "ACCEPT_QUEST" and quest_id and self.quest_in_own_log(self.quests, quest_id):
            offered = result[0].get("quests", [])
            quest = next((q for q in offered if isinstance(q, dict) and integer(q.get("questId", 0)) == quest_id), {"questId": quest_id})
            return self.quest_log_confirmation(quest)
        if not result[1]:
            return "This NPC isn't offering me a quest I can accept right now."
        offer, available = result
        if action == "DISCOVER_QUESTS" or (quest_id == 0 and len(available) != 1):
            choices = [f"{self.label(q.get('title'), 'Quest', 45)} ({integer(q['questId'])})" for q in available[:3]]
            return "Available here: " + "; ".join(choices) + (". Which should I take?" if action == "ACCEPT_QUEST" else ".")
        selected = [q for q in available if integer(q["questId"]) == quest_id] if quest_id else available
        if len(selected) != 1:
            return "That quest isn't in the current offer. Ask me to check the available quests."
        quest = selected[0]
        session = self.bound(self.quests)["sessionId"]
        if self.quest_in_own_log(self.quests, integer(quest["questId"]), session):
            return self.quest_log_confirmation(quest)
        if integer(quest.get("flags", 0)) & 0x80000:  # QUEST_FLAGS_AUTO_ACCEPT; 0x8 is SHARABLE.
            deadline = time.monotonic() + .75
            for attempt in range(3):
                try:
                    fresh = self.read_quest_state(min(.2, max(.001, deadline-time.monotonic())))
                except ConversationError:
                    break
                if fresh.get("sessionId") != session:
                    break
                self.quests = fresh
                if self.quest_in_own_log(fresh, integer(quest["questId"]), session):
                    return self.quest_log_confirmation(quest)
                if attempt == 2 or time.monotonic() + .05 >= deadline:
                    break
                time.sleep(.05)
            return "That quest is accepted automatically; I'm waiting to see it in my quest log."
        try:
            result = self.rpc.call("buddy-quests.accept", {"sessionId": session,
                "offerRevision": str(integer(offer.get("revision", "0"))),
                "npcGuid": str(integer(offer.get("npcGuid", "0"))), "questId": integer(quest["questId"])})
        except ConversationError:
            try:
                fresh = self.read_quest_state(.2)
                if self.quest_in_own_log(fresh, integer(quest["questId"]), session):
                    self.quests = fresh
                    return self.quest_log_confirmation(quest)
            except ConversationError:
                pass
            raise
        self.quests = result.get("state", {})
        if self.quest_in_own_log(self.quests, integer(quest["questId"]), session):
            return self.quest_log_confirmation(quest)
        acceptance = self.quests.get("lastAcceptance", {}) if isinstance(self.quests, dict) else {}
        if (isinstance(acceptance, dict) and acceptance.get("status") in ("CONFIRMED_IN_LOG", 2)
                and integer(acceptance.get("questId", "0")) == integer(quest["questId"])):
            return "It's in my quest log: " + self.label(quest.get("title"), "quest " + str(quest["questId"]), 100) + "."
        if isinstance(acceptance, dict) and acceptance.get("status") in ("SERVER_REJECTED", 4):
            return "The server rejected that quest pickup."
        return "I requested the quest, but I haven't confirmed it in my quest log."

    def read_quest_state(self, timeout):
        if isinstance(self.rpc, RPC):
            return RPC.call(self.rpc, "buddy-quests.state", {}, timeout=timeout)
        return self.rpc.call("buddy-quests.state", {})

    @staticmethod
    def quest_in_own_log(state, quest_id, session=None):
        if (not isinstance(state, dict) or state.get("questLogKnown") is not True
                or not isinstance(state.get("sessionId"), str) or not 1 <= len(state["sessionId"]) <= 128
                or session is not None and state["sessionId"] != session):
            return False
        quests = state.get("questLog", [])
        return (isinstance(quests, list) and len(quests) <= 25 and any(isinstance(q, dict)
                and integer(q.get("questId", 0)) == quest_id for q in quests))

    def quest_log_confirmation(self, quest):
        return "It's in my quest log: " + self.label(quest.get("title"), "quest " + str(quest["questId"]), 100) + "."

    def claim_quest_offer(self, quest_id, item_entry=0):
        if self.ambiguous_quest_reward(self.quests, quest_id):
            return "That reward already has a server request or receipt; I won't repeat it while its result needs checking."
        offer = self.quests.get("turnInOffer", {})
        if (not isinstance(offer, dict) or integer(offer.get("questId", "0")) != quest_id
                or offer.get("source") != "reward_offer" or offer.get("canComplete") is not True
                or integer(offer.get("expiresInMs", "0")) == 0 or offer.get("rewardRequested") is True):
            return "I don't have a current completable reward offer for that quest."
        choices = offer.get("choices", [])
        if not isinstance(choices, list) or len(choices) > 6:
            raise ConversationError("Quest reward choices are invalid")
        if any(not isinstance(item, dict) or integer(item.get("itemId", "0")) == 0 for item in choices):
            raise ConversationError("Quest reward choice is invalid")
        if len(choices) > 1 and not item_entry and self.actions.get("classKnown") is True:
            actual_class = integer(self.actions.get("classId", "0"))
            if actual_class == CLASS_IDS[self.character_class]:
                preferred = QUEST_REWARD_PREFERENCES.get(quest_id, {}).get(actual_class)
                if sum(integer(item["itemId"]) == preferred for item in choices) == 1:
                    item_entry = preferred
        if len(choices) > 1 and not item_entry:
            selected, message = self.automatic_reward_choice(offer)
            if selected is None:
                return message
            item_entry = selected["itemId"]
            offer = self.quests["turnInOffer"]
            choices = offer["choices"]
        selected = [item for item in choices if integer(item["itemId"]) == item_entry] if item_entry else choices
        if item_entry and len(selected) != 1:
            return "That item isn't an unambiguous choice in the current reward offer."
        selected = selected[0] if selected else None
        request = {"sessionId":self.bound(self.quests)["sessionId"],
                   "offerRevision":str(integer(offer.get("revision", "0"))),
                   "npcGuid":str(integer(offer.get("npcGuid", "0"))), "questId":quest_id,
                   "choiceIndex":integer(selected.get("index", "0")) if selected else 0,
                   "expectedItemId":integer(selected["itemId"]) if selected else 0,
                   "noChoice":not choices}
        result = self.rpc.call("buddy-quests.claim_reward", request)
        self.quests = result.get("state", {})
        receipt = self.quests.get("lastReward", {}) if isinstance(self.quests, dict) else {}
        if (isinstance(receipt, dict) and integer(receipt.get("questId", "0")) == quest_id
                and receipt.get("status") in ("REWARD_CONFIRMED", 2)
                and receipt.get("serverRewardObserved") is True and receipt.get("logRemovalConfirmed") is True):
            return "Turn-in confirmed by the server and my quest log: " + self.label(offer.get("title"), "quest " + str(quest_id), 100) + "."
        if isinstance(receipt, dict) and receipt.get("status") in ("REWARD_REJECTED", 4):
            return "The server rejected that quest reward."
        return "I requested the quest reward, but haven't confirmed the turn-in in my quest log."

    @staticmethod
    def reward_binding(state):
        offer = state.get("turnInOffer", {})
        if not isinstance(offer, dict) or not isinstance(offer.get("choices", []), list):
            raise ConversationError("Invalid quest reward offer")
        choices = tuple((integer(row.get("index", 0)), integer(row.get("itemId", 0)),
                         integer(row.get("count", 0))) for row in offer.get("choices", []) if isinstance(row, dict))
        return (BuddyControls.bound(state)["sessionId"], integer(offer.get("questId", 0)),
                integer(offer.get("npcGuid", 0)), integer(offer.get("revision", 0)), choices)

    def automatic_reward_choice(self, offer):
        binding = self.reward_binding(self.quests)
        player = self.rpc.call("buddy-world.snapshot", {}).get("self", {})
        if (not isinstance(player, dict) or integer(player.get("guid", 0)) != self.character_guid
                or player.get("classKnown") is not True
                or integer(player.get("classId", 0)) != CLASS_IDS[self.character_class]):
            return None, "I'm waiting for my character details before choosing a reward."
        decision = {"status": "pending"}
        deadline = time.monotonic() + 1.8
        for attempt in range(3):
            try:
                response = self.rpc.call("buddy-trade.lookup_items", {"itemIds": [integer(row["itemId"]) for row in offer["choices"]]})
                self.bound(response)  # Require an actual lookup-module identity.
                decision = quest_rewards.select_reward(offer["choices"], response, integer(player["classId"]),
                    level=integer(player.get("level", 0)) if player.get("levelKnown") is True else None)
                self.reward_items = dict(reward_metadata_snapshot(response), questId=integer(offer["questId"]),
                                         offerRevision=str(integer(offer.get("revision", 0))))
            except (ConversationError, ValueError, TypeError):
                return None, "I'm waiting for the reward's item details."
            if decision["status"] != "pending" or attempt == 2 or time.monotonic() + .15 >= deadline:
                break
            time.sleep(.15)
        if decision["status"] != "selected":
            return None, "I'm waiting for complete reward item details before choosing."
        fresh = self.rpc.call("buddy-quests.state", {})
        current = fresh.get("turnInOffer", {})
        if (self.reward_binding(fresh) != binding or self.ambiguous_quest_reward(fresh, binding[1])
                or current.get("source") != "reward_offer" or current.get("canComplete") is not True
                or current.get("rewardRequested") is True or integer(current.get("expiresInMs", 0)) == 0):
            return None, "The reward offer changed while I checked it; I'll need its current offer."
        self.quests = fresh
        self.reward_items.update(selectionReason=decision["reason"], selectedItemId=decision["choice"]["itemId"])
        return decision["choice"], ""

    @staticmethod
    def ambiguous_quest_reward(state, quest_id):
        receipt = state.get("lastReward", {})
        return (isinstance(receipt, dict) and integer(receipt.get("questId", "0")) == quest_id
                and receipt.get("status", "REWARD_NONE") not in ("REWARD_NONE", 0, "REWARD_REJECTED", 4))

    def execute_turn_in(self, action, quest_id, item_entry, refresh_binding=None):
        if not self.quests_available:
            return "Quest turn-in isn't ready yet."
        if action == "CLAIM_QUEST_REWARD":
            self.quests = self.rpc.call("buddy-quests.state", {})
            if not quest_id:
                quest_id = integer(self.quests.get("turnInOffer", {}).get("questId", "0"))
            if self.ambiguous_quest_reward(self.quests, quest_id):
                return "That reward already has a server request or receipt; I won't repeat it while its result needs checking."
            offer = self.quests.get("turnInOffer", {})
            if (quest_id and isinstance(offer, dict) and integer(offer.get("questId", "0")) == quest_id
                    and offer.get("source") == "reward_offer" and offer.get("canComplete") is True
                    and offer.get("rewardRequested") is not True and integer(offer.get("expiresInMs", "0")) == 0
                    and integer(offer.get("npcGuid", "0")) > 0):
                return self.execute_turn_in("TURN_IN_QUEST", quest_id, item_entry,
                    refresh_binding=(self.bound(self.quests)["sessionId"], integer(offer["npcGuid"])))
            return self.claim_quest_offer(quest_id, item_entry)
        state = self.rpc.call("buddy-quests.discover", {})
        if state.get("questLogKnown") is not True:
            return "I haven't observed my quest log yet."
        entries = state.get("questLog", [])
        if not isinstance(entries, list) or len(entries) > 25:
            raise ConversationError("Own quest log is invalid")
        matches = [q for q in entries if isinstance(q, dict) and integer(q.get("questId", "0")) > 0
                   and (integer(q["questId"]) == quest_id if quest_id else q.get("complete") is True)]
        if len(matches) != 1:
            return "Tell me which active quest to turn in." if quest_id else "I need one unambiguous completed quest from my own log."
        quest_id = integer(matches[0]["questId"])
        if self.ambiguous_quest_reward(state, quest_id):
            return "That reward already has a server request or receipt; I won't repeat it while its result needs checking."
        if refresh_binding and (self.bound(state)["sessionId"] != refresh_binding[0]
                or matches[0].get("complete") is not True or matches[0].get("failed") is True):
            return "I couldn't confirm the same completed quest after its reward offer expired."
        candidates = self.quest_discovery_candidates(state)
        if refresh_binding:
            candidates = [row for row in candidates if row[2] == refresh_binding[1]]
        if not candidates:
            return "I need to be beside an observed questgiver to turn that in."
        known_reward_givers = {integer(q.get("observedRewardNpcGuid", "0")) for q in self.journal.get("entries", []) if isinstance(q,dict) and integer(q.get("questId", "0")) == quest_id}
        best_priority = min(row[0] for row in candidates)
        reachable = [row for row in candidates if row[0] == best_priority]
        preferred = [row for row in reachable if row[2] in known_reward_givers]
        _, _, npc = min(preferred or reachable)
        result = self.rpc.call("buddy-quests.turn_in", {"sessionId":self.bound(state)["sessionId"],
                    "npcGuid":str(npc), "questId":quest_id,
                    "questLogRevision":str(integer(state.get("questLogRevision", "0")))})
        self.quests = result.get("state", {})
        offer = self.quests.get("turnInOffer", {}) if isinstance(self.quests, dict) else {}
        if (not isinstance(offer,dict) or integer(offer.get("questId", "0")) != quest_id
                or integer(offer.get("npcGuid", "0")) != npc):
            return "I requested the turn-in dialogue, but haven't received its matching offer."
        if offer.get("canComplete") is not True:
            return "The questgiver says I haven't met the turn-in requirements yet."
        return self.claim_quest_offer(quest_id, item_entry)

    def execute_trade(self, action, item_entry, gold_copper):
        if not self.trade_available:
            return "Trading isn't ready yet."
        state = self.rpc.call("buddy-trade.state", {})
        bound = self.bound(state)
        if action == "OPEN_TRADE":
            self.trade = self.rpc.call("buddy-trade.open", bound)
            return "I've requested a trade with you. Check your trade window."
        if action == "CANCEL_TRADE":
            self.trade = self.rpc.call("buddy-trade.cancel", bound)
            return "I've requested that our trade be canceled."
        if state.get("phase") != "OPEN":
            return "Let's open our trade window first."
        if action == "OFFER_TRADE_GOLD":
            if gold_copper == 0:
                return "Tell me the exact amount of gold, silver or copper to offer."
            self.trade = self.rpc.call("buddy-trade.offer_gold", dict(bound, copper=gold_copper))
            return f"I've requested an offer of {gold_copper} copper. Check the amount in your trade window."
        if item_entry == 0 or state.get("backpackKnown") is not True:
            return "I need an identified item in my backpack before I can offer it."
        backpack = state.get("backpack", [])
        requested = state.get("ownRequestedItems", [])
        if not isinstance(backpack, list) or len(backpack) > 16 or not isinstance(requested, list) or len(requested) > 6:
            raise ConversationError("Trade inventory is invalid")
        matches = [item for item in backpack if isinstance(item, dict) and item.get("metadataKnown") is True
                   and integer(item.get("entry", "0")) == item_entry and integer(item.get("count", "0")) > 0]
        if len(matches) != 1:
            return "I couldn't identify one unambiguous backpack stack to offer."
        item = matches[0]
        if any(isinstance(old, dict) and old.get("itemGuid") == item.get("itemGuid") for old in requested):
            return "I've already requested that stack in this trade. Check your trade window."
        used = {integer(old.get("slot", "0")) for old in requested if isinstance(old, dict)}
        slot = next((i for i in range(6) if i not in used), None)
        if slot is None:
            return "My six trade item slots are full."
        self.trade = self.rpc.call("buddy-trade.offer_item", dict(bound,
            backpackRevision=str(integer(state.get("backpackRevision", "0"))),
            backpackSlot=integer(item.get("slot", "0")), expectedItemGuid=str(integer(item.get("itemGuid", "0"))), tradeSlot=slot))
        return f"I've requested the whole stack of {integer(item['count'])} {self.label(item.get('name'), 'item ' + str(item_entry), 75)}. Check your trade window."

    def execute(self, action, quest_id=0, item_entry=0, gold_copper=0):
        if action == "NONE":
            return None
        if action == "STOP_QUEST":
            result = quest_task_snapshot(self.character_guid, getattr(self.rpc, "url", None), quest_id, stop=True)
            return ("I've requested that my quest task stop and release its own controls."
                    if result.get("stopRequested") is True else "I don't have a matching active quest task to stop.")
        if action == "EXECUTE_QUEST":
            active = quest_task_snapshot(self.character_guid, getattr(self.rpc, "url", None))
            if active.get("active") is True:
                return "My quest task is already running; its current progress is in my own quest log."
            if not self.actions_available:
                return "My movement controller isn't ready yet."
            try:
                state = self.rpc.call("buddy-quest-items.state", {})
                supported = integer(state.get("questId", 0))
                session = state.get("sessionId")
                if (integer(state.get("selfGuid", 0)) != self.character_guid or not isinstance(session, str)
                        or not 1 <= len(session) <= 128 or not 0 < supported < 2**32):
                    raise ConversationError("Quest executor identity is unconfirmed")
                if quest_id and quest_id != supported:
                    return "I can discuss that quest, but I don't have an installed objective recipe for it yet."
                if state.get("questLogKnown") is not True or state.get("questActive") is not True:
                    return "I haven't confirmed that quest in my own active quest log."
                if state.get("questComplete") is True:
                    return "My own quest log already marks that quest complete."
                url = getattr(self.rpc, "url", "")
                quest_task_identity(self.character_guid, url, supported)
                area_quest_snapshot(self.character_guid, stop=True)
                folder = ensure_state(ensure_state(ROOT / "data/quest-task") / str(self.character_guid))
                descriptor = private_open(folder / "live.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND)
                with os.fdopen(descriptor, "ab", buffering=0) as log:
                    subprocess.Popen([sys.executable, "-B", str(ROOT / "dev/quest-task"), "run",
                                      "--character-guid", str(self.character_guid), "--rpc-url", url,
                                      "--quest-id", str(supported), "--session-id", session], cwd=ROOT,
                                     stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
            except (OSError, ValueError, ConversationError):
                return "I couldn't start the installed quest executor. I'll keep its progress unconfirmed."
            return "I'm starting that quest's objective steps, for up to five minutes. I'll track my own confirmed quest credit."
        if action == "STOP_AREA_QUESTS":
            result = area_quest_snapshot(self.character_guid, stop=True)
            return "I've requested that my area quest sweep stop and restore my prior follow setting." if result.get("stopRequested") is True else "I don't have an active area quest sweep to stop."
        if action == "AREA_QUESTS":
            quest_task_snapshot(self.character_guid, getattr(self.rpc, "url", None), stop=True)
            if not self.actions_available or not self.quests_available:
                return "Quest travel isn't ready yet."
            if area_quest_snapshot(self.character_guid).get("active") is True:
                return "My area quest sweep is already running."
            try:
                identity = area_quest_identity(self.character_guid)
                if getattr(self.rpc, "url", "") != f"http://127.0.0.1:{identity['port']}/rpc":
                    return "My area quest profile doesn't match this character connection."
                player = self.rpc.call("buddy-world.snapshot", {}).get("self", {})
                if not isinstance(player, dict) or integer(player.get("guid", 0)) != self.character_guid:
                    return "I couldn't confirm my character before starting the area quest sweep."
                root = ensure_state(ROOT / "data/area-quests")
                folder = ensure_state(root / str(self.character_guid))
                descriptor = private_open(folder / "live.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND)
                with os.fdopen(descriptor, "ab", buffering=0) as log:
                    subprocess.Popen([sys.executable, "-B", str(ROOT / "dev/area-quests"), "run",
                                      "--character-guid", str(self.character_guid)], cwd=ROOT,
                                     stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
            except (OSError, ConversationError):
                return "I couldn't start my area quest sweep."
            return "I'm starting a nearby quest sweep: turn-ins, rewards and available quests, for up to five minutes."
        if action == "STOP_QUEST_SYNC":
            initial = quest_sync_snapshot(self.character_guid, stop=True)
            standing = party_quest_sync_snapshot(self.character_guid, stop=True)
            return ("I've requested that our quest-sync routine stop; cleanup may take a moment."
                    if initial.get("stopRequested") is True or standing.get("stopRequested") is True
                    else "I don't see an active matching quest-sync routine to stop.")
        if action in ("FOLLOW", "STOP_FOLLOWING"):
            party_town_snapshot(self.character_guid, revoke_follow=True)
            area_quest_snapshot(self.character_guid, stop=True, restore_follow=False)
            quest_task_snapshot(self.character_guid, getattr(self.rpc, "url", None), stop=True, restore_follow=False)
        try:
            if action == "PLAN_QUEST":
                entries = self.journal.get("entries", []) if self.journal_available else []
                matches = [q for q in entries if isinstance(q,dict) and integer(q.get("questId", "0")) == quest_id and q.get("templateKnown") is True]
                return None if len(matches) == 1 else "I haven't received that active quest's objectives yet."
            if action in ("TURN_IN_QUEST", "CLAIM_QUEST_REWARD"):
                return self.execute_turn_in(action, quest_id, item_entry)
            if action in ("DISCOVER_QUESTS", "ACCEPT_QUEST"):
                return self.execute_quest(action, quest_id)
            if action in ("ENABLE_LOOTING", "DISABLE_LOOTING"):
                if not self.loot_available:
                    return "Automatic looting isn't ready yet."
                enabled = action == "ENABLE_LOOTING"
                party_town_snapshot(self.character_guid, revoke_control="loot")
                self.loot = self.rpc.call("buddy-loot.enable", {"enabled": enabled})
                if enabled and self.loot.get("enabled") is not True:
                    return "I couldn't enable automatic looting yet."
                if not enabled and self.loot.get("enabled", False) is not False:
                    return "I couldn't confirm automatic looting is off yet."
                return "I'll loot nearby ordinary corpses when it's safe." if enabled else "Automatic looting is off."
            if action in ("OPEN_TRADE", "OFFER_TRADE_ITEM", "OFFER_TRADE_GOLD", "CANCEL_TRADE"):
                return self.execute_trade(action, item_entry, gold_copper)
        except ConversationError:
            return "I couldn't confirm that request. I won't retry it automatically."
        if not self.actions_available:
            return "That ability isn't ready yet."
        if action in ("ENABLE_HEALING", "HEAL_ONCE") and self.character_class != "priest":
            return "I don't have a healing ability available."
        commands = {
            "FOLLOW": ("buddy-actions.follow", {"enabled": True}, "I'll follow you across nearby open ground."),
            "STOP_FOLLOWING": ("buddy-actions.follow", {"enabled": False}, "I've turned following off."),
            "ENABLE_HEALING": ("buddy-actions.healing", {"enabled": True}, "I'll watch your health and try Lesser Heal when you need it."),
            "DISABLE_HEALING": ("buddy-actions.healing", {"enabled": False}, "Automatic healing is off."),
            "HEAL_ONCE": ("buddy-actions.heal_once", {}, "I'm trying Lesser Heal now."),
            "ENABLE_ASSIST": ("buddy-actions.assist", {"enabled": True}, "I'll assist your observed combat target when it's safe."),
            "DISABLE_ASSIST": ("buddy-actions.assist", {"enabled": False}, "Combat assistance is off."),
        }
        method, params, acknowledgement = commands[action]
        if action in ("ENABLE_HEALING", "DISABLE_HEALING", "ENABLE_ASSIST", "DISABLE_ASSIST"):
            party_town_snapshot(self.character_guid, revoke_control="healing" if "HEALING" in action else "assist")
        try:
            self.actions = self.rpc.call(method, params)
        except ConversationError:
            # Never retry a control after an ambiguous transport result.
            return "I couldn't confirm that request. Try again in a moment."
        if self.actions.get("motionUnconfirmed") is True:
            return "I couldn't confirm a movement stop. Tell me to stop following before we try moving or casting again."
        if action == "DISABLE_ASSIST" and (self.actions.get("autoAttackUnconfirmed") is True or self.actions.get("autoAttacking") is True):
            return "I've disabled new combat assistance and am waiting for the server to confirm the attack stop."
        if action == "FOLLOW" and self.actions.get("following") is not True:
            return "I couldn't enable following yet. Stay nearby and try again."
        if action == "ENABLE_HEALING" and self.actions.get("healing") is not True:
            return "I couldn't enable automatic healing yet."
        if action == "ENABLE_ASSIST" and self.actions.get("assisting") is not True:
            return "I couldn't enable combat assistance yet."
        if action == "HEAL_ONCE":
            reason = self.actions.get("reason", "")
            if reason == "heal_transport_written_waiting_for_server":
                return "I'm trying Lesser Heal now."
            if reason == "server_cast_started":
                return "I'm casting Lesser Heal."
            blocked = {
                "heal_throttled_or_pending": "Give me a moment; I'm casting or recovering.",
                "lesser_heal_not_in_known_spells": "Lesser Heal isn't available to me yet.",
                "target_not_injured_or_health_unknown": "I don't have an injured target I can heal yet.",
                "mana_unknown_or_insufficient": "I can't confirm enough mana to cast yet.",
                "heal_outside_conservative_range": "Come a little closer for Lesser Heal.",
                "movement_stop_unconfirmed_heal_aborted": "I couldn't confirm I'd stopped moving, so I held the heal.",
                "caster_silenced": "I'm silenced; I can't cast right now.",
            }
            return blocked.get(reason, "I couldn't start Lesser Heal yet.")
        return acknowledgement


class Conversation:
    def __init__(self, rpc, brain, player_guid=3, status=lambda **kw: None, stopped=lambda: False, player_name="Joel", controls=None, banter_seconds=0, character_name="Arlen", character_class="priest", character_guid=1, party_agents=None):
        self.rpc, self.brain, self.player_guid, self.status = rpc, brain, player_guid, status
        self.cursor = 0
        self.session_id = ""
        self.player_name = player_name
        self.character_name, self.character_class, self.character_guid = character_name, character_class, character_guid
        self.party_agents = dict(party_agents or {})
        self.peer_remaining, self.peer_until, self.next_peer = 0, 0, 0
        self.controls = controls
        self.banter_seconds = banter_seconds
        self.last_activity = time.monotonic()
        self.next_banter = self.last_activity + banter_seconds
        self.next_banter_check = self.next_banter
        self.history = {"SAY": [], "PARTY": [], "WHISPER": []}
        self.replies = 0
        self.initialized = False
        self.stopped = stopped

    def baseline(self):
        result = self.rpc.call("buddy-chat.poll", {"afterSequence": "0", "limit": 256})
        self.cursor = integer(result.get("latestSequence", "0"))
        self.session_id = result.get("sessionId", "")
        if not isinstance(self.session_id, str) or len(self.session_id) > 128:
            raise ConversationError("Chat module session identifier is invalid")
        self.initialized = True
        self.status(phase="listening", cursor=self.cursor)

    def reset_body(self):
        self.initialized = False
        self.session_id = ""
        self.peer_remaining = 0
        self.history = {"SAY": [], "PARTY": [], "WHISPER": []}
        if self.controls:
            self.controls.events.clear()
        self.status(phase="reconnecting", event="body_restarted")

    def same_body(self):
        if not self.session_id:
            return True
        try:
            result = self.rpc.call("buddy-chat.poll", {"afterSequence": str(self.cursor),
                                                       "limit": 1, "sessionId": self.session_id})
        except CursorReset:
            self.reset_body()
            return False
        if result.get("sessionId") != self.session_id:
            self.reset_body()
            return False
        return True

    def tick(self):
        if self.controls:
            self.controls.refresh()
        if not self.initialized:
            self.baseline()
            return
        try:
            params = {"afterSequence": str(self.cursor), "limit": 256}
            if self.session_id:
                params["sessionId"] = self.session_id
            result = self.rpc.call("buddy-chat.poll", params)
        except CursorReset:
            # Session-local sequence numbers are not durable. Tail the replacement
            # ring rather than interpreting stale history as new player input.
            self.reset_body()
            return
        latest = integer(result.get("latestSequence", "0"))
        next_sequence = integer(result.get("nextSequence", str(self.cursor)))
        if latest < self.cursor or next_sequence < self.cursor or next_sequence > latest:
            raise ConversationError("Chat poll cursor is inconsistent")
        messages = result.get("messages", [])
        if not isinstance(messages, list) or len(messages) > 256:
            raise ConversationError("Chat poll messages are invalid")
        selected = []
        previous = self.cursor
        for message in messages:
            if not isinstance(message, dict):
                raise ConversationError("Chat poll message is invalid")
            sequence = integer(message.get("sequence", "0"), "sequence")
            if not previous < sequence <= next_sequence:
                raise ConversationError("Chat poll sequences are not increasing")
            previous = sequence
            if message.get("self", False) is not False:
                continue
            sender = integer(message.get("senderGuid", "0"), "sender GUID")
            if sender == self.character_guid:
                continue
            channel = message.get("channel")
            if channel not in ("SAY", "PARTY", "PARTY_LEADER", "WHISPER"):
                continue
            try:
                text = plain_text(message.get("text"))
            except ConversationError:
                continue
            if sender == self.player_guid:
                # Joel can address one character, several named characters, or
                # the whole party. Other characters consume the cursor quietly.
                if channel in ("PARTY", "PARTY_LEADER"):
                    self.peer_remaining, self.peer_until = 2, time.monotonic() + 120
                addressed = addressed_names(text, [self.character_name, *self.party_agents.values()])
                if addressed and self.character_name.casefold() not in addressed:
                    continue
                selected.append({"speaker": self.player_name, "channel": channel, "text": text, "sender_guid": str(sender)})
            elif (sender in self.party_agents and channel in ("PARTY", "PARTY_LEADER")
                  and named(text, self.character_name) and self.peer_remaining > 0
                  and time.monotonic() < self.peer_until and time.monotonic() >= self.next_peer
                  and self.peer_member(sender)):
                selected.append({"speaker": self.party_agents[sender], "channel": channel, "text": text, "sender_guid": str(sender)})
        # Advance before model/RPC work: ambiguous writes must not cause retries.
        self.cursor = next_sequence
        if not selected:
            self.status(phase="listening", cursor=self.cursor)
            self.maybe_initiate()
            return
        if result.get("cursorLost", False):
            selected = selected[-1:]
            self.status(event="ring_overflow", cursor=self.cursor)
        # One response to a burst; do not cross channels or leak party context.
        def reply_channel(entry):
            return "PARTY" if entry["channel"] in ("PARTY", "PARTY_LEADER") else entry["channel"]
        owners = [entry for entry in selected if integer(entry["sender_guid"]) == self.player_guid]
        if owners:
            selected = owners
        peer = integer(selected[-1]["sender_guid"]) != self.player_guid
        sender = integer(selected[-1]["sender_guid"])
        if peer:
            selected = selected[-1:]
            self.peer_remaining -= 1
            self.next_peer = time.monotonic() + 30
        channel = reply_channel(selected[-1])
        selected = [entry for entry in selected[-8:] if reply_channel(entry) == channel]
        self.history[channel].extend(selected)
        self.history[channel] = self.history[channel][-20:]
        self.last_activity = time.monotonic()
        self.next_banter = self.last_activity + self.banter_seconds
        self.status(phase="thinking", cursor=self.cursor)
        state = self.controls.context() if self.controls else {}
        state = dict(state, character={"name":self.character_name,"class":self.character_class,"guid":str(self.character_guid)}, party_agents=[{"name":name,"guid":str(guid)} for guid,name in self.party_agents.items()], current_request={"source":"party_agent" if peer else "owner","controls_allowed":not peer})
        reply = validate_reply(self.brain.generate(self.history[channel], state))
        if self.stopped():
            raise Stopped("Conversation stop requested")
        # Generation may outlive a body reconnect. Drop all old-context writes,
        # including controller actions, before reaching a replacement session.
        if not self.same_body():
            return
        if peer and not self.peer_member(sender, fresh=True):
            return
        if self.controls and not peer:
            arguments = {key: reply[key] for key in NUMERIC_ARGS if key in reply}
            acknowledgement = self.controls.execute(reply["action"], **arguments)
            if acknowledgement:
                reply["text"] = acknowledgement
        if peer:
            reply["action"] = "NONE"
        self.send_reply(reply, channel, target_guid=sender)
        if self.controls:
            self.controls.events.clear()

    def peer_member(self, sender, fresh=False):
        if not self.controls:
            return False
        try:
            party = self.rpc.call("buddy-party.state", {}) if fresh else getattr(self.controls,"party",{})
            group = party.get("group", {})
            members = group.get("members", [])
            if group.get("known") is not True or group.get("inGroup") is not True or not isinstance(members,list) or len(members)>40:
                return False
            expected = {self.player_guid:self.player_name,self.character_guid:self.character_name,sender:self.party_agents[sender]}
            observed = {integer(m.get("guid","0")):m for m in members if isinstance(m,dict)}
            return all(guid in observed and observed[guid].get("online") is True and isinstance(observed[guid].get("name"),str) and observed[guid]["name"].casefold()==name.casefold() for guid,name in expected.items())
        except (ConversationError,KeyError,TypeError):
            return False

    def send_reply(self, reply, channel, target_guid=None):
        params = {"channel": channel, "language": "COMMON", "text": reply["text"]}
        if channel == "WHISPER":
            params["recipient"] = self.player_name
        result = self.rpc.call("buddy-chat.send", params)
        if result.get("transportWritten") is not True:
            raise ConversationError("Chat transport did not acknowledge the write")
        self.replies += 1
        self.history[channel].append({"speaker": self.character_name, "channel": channel, "text": reply["text"]})
        self.history[channel] = self.history[channel][-20:]
        self.status(phase="listening", replies=self.replies, cursor=self.cursor)
        if reply["emote"] != "NONE":
            result = self.rpc.call("buddy-chat.emote", {"emote": reply["emote"], "targetGuid": str(target_guid or self.player_guid)})
            if result.get("transportWritten") is not True:
                raise ConversationError("Emote transport did not acknowledge the write")

    def maybe_initiate(self):
        now = time.monotonic()
        if (not self.controls or not self.banter_seconds or now < self.next_banter
                or now < self.next_banter_check or now - self.last_activity < 60):
            return
        # Checking presence uses cheap game RPCs, never a model call at every poll.
        self.next_banter_check = now + 15
        state = self.controls.context()
        owner = state.get("observations", {}).get("owner", {})
        # AFK/DND are explicit server-observed preferences; replies to a new
        # message still work, but initiated banter waits until Joel returns.
        if integer(owner.get("playerFlags", 0), "player flags") & 0x6:
            return
        nearby = owner.get("present") is True and not (owner.get("aliveKnown") is True and owner.get("alive") is not True)
        group = state.get("party", {})
        members = group.get("members", []) if isinstance(group, dict) else []
        in_party = group.get("known") is True and group.get("inGroup") is True
        online_in_party = in_party and any(isinstance(member, dict) and member.get("online") is True
                                          and integer(member.get("guid", "0")) == self.player_guid for member in members)
        if not nearby and not online_in_party:
            return
        if owner.get("aliveKnown") is True and owner.get("alive") is not True:
            return
        # Reserve the interval before generation/write, including ambiguous errors.
        self.next_banter = now + self.banter_seconds
        channel = "PARTY" if online_in_party else "WHISPER"
        cue = {"speaker": "Conversation cue", "channel": channel,
               "text": "Joel asked for occasional natural conversation. Initiate one brief thought or question as his friend. Use actual own quest journal objectives and progress when available, or other supplied observations/events; otherwise choose a casual topic. Never invent quests, enemies, scenery or successful actions. Set action NONE. Avoid repetitive check-ins or offers of help."}
        state = dict(state, character={"name": self.character_name, "class": self.character_class,
                                       "guid": str(self.character_guid)},
                     party_agents=[{"name": name, "guid": str(guid)} for guid, name in self.party_agents.items()],
                     current_request={"source": "initiative", "controls_allowed": False})
        self.status(phase="thinking", event="occasional_conversation", cursor=self.cursor)
        reply = validate_reply(self.brain.generate(self.history[channel][-19:] + [cue], state))
        if self.stopped():
            raise Stopped("Conversation stop requested")
        if not self.same_body():
            return
        # An initiated conversation can never enable movement or casting.
        reply["action"] = "NONE"
        self.send_reply(reply, channel)
        self.controls.events.clear()


def ensure_state(path):
    path = Path(path).absolute()
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    if path.is_symlink() or not path.is_dir() or path.stat().st_uid != os.getuid():
        raise ConversationError("State directory must be a real directory owned by the current user")
    path.chmod(0o700)
    return path


def private_open(path, flags):
    descriptor = os.open(path, flags | os.O_NOFOLLOW, 0o600)
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
        os.close(descriptor)
        raise ConversationError("Runtime file must be a private regular file")
    os.fchmod(descriptor, 0o600)
    return descriptor


def write_json(path, value):
    descriptor, temporary = tempfile.mkstemp(prefix=".state-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as target:
            json.dump(value, target)
            target.write("\n")
        if path.is_symlink():
            raise ConversationError("Runtime file cannot be a symlink")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_json(path):
    try:
        with os.fdopen(private_open(path, os.O_RDONLY), "r") as source:
            raw = source.read(8193)
        if len(raw) > 8192:
            raise ConversationError("Runtime status exceeds the size limit")
        value = json.loads(raw)
        if not isinstance(value, dict):
            raise ValueError
        return value
    except FileNotFoundError:
        return {}
    except ValueError:
        raise ConversationError("Runtime status is invalid") from None


def is_locked(lock):
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    fcntl.flock(lock, fcntl.LOCK_UN)
    return False


def conversation_profile(args):
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", args.profile):
        raise ConversationError("Profile must be a short lowercase slug")
    if args.profile != "default" and (not args.character_name or not args.character_class or not args.character_guid):
        raise ConversationError("Named profiles require character name, class, and GUID")
    args.character_name = character_name(args.character_name or "Arlen")
    args.character_class = args.character_class or "priest"
    args.character_guid = args.character_guid or 1
    args.player_name = character_name(args.player_name)
    if (not 0 < args.character_guid < 2**48 or args.character_guid == args.player_guid
            or args.character_class not in CLASS_IDS):
        raise ConversationError("Character identity is invalid")
    roster = parse_roster(args.party_agent, args.character_guid, args.character_name, args.player_guid)
    path = args.state_dir or (ROOT / "data/converse" if args.profile == "default" else ROOT / "data/converse" / args.profile)
    RPC(args.rpc_url) # Validate the endpoint for run, status, and stop alike.
    identity = {"profile":args.profile,"name":args.character_name,"class":args.character_class,
                "guid":args.character_guid,"owner_guid":args.player_guid,"rpc_url":args.rpc_url}
    return path, identity, roster


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=("run", "status", "stop"))
    parser.add_argument("--state-dir", type=Path)
    parser.add_argument("--profile", default="default")
    parser.add_argument("--character-name")
    parser.add_argument("--character-class", choices=tuple(CLASS_IDS))
    parser.add_argument("--character-guid", type=int)
    parser.add_argument("--party-agent", action="append", default=[], metavar="NAME:GUID")
    parser.add_argument("--player-name", default="Joel")
    parser.add_argument("--owner-quest-context", type=Path,
                        help="Private JSON human-reported quest snapshot; never live server evidence")
    parser.add_argument("--rpc-url", default="http://127.0.0.1:8086/rpc")
    parser.add_argument("--player-guid", type=int, default=3)
    parser.add_argument("--codex", default=DEFAULT_CODEX)
    parser.add_argument("--poll-seconds", type=float, default=1)
    parser.add_argument("--reply-timeout", type=float, default=120)
    parser.add_argument("--max-replies", type=int, default=200)
    parser.add_argument("--max-hours", type=float, default=8)
    parser.add_argument("--banter-seconds", type=float, default=180,
                        help="Minimum gap for occasional initiated conversation; 0 disables it (default 180)")
    args = parser.parse_args(argv)
    if (not 0.2 <= args.poll_seconds <= 10 or not 5 <= args.reply_timeout <= 180
            or not 1 <= args.max_replies <= 1000 or not 0 < args.max_hours <= 24
            or not 0 < args.player_guid < 2**48
            or (args.banter_seconds != 0 and not 120 <= args.banter_seconds <= 3600)):
        parser.error("Conversation limits are outside the supported range")
    state_path, identity, roster = conversation_profile(args)
    state = ensure_state(state_path)
    with os.fdopen(private_open(state / "lock", os.O_RDWR | os.O_CREAT), "r+") as lock:
        if args.command != "run":
            running = is_locked(lock)
            record = read_json(state / "status.json")
            if running and record.get("character_identity") is not None and record["character_identity"] != identity:
                raise ConversationError("This state directory tracks another character; no stop requested")
            if running and record.get("character_identity") is None and args.profile != "default":
                raise ConversationError("Legacy conversation has no matching named profile; no stop requested")
            if args.command == "stop":
                if running and record.get("instance"):
                    write_json(state / "stop.json", {"instance": record["instance"]})
                    print("Conversation stop requested; the game character remains online.")
                else:
                    print("Conversation is not running.")
            else:
                record["running"] = running
                print(json.dumps(record, indent=2))
            return 0
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ConversationError("Conversation is already running in this state directory") from None
        record = {"instance": uuid.uuid4().hex, "pid": os.getpid(), "phase": "starting",
                  "started": time.time(), "replies": 0, "cursor": 0, "character_identity":identity}
        local_stop = False
        def request_stop(signum, frame):
            nonlocal local_stop
            local_stop = True
        signal.signal(signal.SIGINT, request_stop)
        signal.signal(signal.SIGTERM, request_stop)
        def stopped():
            return local_stop or read_json(state / "stop.json").get("instance") == record["instance"]
        def status(**fields):
            record.update(fields, updated=time.time())
            if fields.get("phase") in ("listening", "thinking"):
                record.pop("error", None)
            write_json(state / "status.json", record)
        rpc = RPC(args.rpc_url)
        brain = CodexBrain(args.codex, state, args.reply_timeout, stopped, args.character_name, args.character_class)
        controls = BuddyControls(rpc, args.player_name, args.character_class, args.owner_quest_context, args.character_guid)
        conversation = Conversation(rpc, brain, args.player_guid, status, stopped,
                                    controls=controls, banter_seconds=args.banter_seconds, player_name=args.player_name, character_name=args.character_name, character_class=args.character_class, character_guid=args.character_guid, party_agents=roster)
        deadline = time.monotonic() + args.max_hours * 3600
        status()
        print(f"{args.character_name} ({args.character_class}) is listening for {args.player_name} and addressed roster party messages.", flush=True)
        print(f"Occasional conversation interval: {args.banter_seconds:g}s (0 disables). Stop with dev/converse stop.", flush=True)
        try:
            while not stopped() and time.monotonic() < deadline and conversation.replies < args.max_replies:
                try:
                    conversation.tick()
                except Stopped:
                    break
                except ConversationError as error:
                    status(phase="error", error=str(error))
                    print(str(error), file=sys.stderr, flush=True)
                    # No automatic reply retries. Resume cheap polls after backoff.
                    until = time.monotonic() + 5
                    while time.monotonic() < until and not stopped():
                        time.sleep(0.1)
                until = time.monotonic() + args.poll_seconds
                while time.monotonic() < until and not stopped():
                    time.sleep(0.1)
        finally:
            status(phase="stopped")
        return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ConversationError, OSError) as error:
        print(f"Conversation: {error}", file=sys.stderr)
        sys.exit(1)
