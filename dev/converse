def area_quest_snapshot(character_guid, stop=False, restore_follow=True):
    unknown = {"active": False}
    try:
        identity = area_quest_identity(character_guid)
        folder = ROOT / "data/area-quests" / str(character_guid)
        if any(path.is_symlink() or path.stat().st_uid != os.getuid() or path.stat().st_mode & 0o077
               for path in (folder.parent, folder)):
            return unknown
        def read(path):
            descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(descriptor, "r") as source:
                info = os.fstat(source.fileno())
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                        or info.st_nlink != 1 or info.st_mode & 0o077 or info.st_size > 8192):
                    raise ConversationError("Area quest state is unavailable")
                return json.loads(source.read(8193))
        record = read(folder / "status.json")
        if (not isinstance(record, dict) or record.get("identity") != identity
                or not isinstance(record.get("instance"), str) or not re.fullmatch(r"[0-9a-f]{32}", record["instance"])):
            return unknown
        descriptor = os.open(folder / "lock", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "r") as lock:
            info = os.fstat(lock.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1 or info.st_mode & 0o077:
                return unknown
            active = record.get("routineActive") is True and is_locked(lock)
        own, clean = record.get("own", {}), {}
        if not isinstance(own, dict):
            return unknown
        for key in ("phase", "cleanup"):
            value = own.get(key)
            if isinstance(value, str) and re.fullmatch(r"[a-z0-9_]{1,96}", value):
                clean[key] = value
        for key in ("activeQuestIds", "acceptedQuestIds", "rewardedQuestIds"):
            values = own.get(key, [])
            if not isinstance(values, list) or len(values) > 25:
                return unknown
            clean[key] = [integer(value) for value in values]
            if any(not 0 < value < 2**31 for value in clean[key]):
                return unknown
        result = {"active": active, "phase": clean.get("phase", "starting"), "own": clean}
        if stop and active:
            request = {"identity": identity, "instance": record["instance"]}
            if not restore_follow:
                request["restoreFollowing"] = False
            write_json(folder / "stop.json", request)
            result["stopRequested"] = True
        return result
    except (OSError, ValueError, TypeError, ConversationError):
        return unknown


