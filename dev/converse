def party_maintenance_snapshot(character_guid):
    folder = ROOT / "data/party-maintenance"
    unknown = {"active": False}
    expected = {1: "Arlen", 4: "Mira", 5: "Rook"}
    def read(path, limit, with_size=False):
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as source:
            info = os.fstat(source.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1
                    or info.st_mode & 0o077 or info.st_size > limit):
                raise ConversationError("Maintenance evidence is not a private regular file")
            raw = source.read(limit + 1)
            if len(raw) > limit:
                raise ConversationError("Maintenance evidence exceeds its bound")
            value = json.loads(raw)
        if not isinstance(value, dict):
            raise ConversationError("Maintenance evidence is invalid")
        return (value,len(raw)) if with_size else value
    try:
        info = folder.lstat()
        if (character_guid not in expected or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != os.geteuid() or info.st_mode & 0o077):
            return unknown
        record = read(folder / "status.json", 8192)
        if (record.get("identity") != PARTY_MAINTENANCE_IDENTITY or record.get("phase") != "running"
                or not isinstance(record.get("instance"), str) or not re.fullmatch(r"[a-f0-9]{32}", record["instance"])):
            return unknown
        updated = record.get("updatedAt")
        if type(updated) not in (int, float) or not math.isfinite(updated) or not 0 <= updated <= time.time() + 5:
            return unknown
        rows = record.get("characters", [])
        if (not isinstance(rows, list) or len(rows) != 3 or any(not isinstance(row, dict)
                or type(row.get("guid")) is not int or row["guid"] not in expected
                or row.get("name") != expected[row["guid"]] for row in rows)
                or {row["guid"] for row in rows} != set(expected)):
            return unknown
        own = next(row for row in rows if row["guid"] == character_guid)
        phase = own.get("phase")
        if not isinstance(phase, str) or not re.fullmatch(r"[a-z0-9_]{1,96}", phase):
            return unknown
        # Keep the lock descriptor open while reading character evidence. It is
        # never modified, and no PID is inferred or signalled by this helper.
        descriptor = os.open(folder / "lock", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "r") as lock:
            info = os.fstat(lock.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1
                    or info.st_mode & 0o077 or not is_locked(lock)):
                return unknown
            summary = {"name": expected[character_guid], "guid": character_guid, "phase": phase,
                       "recordsKnown": False, "reservedCopper": None, "confirmedSpellIds": [], "stipendStatus": "unrecorded"}
            try:
                data, data_size = read(folder / ("character-" + str(character_guid) + ".json"), 262144, True)
            except FileNotFoundError:
                data, data_size = None, 0
            if data is not None:
                legacy = {"name": expected[character_guid], "guid": character_guid, "ownerGuid": 3, "budgetCopper": 10000}
                current = {"version": 2, "name": expected[character_guid], "guid": character_guid, "ownerGuid": 3}
                v2 = data.get("identity") == current
                if data.get("identity") not in (legacy, current) or not v2 and data_size > 65536:
                    return unknown
                if v2:
                    summary.update(spentCopper=None, knownAtTrainerSpellIds=[], historyComplete=False)
                def training_records():
                    reserved, training = data.get("reservedCopper"), data.get("training")
                    if (type(reserved) is not int or not 0 <= reserved <= (2**63-1 if v2 else 10000)
                            or not isinstance(training, list) or len(training) > (64 if v2 else 128)):
                        raise ConversationError("Maintenance training totals are invalid")
                    confirmed, known, cost, confirmed_cost = set(), set(), 0, 0
                    statuses = ("reserved", "confirmed", "rejected", "known_at_trainer") if v2 else ("reserved", "confirmed", "rejected")
                    for i,row in enumerate(training):
                        if (not isinstance(row, dict) or type(row.get("cost")) is not int
                                or not 0 <= row["cost"] <= (1000000 if v2 else 10000)
                                or row.get("status") not in statuses
                                or not 0 < integer(row.get("spell", 0)) <= 2**32-1
                                or v2 and row["status"] == "reserved" and i != len(training)-1):
                            raise ConversationError("Maintenance training history is invalid")
                        cost += row["cost"]
                        if row["status"] == "confirmed":
                            confirmed.add(integer(row["spell"]));confirmed_cost += row["cost"]
                        elif row["status"] == "known_at_trainer":known.add(integer(row["spell"]))
                    if cost > reserved or not v2 and cost != reserved:
                        raise ConversationError("Maintenance training history disagrees with its audit")
                    spent=data.get("spentCopper")
                    if v2 and (type(spent) is not int or not confirmed_cost <= spent <= reserved
                            or not isinstance(data.get("rejections"),dict) or len(data["rejections"])>256):
                        raise ConversationError("Maintenance lifetime audit is invalid")
                    mail = data.get("mail")
                    stipend = "not_requested"
                    if mail is not None:
                        if (not isinstance(mail, dict) or mail.get("status") not in ("reserved", "confirmed")
                                or not isinstance(mail.get("sessionId"), str) or not 1 <= len(mail["sessionId"]) <= 128
                                or not 0 < integer(mail.get("mailId", 0)) <= 2**32-1
                                or integer(mail.get("listRevision", 0)) == 0 or integer(mail.get("mailboxGuid", 0)) >> 48 != 0xf110):
                            raise ConversationError("Maintenance stipend record is invalid")
                        stipend = "confirmed" if mail["status"] == "confirmed" else "reserved_unconfirmed"
                    result=dict(recordsKnown=True, reservedCopper=reserved,
                        confirmedSpellIds=sorted(confirmed),stipendStatus=stipend)
                    if v2:result.update(spentCopper=spent,knownAtTrainerSpellIds=sorted(known),historyComplete=False)
                    return result
                try:summary.update(training_records())
                except (ConversationError,TypeError,ValueError):
                    # The private held lock still proves this routine is running.
                    # A v2 journal with unknown facts must not invent an idle actor.
                    if not v2:return unknown
            final = read(folder / "status.json", 8192)
            if (final.get("instance") != record["instance"] or final.get("phase") != "running"
                    or final.get("identity") != PARTY_MAINTENANCE_IDENTITY):
                return unknown
        return {"active": True, "phase": "running", "own": summary, "updatedAt": updated,
                "observationsCurrent": time.time() - updated <= 60}
    except (OSError, ValueError, TypeError, ConversationError):
        return unknown


