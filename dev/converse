    if (not isinstance(policy, dict) or not re.fullmatch('[a-f0-9]{64}', str(policy.get('revision', '')))
            or not isinstance(actions, dict) or actions.get('sessionId') != sid
            or str(actions.get('selfGuid')) != str(guid)):
        return []
    failures = []
    if policy.get('faulted') is True:
        failures.append(('policy', 'attached_policy_faulted', {}))
    movement = actions.get('targetMovement', {})
    if isinstance(movement, dict) and movement.get('phase') in ATTACHED_MOVEMENT_FAILURES:
        failures.append(('movement', movement['phase'], dict(movement)))
    # Formation and the caller-selected approach share the same navigation harness.
    reason = actions.get('reason')
    if reason in ATTACHED_MOVEMENT_FAILURES and not failures:
        failures.append(('movement', reason, dict(navReason=actions.get('navReason'))))
    for field in ('lastSpellOperation', 'lastMeleeOperation'):
        operation = actions.get(field, {})
        if isinstance(operation, dict) and operation.get('phase') in ATTACHED_OPERATION_FAILURES:
            evidence = dict(operation)
            if field == 'lastSpellOperation':
                # A separate buff operation can update the global last-cast
                # fields while this support operation remains retained.
                matching = (operation.get('spellId') is not None
                    and str(actions.get('lastCastSpellId'))==str(operation['spellId'])
                    and str(actions.get('lastCastTargetGuid',0))==str(operation.get('targetGuid',0)))
                # Preserve the existing Lua observer's raw status input, but
                # never present it as this retained operation's failure code.
                if 'lastCastFailure' in actions:evidence['lastCastFailure']=actions['lastCastFailure']
                evidence['lastCastFailureScope']='global_last_cast_not_operation_linked'
                evidence['globalLastCastFailureContext']=dict(
                    **{key:copy.deepcopy(actions[key]) for key in
                       ('lastCastSpellId','lastCastTargetGuid','lastCastFailure') if key in actions},
                    matchesRetainedSpellAndTarget=matching,
                    operationRevisionKnown=False,
                    semantics='Corroborating global status only. Even matching spell and target can describe a different cast; no operation-linked event receipt is published.')
                evidence['operationFailure'] = dict(
                    **{key: copy.deepcopy(operation[key]) for key in
                       ('spellId', 'targetGuid', 'capability', 'phase', 'operationRevision', 'visitId')
                       if key in operation},
                    failureCodeKnown=False, failureCode=None,
                    failureCodeUnknownReason='No operation-linked failure code is published; global last-cast status is separate context.',
                    sessionId=sid, casterGuid=str(guid),
                    source='buddy_actions_status_fields_not_an_independent_event_receipt')
            failures.append((field, operation['phase'], evidence))
    command = actions.get('commandFault', {})
    if (isinstance(command, dict) and command.get('sessionId') == sid
            and str(command.get('selfGuid')) == str(guid) and command.get('method')
            and isinstance(command.get('error'), str) and command['error']):
        failures.append(('command', 'action_rpc_rejected', dict(command)))
    result = []
    for field, reason, evidence in failures:
        # Target IDs and position drift are evidence, not distinct bugs. A broken
        # spell does not warrant another model call for every mob it encounters.
        signature = [field, reason, evidence.get('capability'), evidence.get('spellId'), evidence.get('lastCastFailure'),
            evidence.get('method'), evidence.get('error')]
        binding = [str(guid), sid, policy['revision'], signature]
        key = hashlib.sha256(json.dumps(binding, separators=(',', ':')).encode()).hexdigest()
        result.append(dict(key=key, kind='attached_policy', field=field, error=reason,
            sessionId=sid, sourceRevision=policy['revision'], signature=signature,
            evidence=evidence, policy={k: policy[k] for k in
                ('revision', 'generation', 'faulted', 'pendingActionIds') if k in policy}))
        if field == 'lastSpellOperation':
            result[-1]['operationOrigin'] = dict(known=False,
                reason='Status does not publish the operation origin or originating policy revision; current policy is observer context, not proven cause.')
    return result


def attached_repair_progress(actions):
    position = actions.get('position', {})
    movement = actions.get('targetMovement', {})
    return json.dumps([{k: position.get(k) for k in ("known", "mapId", "x", "y", "z", "orientation")}, movement.get('targetGuid'),
        *[actions.get(k) for k in ('serverCastGo', 'serverAssistGo', 'assistDamageEvents',
            'meleeDamageEvents', 'smiteDamageEvents', 'fireballDamageEvents',
            'sinisterStrikeDamageEvents', 'shadowBoltDamageEvents')]], sort_keys=True)


def reserve_attached_fault(folder, guid, url, fault, reserve=True):
    # One small receipt per actual failure/revision, rather than a capped task
    # queue or repeated calls. Receipts survive chat-worker refreshes.
    journal = Path(folder) / 'attached-policy-faults'
    key = fault['key']
    if not re.fullmatch('[a-f0-9]{64}', key):
        raise ConversationError('Invalid attached policy fault key')
    path = journal / (key + '.json')
    if path.exists():
        return 'already_reserved'
    if not reserve:
        return 'available'
    ensure_state(journal)
    try:
        descriptor = private_open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
    except FileExistsError:
        return 'already_reserved'
    with os.fdopen(descriptor, 'w') as target:
        json.dump(dict(guid=str(guid), rpcUrl=url, sessionId=fault['sessionId'],
            revision=fault['sourceRevision'], signature=fault['signature']), target)
        target.flush()
        os.fsync(target.fileno())
    return 'reserved'


def mission_faults(guid, sid, url):
    metadata=mission_runtime_context(guid,sid,url)
    result=gm_tasks.task_faults(ROOT,guid,sid,url)
    try:
        host=task_runtime_module()
        for kind in ('expedition','fishing'):
            summary=metadata[kind]
            if not summary['available']:continue
            data=host.Store(ROOT/'data/tasks'/kind/str(guid)/'runtime',max_bytes=host.MAX_CONTROLLER_LIMIT).load()
            run=host.run_binding(data)
            if (data.get('identity',{}).get('guid')!=str(guid) or data['identity'].get('sessionId')!=sid
                    or data['identity'].get('rpcUrl')!=url or mission_metadata_updated(data)!=summary['updatedAt']
                    or data.get('goodRevision')!=summary['sourceRevision']):continue
            if summary.get('active'):
                blockers,epoch=mission_deferred_blockers(data)
                for blocker in blockers:
                    binding=[str(guid),sid,kind,summary['goalId'],summary['sourceRevision'],blocker['task'],blocker['reason'],epoch]
                    key=hashlib.sha256(json.dumps(binding,separators=(',',':')).encode()).hexdigest()
                    result.append(dict(key=key,kind=kind,instance=run['instance'],field='deferred_child',
                        error='deferred_child:'+blocker['task']+':'+blocker['reason'],**blocker,
                        goalId=summary['goalId'],sourceRevision=summary['sourceRevision'],
                        sourcePath=summary.get('sourcePath'),updatedAt=summary['updatedAt']))
            errors=[(key,data.get(key)) for key in ('hostError','policyError','observationError')]
            health=data.get('memory',{}).get('health',{})
            if (isinstance(health,dict) and health.get('code')=='stalled'
                    and isinstance(health.get('phase'),str) and re.fullmatch(r'[A-Za-z0-9_.:/-]{1,128}',health['phase'])
                    and type(health.get('since')) in (int,float) and math.isfinite(health['since'])
                    and health['since']>=0):
                errors.append(('health','stalled:'+str(health.get('phase','unknown'))))
            for field,error in errors:
                if not isinstance(error,str) or not error or len(error.encode('utf-8'))>2048 or error=='task_stopped_or_deadline':continue
                if field in ('hostError','policyError','observationError') and data.get(field+'Instance')!=run['instance']:continue
                rejected=data.get('rejectedRevision','') if field=='policyError' else ''
                if not isinstance(rejected,str) or not re.fullmatch(r'|[a-f0-9]{64}',rejected):continue
                if field=='hostError':
                    ended=run.get('stoppedAt')
                    if (run['active'] or type(ended) not in (int,float) or not math.isfinite(ended)
                            or ended<0):continue
                clean=''.join(' ' if unicodedata.category(c).startswith('C') or c=='|' else c for c in error).strip()[:384]
                if not clean:continue
                binding=[sid,kind,run['instance'],summary['goalId'],summary['sourceRevision'],rejected,field,error]
                key=hashlib.sha256(json.dumps(binding,separators=(',',':')).encode()).hexdigest()
                result.append(dict(key=key,kind=kind,instance=run['instance'],field=field,error=clean,
                    goalId=summary['goalId'],sourceRevision=summary['sourceRevision'],rejectedSourceRevision=rejected,
                    updatedAt=summary['updatedAt'],faultAt=(health['since'] if field=='health' else ended if field=='hostError' else summary['updatedAt'])))
    except (OSError,ValueError,TypeError,AttributeError,RuntimeError,ConversationError):return result
    except Exception:return result  # Keep independent observed GM faults available.
    return result


