def spell_toolkit_context(raw, actions, guid):
    """Read only actual same-body learned spells, never model-selected casts."""
    unknown = {"available": False}
    if (not isinstance(raw, dict) or not isinstance(raw.get("sessionId"), str)
            or not 1 <= len(raw["sessionId"]) <= 128
            or raw["sessionId"] != actions.get("sessionId")
            or integer(raw.get("selfGuid", 0)) != guid
            or integer(actions.get("selfGuid", 0)) != guid
            or raw.get("spellbookKnown") is not True):
        return unknown
    rows = raw.get("spells", [])
    if not isinstance(rows, list) or len(rows) > 4096:
        return unknown
    clean, seen = [], set()
    for row in rows:
        if not isinstance(row, dict): return unknown
        spell = integer(row.get("spellId", 0))
        if not 0 < spell < 2**32 or spell in seen: return unknown
        seen.add(spell)
        item = {"spellId": spell, "metadataKnown": row.get("metadataKnown") is True}
        # Exact learned casting is independent of automatic effect categories.
        # Missing new fields on an old module mean discover, never prohibit.
        for key in ('selfCastSupported','channeled','genericCastSupported','passive'):
            if key in row:
                if type(row[key]) is not bool:return unknown
                item[key]=row[key]
        if item.get('passive') is True:item['genericCastSupported']=False
        reason=row.get('classificationReason',row.get('blockedReason',''))
        if isinstance(reason,str) and re.fullmatch(r'[a-z_0-9]{0,100}',reason):
            item['classificationReason']=reason
            if 'classificationReason' not in row and reason:item['classificationSource']='legacy_blocked_reason'
        mechanics=row.get('mechanics')
        if isinstance(mechanics,dict):
            # Raw attributes, reagents and effects stay inspectable on demand.
            item['mechanicsAvailable']=True
            hint={}
            for key in ('targetMask','castMinMs','gcdMs','durationIndex','cooldownMs'):
                if key in mechanics:hint[key]=integer(mechanics[key])
            effects=mechanics.get('effects',[])
            if isinstance(effects,list) and len(effects)<=3:
                hint['targetSelectors']=[dict(a=integer(effect.get('targetSelectorA',0)),b=integer(effect.get('targetSelectorB',0)))
                    for effect in effects if isinstance(effect,dict)]
            item['mechanicsHint']=hint
        if item["metadataKnown"]:
            item.update(name=plain_text(row.get("name"), 100),
                        rank=integer(row.get("rank", 0)),
                        selfOnly=row.get("selfOnly") is True,
                        automaticBuffSupported=row.get("automaticBuffSupported") is True)
            # Declarative mechanics and prerequisites from the actual spellbook.
            for key in ("capability","targetRule"):
                value=row.get(key,"")
                if isinstance(value,str) and re.fullmatch(r"[a-z_0-9]{0,100}",value):item[key]=value
            for key in ("castTimeMs","flatCost","requiredSubclassMask"):
                item[key]=integer(row.get(key,0))
            item.update(requiresStealth=row.get("requiresStealth") is True,requiresBehind=row.get("requiresBehind") is True)
            range_yards = row.get("rangeYards", 0)
            if type(range_yards) in (int, float) and 0 < range_yards <= 100:
                item["rangeYards"] = range_yards
        clean.append(item)
    # Keep all supported named controls even for an unusually large spellbook.
    clean.sort(key=lambda row: (not (row.get("automaticBuffSupported") or row.get("capability") in ("heal", "resurrect")),
                                row["spellId"]))
    result = {"available": True, "spellbookRevision": str(integer(raw.get("spellbookRevision", 0))),
              "spells": clean[:128], "spellsTruncated": len(clean) > 128,
              "targetedResurrectionSupported": raw.get("targetedResurrectionSupported") is True}
    result.update(inspectMethod="buddy-actions.spell_toolkit",castDiscoveryMethod="session.describe")
    last = raw.get("lastBuff", {})
    if isinstance(last, dict) and re.fullmatch(r"[a-z_]{1,100}", str(last.get("phase", ""))):
        result["lastBuff"] = {"phase": last["phase"], "spellId": integer(last.get("spellId", 0)),
                              "targetGuid": str(integer(last.get("targetGuid", 0))),
                              "serverCastGo": last.get("serverCastGo") is True,
                              "auraConfirmed": last.get("auraConfirmed") is True}
    return result


def professions_context(raw, guid, session):
    if (not isinstance(raw, dict) or not isinstance(raw.get("sessionId"), str)
            or not 1 <= len(raw["sessionId"]) <= 128 or raw["sessionId"] != session or integer(raw.get("selfGuid", 0)) != guid):
        return {"available": False}
    skills, recipes = raw.get("skills", []), raw.get("recipes", [])
    if not isinstance(skills, list) or len(skills) > 128 or not isinstance(recipes, list) or len(recipes) > 4096:
        return {"available": False}
    out = {"available": True, "sessionId":raw["sessionId"], "selfGuid":str(guid), "skillsKnown": raw.get("skillsKnown") is True,
           "spellsKnown": raw.get("spellsKnown") is True, "active": raw.get("active") is True,
           "skills": [], "recipes": []}
    if out["skillsKnown"]:
        for row in skills:
            if not isinstance(row, dict): return {"available": False}
            skill, rank, maximum = (integer(row.get(k, 0)) for k in ("skillId", "rank", "maximum"))
            if not 0 < skill < 2**32 or not 0 < rank <= maximum <= 450: return {"available": False}
            out["skills"].append({"skillId": skill, "rank": rank, "maximum": maximum})
    if out["spellsKnown"]:
        for row in recipes[:128]:
            if not isinstance(row, dict): return {"available": False}
            out["recipes"].append({"known": row.get("known") is True, "spellId": integer(row.get("spellId", 0)),
                                   "skillId": integer(row.get("skillId", 0))})
        out["recipesTruncated"] = len(recipes) > 128
    return out


def reward_metadata_snapshot(response):
    """Keep only bounded item-template facts, never arbitrary RPC response keys."""
    rows = quest_rewards._metadata_rows(response)
    if len(rows) > 6:
        raise ConversationError("Too many reward item details")
    clean = []
    for item_id, row in sorted(rows.items()):
        item = {"itemId": item_id, "available": row.get("available") is True,
                "pending": row.get("pending") is True}
        if item["available"]:
            if not quest_rewards._validate_item(row):
                raise ConversationError("Invalid reward item details")
            item.update({key: row.get(key, 0) for key in quest_rewards._UINT_FIELDS})
            item["name"] = BuddyControls.label(row.get("name"), f"item {item_id}", 160)
            item["stats"] = [{"type": stat.get("type", 0), "value": stat.get("value", 0)} for stat in row.get("stats", [])]
            item["damages"] = [{key: damage.get(key, 0) for key in ("minimum", "maximum", "school")} for damage in row.get("damages", [])]
        clean.append(item)
    return {"available": all(row["available"] and not row["pending"] for row in clean) and bool(clean), "items": clean}


def character_name(value):
    if not isinstance(value, str) or not 2 <= len(value) <= 12 or not value.isalpha():
        raise ConversationError("Character names must contain2..12 letters")
    return value


