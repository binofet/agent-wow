    def maybe_review_learned_spells(self):
        # A single observation slot feeds the existing synchronous brain. No
        # banter timer, per-rank jobs, worker or second repair queue is involved.
        notice=copy.deepcopy(getattr(self.controls,'learned_spell_notice',None))
        folder=getattr(self.brain,'state_dir',None)
        if not notice or folder is None or not self.session_id:return False
        development=self.development_context('spell_learning')
        if not development.get('enabled') or notice.get('sessionId')!=development['sessionId']:return False
        sid,key=development['sessionId'],notice['key']
        reserved=False;started=False
        # Same durable once-ledger implementation, separate evidence namespace:
        # learning notices must not consume the mission repair policy's budget.
        reservation_folder=Path(folder)/'learned-spell-notices'
        try:
            if reserve_mission_fault(reservation_folder,self.character_guid,development['rpcUrl'],key,reserve=False)=='already_reserved':
                self.controls.acknowledge_learned_spells(notice);return False
            identity=dict(sessionId=sid,characterGuid=str(self.character_guid))
            view=self.rpc.call('session.policy_source',identity)
            source,revision=view.get('source'),view.get('revision')
            generation=str(view.get('generation',''))
            limit=view.get('sourceLimitBytes',gm_tasks.SOURCE_BYTES)
            if (view.get('sessionId')!=sid or str(view.get('characterGuid'))!=identity['characterGuid']
                    or not isinstance(source,str) or not source or not re.fullmatch('[a-f0-9]{64}',str(revision))
                    or hashlib.sha256(source.encode()).hexdigest()!=revision or not generation.isdecimal()
                    or type(limit) is not int or limit<=0 or len(source.encode())>limit):
                raise ConversationError('Current learned-spell review policy source is unavailable')
            binding=dict(identity,revision=revision,generation=generation)
            result=evaluate_spell_learning(source,dict(notice=notice,nowMs=time.monotonic()*1000),limit)
            if not self.mission_repair_policy_current(binding):return False
            if not isinstance(result,dict) or result.get('available') is not True:
                self.status(spellLearningPhase='learning_policy_export_unavailable');return False
            decision=result.get('decision')
            if not isinstance(decision,dict) or not re.fullmatch('[a-z_0-9]{1,100}',str(decision.get('phase',''))):
                raise ConversationError('Learned-spell review policy returned an invalid decision')
            self.status(spellLearningPhase=decision['phase'],spellLearningKey=key)
            if decision.get('ready') is not True:return False
            pending=self.rpc.call('buddy-chat.poll',dict(afterSequence=str(self.cursor),limit=256,sessionId=self.session_id))
            if pending.get('sessionId')!=self.session_id:self.reset_body();return True
            if integer(pending.get('latestSequence',0))!=self.cursor:return True
            self.spell_learning_active=(sid,key)
            current=lambda:self.spell_learning_current(self.character_guid,sid,development['rpcUrl'],key)
            if not current():return False
            phase=reserve_mission_fault(reservation_folder,self.character_guid,development['rpcUrl'],key)
            if phase!='reserved':return False
            reserved=True
            if not current() or not self.mission_repair_policy_current(binding):return True
            pending=self.rpc.call('buddy-chat.poll',dict(afterSequence=str(self.cursor),limit=256,sessionId=self.session_id))
            if pending.get('sessionId')!=self.session_id:self.reset_body();return True
            if integer(pending.get('latestSequence',0))!=self.cursor:return True
            state=dict(self.controls.context(),character=dict(name=self.character_name,**{'class':self.character_class},guid=str(self.character_guid)),
                development=development,current_request=AgentBrain._SpellLearningRequest(source='spell_learning',noticeKey=key,
                    owned_learning_check=self.spell_learning_current,controls_allowed=False,repair_requests_allowed=False),
                learned_spell_changes=notice)
            cue=dict(speaker='Own learned-spell observer',text=
                'Your same-body spellbook gained the coalesced actual IDs in learned_spell_changes. Inspect their full rows '
                'with development.policyCommands.spell and discover the installed generic cast contract. Classification is not cast availability. '
                'The shared cast_spell handler already accepts unfamiliar learned IDs. When useful, update and test your own current Lua '
                'through show/apply CAS in this same session; preserve every pending/unknown operation and unrelated policy. '
                'Do not cast spells merely to test this notice or pull an enemy. A future owner request must work with at most a Lua edit, '
                'without a new native effect handler, workshop or reconnect. Make no edit if the existing policy already suffices. '
                'This is silent internal work: no chat/emote/GM RPCs, no new agent or model. Set final action NONE/emote NONE; empty text is allowed.')
            if not current() or not self.mission_repair_policy_current(binding):return True
            if self.stopped():raise Stopped('Conversation stop requested')
            started=True
            self.status(phase='thinking',spellLearningPhase='review_started',spellLearningKey=key)
            validate_reply(self.generate_reply([cue],state,still_current=current),allow_silent=True,
                natural=isinstance(self.brain,DirectBrain))
            finish_mission_fault(reservation_folder,self.character_guid,development['rpcUrl'],key,'model_returned')
            reserved=False
            still_current=current()
            self.controls.acknowledge_learned_spells(notice)
            self.status(phase='listening',spellLearningPhase='review_completed' if still_current else 'body_or_notice_changed_after_review',spellLearningKey=key)
        except Stopped:raise
        except OwnerInputPending:
            self.status(phase='listening',spellLearningPhase='yielded_to_input')
        except Exception:
            self.status(phase='listening',spellLearningPhase='review_unconfirmed')
        finally:
            if reserved:
                finish_mission_fault(reservation_folder,self.character_guid,development['rpcUrl'],key,'unknown' if started else 'not_started')
                self.controls.acknowledge_learned_spells(notice)
            self.spell_learning_active=None
        return True

    def maybe_initiate(self):
        now = time.monotonic()
        if (not self.controls or not self.banter_seconds or now < self.next_banter
                or now < self.next_banter_check or now - self.last_activity < 60):
            return
        # Checking presence uses cheap game RPCs, never a model call at every poll.
        self.next_banter_check = now + 15
        state = self.controls.context()
        owner = state.get("observations", {}).get("owner", {})
        # AFK/DND are explicit server-observed preferences; replies to a new
        # message still work, but initiated banter waits until Joel returns.
        if integer(owner.get("playerFlags", 0), "player flags") & 0x6:
            return
        nearby = owner.get("present") is True and not (owner.get("aliveKnown") is True and owner.get("alive") is not True)
        group = state.get("party", {})
        members = group.get("members", []) if isinstance(group, dict) else []
        in_party = group.get("known") is True and group.get("inGroup") is True
        online_in_party = in_party and any(isinstance(member, dict) and member.get("online") is True
                                          and integer(member.get("guid", "0")) == self.player_guid for member in members)
        if not nearby and not online_in_party:
            return
        if owner.get("aliveKnown") is True and owner.get("alive") is not True:
            return
        # Reserve the interval before generation/write, including ambiguous errors.
        self.next_banter = now + self.banter_seconds
        channel = "PARTY" if online_in_party else "WHISPER"
        cue = {"speaker": "Conversation cue", "channel": channel,
               "text": "Joel asked for occasional natural conversation. Initiate one brief thought or question as his friend. Use actual own quest journal objectives and progress when available, or other supplied observations/events; otherwise choose a casual topic. Never invent quests, enemies, scenery or successful actions. Set action NONE. Avoid repetitive check-ins or offers of help."}
        state = dict(state, character={"name": self.character_name, "class": self.character_class,
                                       "guid": str(self.character_guid)},
                     party_agents=[{"name": name, "guid": str(guid)} for guid, name in self.party_agents.items()],
                     development={"enabled":False}, current_request={"source": "initiative", "controls_allowed": False})
        if state.get("emote_catalog",{}).get("sessionId") != self.session_id:
            state["emote_catalog"] = {"available":False}
        self.reply_emotes = supported_emotes(state)
        self.status(phase="thinking", event="occasional_conversation", cursor=self.cursor)
        try:
            reply = validate_reply(self.generate_reply(self.history[channel][-19:] + [cue], state),self.reply_emotes,
                natural=isinstance(self.brain,DirectBrain))
        except OwnerInputPending:
            return
        if self.stopped():
            raise Stopped("Conversation stop requested")
        if not self.same_body():
            return
        # An initiated conversation can never enable movement or casting.
        reply["action"] = "NONE"
        self.send_reply(reply, channel)
        self.controls.events.clear()


def ensure_state(path):
    path = Path(path).absolute()
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    if path.is_symlink() or not path.is_dir() or path.stat().st_uid != os.getuid():
        raise ConversationError("State directory must be a real directory owned by the current user")
    path.chmod(0o700)
    return path


def private_open(path, flags):
    descriptor = os.open(path, flags | os.O_NOFOLLOW, 0o600)
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
        os.close(descriptor)
        raise ConversationError("Runtime file must be a private regular file")
    os.fchmod(descriptor, 0o600)
    return descriptor


def write_json(path, value):
    descriptor, temporary = tempfile.mkstemp(prefix=".state-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as target:
            json.dump(value, target)
            target.write("\n")
        if path.is_symlink():
            raise ConversationError("Runtime file cannot be a symlink")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_json(path):
    try:
        with os.fdopen(private_open(path, os.O_RDONLY), "r") as source:
            raw = source.read(8193)
        if len(raw) > 8192:
            raise ConversationError("Runtime status exceeds the size limit")
        value = json.loads(raw)
        if not isinstance(value, dict):
            raise ValueError
        return value
    except FileNotFoundError:
        return {}
    except ValueError:
        raise ConversationError("Runtime status is invalid") from None


def is_locked(lock):
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    fcntl.flock(lock, fcntl.LOCK_UN)
    return False


def conversation_profile(args):
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", args.profile):
        raise ConversationError("Profile must be a short lowercase slug")
    if args.profile != "default" and (not args.character_name or not args.character_class or not args.character_guid):
        raise ConversationError("Named profiles require character name, class, and GUID")
    args.character_name = character_name(args.character_name or "Arlen")
    args.character_class = args.character_class or "priest"
    args.character_guid = args.character_guid or 1
    args.player_name = character_name(args.player_name)
    if (not 0 < args.character_guid < 2**48 or args.character_guid == args.player_guid
            or args.character_class not in CLASS_IDS):
        raise ConversationError("Character identity is invalid")
    roster = parse_roster(args.party_agent, args.character_guid, args.character_name, args.player_guid)
    path = args.state_dir or (ROOT / "data/converse" if args.profile == "default" else ROOT / "data/converse" / args.profile)
    RPC(args.rpc_url) # Validate the endpoint for run, status, and stop alike.
    identity = {"profile":args.profile,"name":args.character_name,"class":args.character_class,
                "guid":args.character_guid,"owner_guid":args.player_guid,"rpc_url":args.rpc_url}
    return path, identity, roster


def owner_whisper_continuation(value):
    if value is None:return None
    if not isinstance(value, (list, tuple)) or len(value) != 4:
        raise ConversationError('Owner continuation requires Core session, Chat session, exact sequence and original request ID')
    core, chat, sequence, request_id = value
    if (any(not isinstance(sid, str) or re.fullmatch(r'[A-Za-z0-9._-]{1,128}', sid) is None for sid in (core, chat))
            or not isinstance(sequence, str) or re.fullmatch(r'[1-9][0-9]{0,19}', sequence) is None
            or int(sequence) >= 2**64 or not isinstance(request_id, str) or re.fullmatch(r'[a-f0-9]{32}', request_id) is None):
        raise ConversationError('Owner continuation identity or sequence is invalid')
    return dict(sessionId=core, chatSessionId=chat, sequence=int(sequence), requestId=request_id)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=("run", "status", "stop"))
    parser.add_argument("--state-dir", type=Path)
    parser.add_argument("--profile", default="default")
    parser.add_argument("--character-name")
    parser.add_argument("--character-class", choices=tuple(CLASS_IDS))
    parser.add_argument("--character-guid", type=int)
    parser.add_argument("--party-agent", action="append", default=[], metavar="NAME:GUID")
    parser.add_argument("--player-name", default="Joel")
    parser.add_argument("--owner-quest-context", type=Path,
                        help="Private JSON human-reported quest snapshot; never live server evidence")
    parser.add_argument("--rpc-url", default="http://127.0.0.1:8086/rpc")
    parser.add_argument("--player-guid", type=int, default=3)
    parser.add_argument("--codex", default=DEFAULT_CODEX)
    parser.add_argument("--model-provider", choices=("codex", "local", "openai", "claude", "gemini", "responses"), default="codex")
    parser.add_argument("--model-base-url", help="Explicit base URL for the selected model API")
    parser.add_argument("--local-provider", choices=("lmstudio", "ollama"))
    parser.add_argument("--model-api-key-env", help="Environment variable name for the selected provider key")
    parser.add_argument("--included-usage-only", action="store_true",
                        help="For the Codex provider, start replies only while included usage is available")
    parser.add_argument("--model", type=explicit_model, help="Explicit model ID for the selected provider")
    parser.add_argument("--reasoning-effort", choices=('low', 'medium', 'high', 'xhigh', 'max', 'ultra'),
                        help="Explicit Codex reasoning effort; omitted preserves the CLI default")
    parser.add_argument("--developer-workspace",type=Path,
                        help="Override the registered in-game Lua development worktree")
    parser.add_argument("--resume-whispers", action="store_true",
                        help="Handle the latest unanswered owner whisper in the current live chat body once")
    parser.add_argument("--continue-owner-whisper", nargs=4, metavar=("CORE_SESSION", "CHAT_SESSION", "SEQUENCE", "ORIGINAL_REQUEST_ID"),
                        help="Explicitly continue one genuine retained owner whisper on this exact body; preserve prior tool outcomes")
    parser.add_argument("--poll-seconds", type=float, default=1)
    parser.add_argument("--reply-timeout", type=float, default=None,
        help="explicit total reply deadline; ordinary chat defaults to 120s, authorized development remains interruptible")
    parser.add_argument("--max-replies", type=int, default=200)
    parser.add_argument("--max-hours", type=float, default=8)
    parser.add_argument("--persistent", action="store_true", help="Keep listening until explicitly stopped")
    parser.add_argument("--banter-seconds", type=float, default=180,
                        help="Minimum gap for occasional initiated conversation; 0 disables it (default 180)")
    args = parser.parse_args(argv)
    if args.continue_owner_whisper is not None:
        try:owner_whisper_continuation(args.continue_owner_whisper)
        except ConversationError as error:parser.error(str(error))
        if args.command != 'run' or args.resume_whispers or args.model_provider not in ('local','openai','claude','gemini'):
            parser.error('Explicit owner continuation requires direct-model run without --resume-whispers')
    if args.model_provider in ("local", "openai", "claude", "gemini"):
        from direct_model import DirectModel
        DirectModel(args.model_provider, args.model, args.model_base_url, args.model_api_key_env, args.reply_timeout)
    else:
        model_transport(args.model_provider, model=args.model, base_url=args.model_base_url,
                        local_provider=args.local_provider, api_key_env=args.model_api_key_env)
    if (not 0.2 <= args.poll_seconds <= 10 or args.reply_timeout is not None and not 5 <= args.reply_timeout <= 180
            or not 1 <= args.max_replies <= 1000 or not 0 < args.max_hours <= 24
            or not 0 < args.player_guid < 2**48
            or (args.banter_seconds != 0 and not 120 <= args.banter_seconds <= 3600)):
        parser.error("Conversation limits are outside the supported range")
    state_path, identity, roster = conversation_profile(args)
    state = ensure_state(state_path)
    with os.fdopen(private_open(state / "lock", os.O_RDWR | os.O_CREAT), "r+") as lock:
        if args.command != "run":
            running = is_locked(lock)
            record = read_json(state / "status.json")
            if running and record.get("character_identity") is not None and record["character_identity"] != identity:
                raise ConversationError("This state directory tracks another character; no stop requested")
            if running and record.get("character_identity") is None and args.profile != "default":
                raise ConversationError("Legacy conversation has no matching named profile; no stop requested")
            if args.command == "stop":
                if running and record.get("instance"):
                    write_json(state / "stop.json", {"instance": record["instance"]})
                    print("Conversation stop requested; the game character remains online.")
                else:
                    print("Conversation is not running.")
            else:
                record["running"] = running
                print(json.dumps(record, indent=2))
            return 0
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ConversationError("Conversation is already running in this state directory") from None
        record = {"instance": uuid.uuid4().hex, "pid": os.getpid(), "phase": "starting",
                  "started": time.time(), "replies": 0, "cursor": 0, "character_identity":identity,
                  "persistent": args.persistent}
        local_stop = False
        conversation = None
        brain = None
        def request_stop(signum, frame):
            nonlocal local_stop
            local_stop = True
        signal.signal(signal.SIGINT, request_stop)
        signal.signal(signal.SIGTERM, request_stop)
        def stopped():
            return local_stop or read_json(state / "stop.json").get("instance") == record["instance"]
        def status(**fields):
            binding = conversation.status_identity() if conversation is not None else dict(
                coreSessionId=None, coreCharacterGuid=None, chatSessionId=None)
            record.update(fields, **binding, updated=time.time())
            if isinstance(brain, DirectBrain):
                record["modelSelection"] = brain.model_selection()
            if fields.get("phase") in ("listening", "thinking"):
                record.pop("error", None)
            write_json(state / "status.json", record)
        rpc = RPC(args.rpc_url)
        workspace = args.developer_workspace
        if workspace is None:
            workspace = registered_developer_workspace(args.character_guid, args.character_name)
        if args.model_provider in ("local", "openai", "claude", "gemini"):
            brain = DirectBrain(state, args.reply_timeout, stopped, args.character_name,
                args.character_class, workspace, args.model, provider=args.model_provider,
                base_url=args.model_base_url, api_key_env=args.model_api_key_env)
        else:
            provider_options = {} if args.model_provider == "codex" else dict(provider=args.model_provider,
                base_url=args.model_base_url, local_provider=args.local_provider, api_key_env=args.model_api_key_env)
            brain = CodexBrain(args.codex, state, args.reply_timeout, stopped, args.character_name, args.character_class,
                               workspace, args.model, args.reasoning_effort, **provider_options)
        brain.included_usage_only = args.included_usage_only
        record["developerWorkspace"] = str(brain.developer_workspace) if brain.developer_workspace is not None else None
        record["requestedModel"] = brain.model
        record["requestedReasoningEffort"] = brain.reasoning_effort
        record["modelSelection"] = brain.model_selection()
        controls = BuddyControls(rpc, args.player_name, args.character_class, args.owner_quest_context, args.character_guid,
                                 supply_state_dir=state, profile_identity=identity)
        conversation = Conversation(rpc, brain, args.player_guid, status, stopped,
                                    controls=controls, banter_seconds=args.banter_seconds, player_name=args.player_name, character_name=args.character_name, character_class=args.character_class, character_guid=args.character_guid, party_agents=roster, resume_whispers=args.resume_whispers, continue_owner_whisper=args.continue_owner_whisper)
        deadline = time.monotonic() + args.max_hours * 3600
        status()
        print(f"{args.character_name} ({args.character_class}) is listening for {args.player_name} and addressed roster party messages.", flush=True)
        print(f"Occasional conversation interval: {args.banter_seconds:g}s (0 disables). Stop with dev/converse stop.", flush=True)
        try:
            while not stopped() and (args.persistent or (time.monotonic() < deadline and conversation.replies < args.max_replies)):
                try:
                    conversation.tick()
                except Stopped:
                    break
                except ConversationError as error:
                    status(phase="error", error=str(error))
                    print(str(error), file=sys.stderr, flush=True)
                    # No automatic reply retries. Resume cheap polls after backoff.
                    until = time.monotonic() + 5
                    while time.monotonic() < until and not stopped():
                        time.sleep(0.1)
                until = time.monotonic() + args.poll_seconds
                while time.monotonic() < until and not stopped():
                    time.sleep(0.1)
        finally:
            status(phase="stopped")
        return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ConversationError, OSError) as error:
        print(f"Conversation: {error}", file=sys.stderr)
        sys.exit(1)
