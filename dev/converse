    """The listener can receive chat while model generation is paused."""


def included_usage_available(result):
    if result.get("ordinaryUsageAllowed") is not True:
        return False
    limits = result.get("rateLimitsByLimitId") or {}
    limits = limits.get("codex") or result.get("rateLimits") or {}
    primary = limits.get("primary")
    if not isinstance(primary, dict) or limits.get("rateLimitReachedType") is not None:
        return False
    windows = [primary]
    if limits.get("secondary") is not None:
        windows.append(limits["secondary"])
    return all(isinstance(window, dict) and type(window.get("usedPercent")) in (int, float)
               and 0 <= window["usedPercent"] < 100 for window in windows)


def check_included_usage(binary):
    """Read the signed-in allowance through App Server before starting inference."""
    process = subprocess.Popen([str(binary), "app-server", "--listen", "stdio://"],
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        deadline = time.monotonic() + 5
        buffered = bytearray()

        def send(message):
            process.stdin.write(json.dumps(message).encode() + b"\n")
            process.stdin.flush()

        def response(request_id):
            while time.monotonic() < deadline and len(buffered) < 1048576:
                newline = buffered.find(b"\n")
                if newline >= 0:
                    message = json.loads(buffered[:newline])
                    del buffered[:newline + 1]
                    if message.get("id") == request_id:
                        return message.get("result") or {}
                    continue
                if not select.select([process.stdout], [], [], max(0, deadline - time.monotonic()))[0]:
                    break
                chunk = os.read(process.stdout.fileno(), 65536)
                if not chunk:
                    break
                buffered.extend(chunk)
            return {}

        send({"id": 1, "method": "initialize", "params": {"clientInfo": {
            "name": "warcraft-buddy", "title": "Warcraft Buddy", "version": "1"}}})
        if not response(1):
            return False
        send({"method": "initialized"})
        send({"id": 2, "method": "account/rateLimits/read"})
        return included_usage_available(response(2))
    finally:
        process.terminate()
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        try:
            process.stdin.close()
        finally:
            process.stdout.close()


def integer(value, label="counter"):
    if isinstance(value, bool) or not isinstance(value, (int, str)):
        raise ConversationError(f"Invalid {label} in chat response")
    try:
        result = int(value)
    except ValueError:
        raise ConversationError(f"Invalid {label} in chat response") from None
    if result < 0 or result > 2**64 - 1 or str(result) != str(value):
        raise ConversationError(f"Invalid {label} in chat response")
    return result


def plain_text(text, limit=255):
    if not isinstance(text, str) or not text.strip():
        raise ConversationError("Reply text is empty")
    try:
        encoded = text.encode("utf-8")
    except UnicodeError:
        raise ConversationError("Reply text is not valid UTF-8") from None
    if len(encoded) > limit:
        raise ConversationError("Reply exceeds the chat byte limit")
    if any(unicodedata.category(c).startswith("C") or c == "|" for c in text):
        raise ConversationError("Reply contains controls or game markup")
    if text != text.strip() or text.startswith(("/", ".", "!")):
        raise ConversationError("Reply resembles a command or has surrounding whitespace")
    return text


def validate_reply(value, emotes=None, allow_silent=False, allow_gm=False, natural=False):
    allowed = {"text", "emote", "action", *NUMERIC_ARGS}
    if allow_gm:
        allowed.add("gm_command")
    if (not isinstance(value, dict) or not {"text", "emote"}.issubset(value)
            or not set(value).issubset(allowed)):
        raise ConversationError("Model response does not match the reply schema")
    silent = allow_silent and value["text"] == ""
    if silent and (value.get("action", "NONE") != "NONE" or value["emote"] != "NONE"):
        raise ConversationError("Silent development reply must have no action or emote")
    if natural and not silent:
        text = value["text"]
        if not isinstance(text, str) or not text.strip():
            raise ConversationError("Reply text is empty")
        try: text.encode("utf-8")
        except UnicodeError: raise ConversationError("Reply text is not valid UTF-8") from None
        if any(unicodedata.category(c).startswith("C") and c not in "\n\r\t" for c in text):
            raise ConversationError("Reply contains control characters")
    else:
        text = "" if silent else plain_text(value["text"])
    if value["emote"] != "NONE" and value["emote"] not in (LEGACY_EMOTES if emotes is None else emotes):
        raise ConversationError("Model returned an unsupported emote")
    action = value.get("action", "NONE")
    if action not in ACTIONS:
        raise ConversationError("Model returned an unsupported game action")
    result = {"text": text, "emote": value["emote"], "action": action}
    if "gm_command" in value:
        command = value["gm_command"]
        if not isinstance(command, str) or command and (
                not valid_gm_command(command) or action != "NONE" or value["emote"] != "NONE"):
            raise ConversationError("Model returned an invalid GM command")
        result["gm_command"] = command
    for key in NUMERIC_ARGS:
        if key in value:
            arg = value[key]
            if type(arg) is not int or not 0 <= arg <= 2**32 - 1:
                raise ConversationError("Model returned an invalid numeric game argument")
            result[key] = arg
    return result


def valid_gm_command(command):
    return (isinstance(command, str) and re.fullmatch(r"\.[A-Za-z][ -~]{0,253}", command) is not None
            and command == command.rstrip() and "|" not in command)


def parse_literal_gm_request(text):
    """Only explicit full invocations; quoted examples alone are not commands."""
    direct=re.fullmatch(r'gm +(\..+)',text,re.IGNORECASE)
    if direct:return direct[1]
    for opening,closing in (('"','"'),('“','”')):
        wrapper=re.fullmatch(r'(?:you need to run this gm command|run this gm command): *'+
            re.escape(opening)+r'gm +(\.[^"“”]+)'+re.escape(closing),text,re.IGNORECASE)
        if wrapper:return wrapper[1]
    return None


def literal_gm_feedback(command, result):
    """Present an existing guarded receipt, never infer a realm/game effect."""
    def clean(value):
        return ''.join(c for c in str(value) if not unicodedata.category(c).startswith('C') and c!='|')[:512]
    if not isinstance(result,dict):result={}
    if result.get('ok') is not True:
        error=result.get('error')
        text=('Command not dispatched: '+clean(error.get('error','guard refused'))
            if isinstance(error,dict) and error.get('outcome')=='not_dispatched'
            else 'Command dispatch is unconfirmed; I will not repeat it.')
    else:
        row=result.get('result')
        if not isinstance(row,dict):row={}
        if row.get('historicalReceipt') is True:text='Existing receipt only; I did not resend this command.'
        elif row.get('commandTransportWritten') is True:text='Command sent unchanged. Its game effect is not confirmed.'
        elif row.get('commandTransportWritten') is False:
            admission=next((row[k] for k in ('targetAdmission','destinationAdmission','partyAdmission','repeatAdmission') if isinstance(row.get(k),dict) and row[k].get('allowed') is False),{})
            text='Command not dispatched: '+clean(admission.get('reason') or row.get('completion') or row.get('reason') or 'guard refused')
        else:text='Command dispatch is unconfirmed; I will not repeat it.'
        target=row.get('targetAdmission')
        if isinstance(target,dict):
            text+=' Target facts: intended GUID '+clean(target.get('requiredTargetGuid') or target.get('requestedTargetGuid') or 'unknown')
            text+='; owner GUID '+clean(target.get('ownerGuid') or 'unknown')+' current target '+clean(target.get('ownerTargetGuid') or 'unknown')+'.'
            facts=target.get('target')
            if isinstance(facts,dict):text+=' Observed creature entry '+clean(facts.get('entry','unknown'))+'.'
        effect=row.get('targetEffect')
        if isinstance(effect,dict) and effect.get('known') is True:
            text+=(' The exact target was observed dead; causality is unconfirmed.' if effect.get('observedDead') is True
                else ' The exact target was still observed alive; do not infer a kill.')
        feedback=row.get('feedback')
        messages=feedback.get('systemMessages') if isinstance(feedback,dict) else None
        if isinstance(messages,list):
            observed=[m['text'] for m in messages if isinstance(m,dict) and isinstance(m.get('text'),str)]
            if observed:text+=' Realm feedback (not effect proof): '+clean(' '.join(observed))
    if re.match(r'\.arrive(?:\s|$)',command,re.IGNORECASE):
        text+=' If you meant moving me to a player, use gm .appear <name>; I did not substitute it.'
    return dict(text=text,emote='NONE',action='NONE')


