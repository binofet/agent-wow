    except ConversationError:
        return False


def validated_owner_feed(value):
    if (not isinstance(value, dict) or value.get("available") is not True or value.get("assembling") is True
            or integer(value.get("ageMs", 0)) > 15000
            or not isinstance(value.get("bodySessionId"), str) or not 1 <= len(value["bodySessionId"]) <= 128
            or not isinstance(value.get("addonSession"), str) or not re.fullmatch(r"[0-9a-f]{12}", value["addonSession"])
            or not 0 < integer(value.get("revision", 0)) <= 2147483647):
        raise ConversationError("Fresh complete Joel quest feed is unavailable")
    result = {"available": True, "live": True, "source": "Joel client addon via server party chat",
              "bodySessionId": value["bodySessionId"], "addonSession": value["addonSession"],
              "revision": integer(value["revision"]), "ageMs": integer(value.get("ageMs", 0)),
              "quests": [], "completedQuestIds": [], "rewarded": [], "accepted": []}
    quests, completed = value.get("quests", []), value.get("completedQuestIds", [])
    if not isinstance(quests, list) or len(quests) > 25 or not isinstance(completed, list) or len(completed) > 64:
        raise ConversationError("Owner quest feed exceeds its bounds")
    seen = set()
    for quest in quests:
        if not isinstance(quest, dict):
            raise ConversationError("Owner quest feed is invalid")
        qid, state = integer(quest.get("questId", 0)), integer(quest.get("state", 0))
        if not 0 < qid <= 2147483647 or qid in seen or state not in (0, 1, 2):
            raise ConversationError("Owner quest feed is invalid")
        result["quests"].append({"questId": qid, "state": state})
        seen.add(qid)
    result["completedQuestIds"] = [integer(qid) for qid in completed]
    if (len(set(result["completedQuestIds"])) != len(completed)
            or any(not 0 < qid <= 2147483647 for qid in result["completedQuestIds"])):
        raise ConversationError("Owner completed-quest subset is invalid")
    for key in ("rewarded", "accepted"):
        events, seen = value.get(key, []), set()
        if not isinstance(events, list) or len(events) > 8:
            raise ConversationError("Owner quest events exceed their bound")
        for event in events:
            if not isinstance(event, dict):
                raise ConversationError("Owner quest event is invalid")
            qid, npc, age = integer(event.get("questId", 0)), integer(event.get("npcGuid", 0)), integer(event.get("ageMs", 0))
            if (not 0 < qid <= 2147483647 or qid in seen or npc >> 48 != 0xf130
                    or not (npc >> 24 & 0xffffff) or not (npc & 0xffffff)):
                raise ConversationError("Owner quest event is invalid")
            seen.add(qid)
            if age <= 900000:
                result[key].append({"questId": qid, "npcGuid": str(npc), "ageMs": age})
    return result


