def supported_emotes(state):
    """Use metadata advertised by this installed chat bridge, not guessed IDs."""
    catalog = state.get("emote_catalog", {}) if isinstance(state, dict) else {}
    if not isinstance(catalog, dict) or catalog.get("available") is not True:
        return dict(LEGACY_EMOTES)
    rows = catalog.get("emotes", [])
    if not isinstance(rows, list) or not 1 <= len(rows) <= 512:
        raise ConversationError("Invalid installed emote catalog")
    result, ids = {}, set()
    for row in rows:
        if not isinstance(row, dict):
            raise ConversationError("Invalid installed emote entry")
        name, identity = row.get("name"), row.get("id")
        if (not isinstance(name, str) or re.fullmatch(r"[A-Z][A-Z_0-9]{0,63}", name) is None
                or name == "NONE" or type(identity) is not int or not 0 < identity < 2**31
                or name in result or identity in ids):
            raise ConversationError("Invalid installed emote identity")
        result[name] = identity
        ids.add(identity)
    return result


