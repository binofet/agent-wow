def reward_metadata_snapshot(response):
    """Keep only bounded item-template facts, never arbitrary RPC response keys."""
    rows = quest_rewards._metadata_rows(response)
    if len(rows) > 6:
        raise ConversationError("Too many reward item details")
    clean = []
    for item_id, row in sorted(rows.items()):
        item = {"itemId": item_id, "available": row.get("available") is True,
                "pending": row.get("pending") is True}
        if item["available"]:
            if not quest_rewards._validate_item(row):
                raise ConversationError("Invalid reward item details")
            item.update({key: row.get(key, 0) for key in quest_rewards._UINT_FIELDS})
            item["name"] = BuddyControls.label(row.get("name"), f"item {item_id}", 160)
            item["stats"] = [{"type": stat.get("type", 0), "value": stat.get("value", 0)} for stat in row.get("stats", [])]
            item["damages"] = [{key: damage.get(key, 0) for key in ("minimum", "maximum", "school")} for damage in row.get("damages", [])]
        clean.append(item)
    return {"available": all(row["available"] and not row["pending"] for row in clean) and bool(clean), "items": clean}


def character_name(value):
    if not isinstance(value, str) or not 2 <= len(value) <= 12 or not value.isalpha():
        raise ConversationError("Character names must contain2..12 letters")
    return value


