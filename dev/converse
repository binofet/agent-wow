                        or info.st_mode & (0o077 if path == folder else 0o022)):
                    raise ConversationError('Task metadata directory is unavailable')
            if folder.resolve() != folder: continue
            runtime=task_runtime_module()
            store=runtime.Store(folder,max_bytes=runtime.MAX_CONTROLLER_LIMIT)
            data=store.load()
            if not isinstance(data,dict): continue
            identity = data.get('identity', {})
            if (type(data.get('version')) is not int or data['version'] != 1 or not isinstance(identity, dict)
                    or str(identity.get('guid')) != str(guid) or identity.get('sessionId') != session_id
                    or identity.get('rpcUrl') != rpc_url): continue
            phase, goal, revision = (data.get(key) for key in ('phase', 'goalId', 'goodRevision'))
            updated=mission_metadata_updated(data)
            if (not isinstance(phase, str) or re.fullmatch(r'[A-Za-z0-9_.:/-]{1,128}', phase) is None
                    or not isinstance(goal, str) or re.fullmatch(r'[A-Za-z0-9_.:-]{1,96}', goal) is None
                    or not isinstance(revision, str) or re.fullmatch(r'|[a-f0-9]{64}', revision) is None
                    or type(updated) not in (int, float) or not math.isfinite(updated) or updated<0): continue
            memory, pending = data.get('memory'), data.get('pending')
            if (not isinstance(memory, dict) or not isinstance(pending, list) or len(pending) > runtime.MAX_ACTIONS
                    or any(not isinstance(row, dict) or row.get('outcome') != 'pending'
                           or row.get('effect') not in ('query', 'mutation') for row in pending)): continue
            stack = memory.get('stack', [])
            if not isinstance(stack, list) or len(stack) > 12: continue
            clean = []
            for frame in stack:
                if not isinstance(frame, dict): raise ValueError('Invalid task frame')
                frame_kind, frame_phase = frame.get('kind'), frame.get('phase', frame.get('stage'))
                if (not isinstance(frame_kind, str) or re.fullmatch(r'[A-Za-z0-9_.:-]{1,96}', frame_kind) is None
                        or not isinstance(frame_phase, str) or re.fullmatch(r'[A-Za-z0-9_.:/-]{1,128}', frame_phase) is None):
                    raise ValueError('Invalid task frame')
                clean.append(dict(kind=frame_kind, phase=frame_phase))
            summary.update(available=True, phase=phase, goalId=goal, sourceRevision=revision,
                           stack=clean[-8:], pendingCount=len(pending), updatedAt=updated)
            summary['deferredChildren']=mission_deferred_blockers(data)[0][:16]
            run=runtime.run_binding(data) if 'run' in data else None
            held=store.held() if run else False
            summary.update(active=bool(run and run['active'] and held),
                           stopped=bool(run and not run['active'] and not held),
                           lifecycleKnown=run is not None,
