            tools = DirectTools(RPC(url), sid, guid, self.developer_workspace if developer else None, ROOT,
                allowed=lambda: self.development_enabled(state) and not interrupted(),
                cancelled=interrupted, request_id=self._generation['toolCustodyRequestId'], context=full_context,
                gm_allowed=gm_authorised, chat_session_id=self._generation.get("chatSessionId"),
                chat_cursor=str(self._generation["cursor"]) if self._generation.get("cursor") is not None else None,
                owner_allowed=owner_authorised, receipt_root=self.state_dir,
                follow_prepare=private_context.get('followPrepare'),
                gm_owner_request=(dict(request=json.loads(encode(state['current_request'])),
                    continuationReport=json.loads(encode(private_context.get('continuationReport'))))
                    if gm_authorised() else None))
        if tools is not None and gm_authorised() and literal_command is None:
            read_started = int(time.time()*1000)
            observed = tools.dispatch("gm_inspect", {})
            read_completed = int(time.time()*1000)
            tools._catalog()  # A failed read must not hide a replaced current body.
            if interrupted():
                raise OwnerInputPending("Fresh owner input is waiting")
            if not gm_authorised():
                raise ConversationError("GM request authority changed during observation preparation")
            primer = dict(readStartedAtUnixMs=read_started, readCompletedAtUnixMs=read_completed,
                sessionId=development["sessionId"], selfGuid=str(development["selfGuid"]),
                outcome="read" if observed.get("ok") is True else "unavailable", observation=observed,
                semantics="Read times are not server-observation times. Keep each fact's knownness, age, identity and errors. "
                    "Positions in the retained conversation are historical; unavailable current facts remain unknown.")
            prompt_state["gm_observation_primer"] = primer
            full_context["gm_observation_primer"] = json.loads(encode(primer))
            captured = encode(full_context)
            if len(captured) > tools.max_bytes:
                raise ConversationError("Captured context exceeds the installed tool byte bound")
            tools.context = json.loads(captured)  # Complete detached snapshot, fixed before the API turn.
            record["gmObservationPrimer"] = {key:primer[key] for key in (
                "readStartedAtUnixMs", "readCompletedAtUnixMs", "sessionId", "selfGuid", "outcome")}
        if not allow_gm:
            from direct_context import ordinary_context
            prompt_state, brief_metrics = ordinary_context(prompt_state)
            record["ordinaryContextProjection"] = brief_metrics
        record["promptMetrics"] = dict(contextBytes=len(encode(prompt_state)),
            historyBytes=len(encode(history)), fullCapturedContextBytes=len(encode(full_context)))
        def dispatch(name, arguments):
            if interrupted():
                raise OwnerInputPending("Fresh owner input is waiting")
            serial[0] += 1
            if name in ("workspace_write", "workspace_patch", "policy_apply", "policy_input", "party_invite", "follow", "gameplay_command", "request_buffs", "gm_task_start", "gm_task_cancel", "gm_task_resume", "gm_execute"):
                mutation_entered[0] = True
                record["mutationToolEntered"] = True
            identity = (self._generation['toolCustodyRequestId'] if literal_command is not None else self.last_request_id) + ":" + str(serial[0])
            row = dict(itemId=identity, type="direct_function", name=name, status="unknown")
            record["pendingTools"].append(identity)
            record["tools"].append(row)
            if len(record["tools"]) > 16:
                record["tools"].pop(0); record["omittedTools"] += 1
            record.update(childPhase="tool.dispatch", lastTool=row, actionOutcome="unknown")
            publish()  # Retain an entered/unknown operation before the callback.
            try:
                if tools is not None:
                    result = tools.dispatch(name, arguments, operation_id=identity)
                elif name == "context_read":
                    try:
                        result = dict(ok=True, result=context_page(full_context, **arguments))
                    except ToolError as error:
                        result = dict(ok=False, error=dict(outcome="not_dispatched", error=str(error)[:384]))
                else:
                    raise ConversationError("Tool unavailable for this request")
            except BaseException as error:
                row["errorType"] = type(error).__name__
                receipt = getattr(error, "receipt", None)
                if isinstance(receipt, dict):
                    safe_keys = ("tool", "sessionId", "characterGuid", "outcome", "replayAllowed", "path",
                        "expectedSHA256", "targetSHA256", "expectedRevision", "targetRevision",
                        "valueSHA256", "taskId", "stateDir", "name", "transportWritten",
                        "controlDispatched", "preparationUnconfirmed")
                    row["unknownReceipt"] = {key: receipt[key] for key in safe_keys if key in receipt
                        and (type(receipt[key]) in (bool, int) or isinstance(receipt[key], str)
                             and len(receipt[key]) <= 512)}
                record["counts"]["failedTools"] += 1
                publish()
                raise
            row["status"] = "returned"
            record["pendingTools"].remove(identity)
            record["counts"]["completedTools"] += 1
            publish()
            return result
        self._generation["stage"] = "api_request"
        try:
            if literal_command is not None:
                if not gm_authorised() or tools is None:
                    raise ConversationError('Current authenticated GM tool authority unavailable')
                if (not callable(getattr(tools,'_gm_owner_target_scope',None))
                        or not callable(getattr(gm_tasks,'selected_target_admission',None))):
                    raise ConversationError('Guarded GM sender bundle is unavailable; no literal command dispatched')
                result=dispatch('gm_execute',dict(command=literal_command))
                record.update(outcome='completed',streamComplete=True,turnCompleted=True,
                    childPhase='literal.completed',actionOutcome='not_inferred_from_tool_receipt',api=api_metadata())
                publish()
                return literal_gm_feedback(literal_command,result)
            system = (self.developer_persona if developer else self.persona)
            if reference is not None:
                system += "\nLocal realm command reference:\n" + reference['eager']
            system += "\nCurrent observations and control state JSON:\n" + encode(prompt_state).decode("utf-8")
            incoming = request.get("messages")
            if incoming is None:
                # Internal cues and older callers supply only their new cue.
                incoming = history[-1:] if history else []
            if not isinstance(incoming, list) or any(not isinstance(row, dict)
                    or not isinstance(row.get("text"), str) for row in incoming):
                raise ConversationError("Current conversation input is invalid")
            messages = [{"role":"user", "content":row["text"]} for row in incoming]
            generation = self._generation
            binding = dict(provider=self.client.provider, model=self.model, baseURL=self.client.base_url,
                sessionId=generation.get("sessionId"),
                selfGuid=generation.get("selfGuid"), chatSessionId=generation.get("chatSessionId"),
                source=request.get("source"), channel=request.get("channel"),
                scope=request.get("conversationScope"),
                peer=request.get("senderGuid") if request.get("channel") == "WHISPER" else None)
            conversation_key = encode(binding).decode("utf-8")
            transcript_path = self.state_dir / "api-conversations" / (hashlib.sha256(
                conversation_key.encode("utf-8")).hexdigest() + ".json")
            schemas = tools.tool_schemas() if tools is not None else [context_tool_schema()]
            record["promptMetrics"].update(systemBytes=len(system.encode("utf-8")),
                messagesBytes=len(encode(messages)), toolSchemaBytes=len(encode(schemas)))
            record["requestPreparedAtUnixMs"] = int(time.time()*1000)
            publish()  # Prepared bytes/phase only; no HTTP write or effect inferred.
            value = self.client.generate(
                system, messages, None, schemas, dispatch,
                cancelled=interrupted, request_id=self.last_request_id, progress=api_progress,
                natural=True, transcript_path=transcript_path, conversation_key=conversation_key,
                assistant_text=getattr(self, "_assistant_text", None),
                read_only_tools={"context_read", "chat_read", "session_catalog", "read_observation", "spell_inspect", "find_usable_items", "check_gear_upgrade",
                    "workspace_read", "lua_evaluate", "gm_task_status", "gm_current_task", "gm_inspect"})
            if interrupted():
                raise OwnerInputPending("Fresh owner input is waiting")
            if mutation_entered[0] and (value.get("action", "NONE") != "NONE" or value.get("gm_command")):
                raise ConversationError("A mutation tool already entered; a second reply action was refused")
            reply = validate_reply(value, emotes, allow_silent=allow_silent, allow_gm=allow_gm, natural=True)
            record.update(outcome="completed", streamComplete=True, turnCompleted=True,
                          childPhase="api.completed", actionOutcome="not_inferred_from_model_reply")
            self.last_api_receipt = self.client.last_receipt
            record["api"] = api_metadata()
            publish()
            return reply
        except BaseException as error:
            self.last_api_receipt = self.client.last_receipt
            reason = ("stop_requested" if self.stopped() else "owner_input_waiting"
                if isinstance(error, (Cancelled, OwnerInputPending)) else
                error.reason if isinstance(error, ModelError) else type(error).__name__)
            record.update(outcome="failed", reason=reason, errorType=type(error).__name__,
                          childPhase="literal.failed" if literal_command is not None else "api.failed", api=api_metadata())
            self.retain_failure(record)
            publish()
            if self.stopped(): raise Stopped("Conversation stop requested") from error
            if isinstance(error, (Cancelled, OwnerInputPending)):
                raise OwnerInputPending("Fresh owner input is waiting") from error
            if isinstance(error, (KeyboardInterrupt, SystemExit)): raise
            raise ConversationError(("Literal GM command is unconfirmed or blocked: " if literal_command is not None else "The selected model request did not finish: ") + str(reason)) from error




class CodexBrain(AgentBrain):
    def __init__(self, binary, state_dir, timeout=None, stopped=lambda: False, character_name="Arlen", character_class="priest", developer_workspace=None, model=None, reasoning_effort=None, *, provider="codex", base_url=None, local_provider=None, api_key_env=None):
        super().__init__(state_dir, timeout, stopped, character_name, character_class, developer_workspace, model, reasoning_effort)
        self.binary = Path(binary)
        self.transport = model_transport(provider, model=self.model, base_url=base_url,
                                         local_provider=local_provider, api_key_env=api_key_env)

    def model_selection(self):
        selection = dict(requestedModel=self.model, source='explicit_cli' if self.model is not None else 'cli_default_unpinned',
                    configured=self.model is not None, effectiveModelKnown=False, userConfigIgnored=True,
                    requestedReasoningEffort=self.reasoning_effort, reasoningOverride=self.reasoning_effort is not None)
        transport = getattr(self, "transport", dict(provider="codex"))
        selection.update(provider=transport["provider"])
        if transport["provider"] != "codex":
            selection.update(source="explicit_" + transport["provider"], baseURL=transport["baseURL"],
                             localProvider=transport["localProvider"])
        return selection


    def generation_snapshot(self, events, errors, limit, development, reason, error_type, process, developer):
        record=self.generation_record(development,reason,error_type,process)
        try:
            events.flush()
            raw=os.pread(events.fileno(),limit+1,0)
            record['eventBytesTruncated']=len(raw)>limit
            record['partialFinalLine']=bool(raw and not raw.endswith(b'\n'))
            record['stderrBytes']=os.fstat(errors.fileno()).st_size
            try:inspect_events(raw[:limit],developer=developer,evidence=record)
            except ConversationError as error:record['streamError']=str(error)
            if record['eventBytesTruncated']:record['streamComplete']=False
        except Exception as error:
            record['retentionError']=type(error).__name__
        record['childPhase']=record['lastEventType'] or ('process.started' if record['childStarted'] else 'not_started')
        return record


    def retain_development_events(self, events, errors, limit, development, reason, error_type, process, *, developer=True):
        """Keep typed dispositions privately; never retain tool text or replay it."""
        record=self.generation_snapshot(events,errors,limit,development,reason,error_type,process,developer)
        if reason is not None:self.retain_failure(record)
        if developer:
            self.last_development_events=dict(record['counts'])
            self.last_development_result=record
            try:write_json(self.state_dir/'development-events-last.json',record)
            except Exception as error:record['retentionError']=type(error).__name__


