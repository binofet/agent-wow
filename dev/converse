def validate_mission_claims(data,identity):
    if data is None:return dict(version=1,identity=identity,claims=[])
    rows=data.get('claims')
    if (type(data.get('version')) is not int or data['version']!=1 or data.get('identity')!=identity
            or not isinstance(rows,list) or any(not isinstance(row,dict)
                or not {'key','at'}<=set(row)<= {'key','at','outcome','retained'}
                or not isinstance(row['key'],str) or not re.fullmatch('[a-f0-9]{64}',row['key'])
                or type(row['at']) not in (int,float) or not math.isfinite(row['at']) or row['at']<=0
                or row.get('outcome','unknown') not in ('reserved','unknown','model_returned','not_started')
                or type(row.get('retained',True)) is not bool for row in rows)
            or len({row['key'] for row in rows})!=len(rows)):
        raise ConversationError('Mission repair reservations are unavailable')
    return data


def mission_fault_attempts(folder,guid,url):
    store,identity=mission_fault_journal(folder,guid,url)
    if not store.folder.exists():return []
    with store:return [dict(row) for row in validate_mission_claims(store.load(),identity)['claims']]


def reserve_mission_fault(folder, guid, url, key, reserve=True):
    if not isinstance(key,str) or not re.fullmatch('[a-f0-9]{64}',key):
        raise ConversationError('Invalid mission repair fault key')
    store,identity=mission_fault_journal(folder,guid,url)
    if not reserve and not store.folder.exists():return 'available'
    with store:
        data=validate_mission_claims(store.load(),identity)
        # Retention is diagnostic only. Every issued key remains protected,
        # including legacy rows whose model/tool outcome was never observed.
        if any(row['key']==key for row in data['claims']):return 'already_reserved'
        if not reserve:return 'available'
        data['claims'].append(dict(key=key,at=time.time(),outcome='reserved',retained=True))
        store.save(data)  # fsync before invoking any model/tools.
        return 'reserved'


def retain_mission_fault_history(folder,guid,url,retained):
    if not isinstance(retained,dict) or any(not isinstance(k,str) or not re.fullmatch('[a-f0-9]{64}',k) or v is not True for k,v in retained.items()):
        raise ConversationError('Lua repair retention result is invalid')
    store,identity=mission_fault_journal(folder,guid,url)
    if not store.folder.exists():return
    with store:
        data=validate_mission_claims(store.load(),identity)
        if not set(retained)<={row['key'] for row in data['claims']}:
            raise ConversationError('Lua repair retained an unobserved reservation')
        changed=False
        for row in data['claims']:
            keep=row.get('outcome','unknown') not in ('model_returned','not_started') or row['key'] in retained
            if row.get('retained',True)!=keep:row['retained']=keep;changed=True
        if changed:store.save(data)


def finish_mission_fault(folder,guid,url,key,outcome):
    if outcome not in ('model_returned','not_started','unknown'):raise ConversationError('Invalid model attempt outcome')
    store,identity=mission_fault_journal(folder,guid,url)
    with store:
        data=validate_mission_claims(store.load(),identity)
        for row in data['claims']:
            if row['key']==key:
                row['outcome']=outcome;store.save(data);return
        raise ConversationError('Mission repair reservation disappeared')


def evaluate_mission_repair(source,frame,source_limit,*,binary=None):
    # This is a pure snapshot of the actual accepted source, not a frozen copy
    # of its stock policy. It cannot enter/advance the live VM or execute tools.
    wrapped=('local policy=(function()\n'+source+'\nend)()\nreturn {decide=function(input) '
        'if type(policy.mission_repair)~="function" then return {available=false} end '
        'return {available=true,decision=policy.mission_repair(input)} end}\n')
    host=task_runtime_module()
    bridge=host.Bridge(binary or ROOT/'data/bin/luapolicy',ROOT/'modules',source_bytes=max(source_limit,len(wrapped.encode())),
        value_bytes=gm_tasks.VALUE_BYTES,execution_ms=gm_tasks.EXECUTION_MS)
    return bridge.evaluate(wrapped,frame)


PARTY_INVITATION_SOURCE = ROOT / 'behaviors/party-invitation.lua'


def evaluate_party_invitation(party, owner_name, character_guid):
    """Read the current choice policy without writing or reserving an invite."""
    try:
        host = task_runtime_module()
    except (OSError, UnicodeError, ValueError, TypeError, RuntimeError) as error:
        raise ConversationError('Party invitation evaluator unavailable: ' + str(error)) from error
    try:
        source = PARTY_INVITATION_SOURCE.read_text()
        binary = os.environ.get('BUDDY_LUAPOLICY_BINARY',
                 os.environ.get('BUDDY_LUAPOLICY_TEST_BINARY', ROOT / 'data/bin/luapolicy'))
        invite = party.get('pendingInvite')
        decision_type = 'absent'
        if isinstance(invite, dict) and 'decision' in invite:
            value = invite['decision']
            decision_type = {str: 'string', int: 'integer', bool: 'boolean', type(None): 'null'}.get(type(value), 'other')
        decision = host.Bridge(binary, ROOT / 'modules').evaluate(source, {
            'sessionId': party.get('sessionId'), 'selfGuid': str(character_guid),
            'ownerName': owner_name, 'party': party, 'inviteDecisionType': decision_type})
        if PARTY_INVITATION_SOURCE.read_text() != source:
            raise ConversationError('Party invitation policy changed during evaluation')
        return decision
    except (host.Error, OSError, UnicodeError, ValueError, TypeError, RuntimeError) as error:
        raise ConversationError('Party invitation policy unavailable: ' + str(error)) from error


def named(text, name):
    return name.casefold() in {word.casefold() for word in re.findall(r"[^\W\d_]+", text)}


def evaluate_spell_learning(source,frame,source_limit,*,binary=None):
