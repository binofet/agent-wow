def companion_role_context(name):
    """Reload shared assignments, never infer roles from a class or old snapshot."""
    unknown = {"available": False}
    folder, path = ROOT / "config", ROOT / "config/companion-roles.json"
    try:
        directory = folder.lstat()
        if (not stat.S_ISDIR(directory.st_mode) or directory.st_uid != os.geteuid()
                or directory.st_mode & 0o022): return unknown
        with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), 'rb') as stream:
            info = os.fstat(stream.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1
                    or info.st_mode & 0o022 or not 0 < info.st_size <= 8192): return unknown
            raw = stream.read(8193)
        if len(raw) > 8192: return unknown
        def unique(items):
            result = {}
            for key, value in items:
                if key in result: raise ValueError('Duplicate role key')
                result[key] = value
            return result
        data = json.loads(raw, object_pairs_hook=unique)
        names = {'Arlen', 'Mira', 'Rook', 'Nixwick', 'Lothar'}
        gameplay = {'healer', 'party_coordinator', 'mage', 'crowd_control', 'enchanting',
                    'rogue', 'scout', 'skinning', 'warlock', 'support', 'engineering'}
        development = {'mission_acceptance', 'navigation', 'api_metadata', 'combat_verification',
                       'profession_verification', 'script_task_runtime', 'shared_integration'}
        if (not isinstance(data, dict) or set(data) != {'version', 'roles', 'architecture'}
                or type(data['version']) is not int or data['version'] != 1
                or not isinstance(data['roles'], dict) or set(data['roles']) != names or name not in names): return unknown
        for who, role in data['roles'].items():
            if not isinstance(role, dict) or set(role) != {'gameplay', 'development'}: return unknown
            for key, allowed in (('gameplay', gameplay), ('development', development)):
                values = role[key]
                if (not isinstance(values, list) or not (0 if who == 'Lothar' and key == 'gameplay' else 1) <= len(values) <= 4
                        or any(not isinstance(value, str) or value not in allowed for value in values)
                        or len(set(values)) != len(values)): return unknown
        architecture = data['architecture']
        if (not isinstance(architecture, dict) or set(architecture) != {'compiled', 'lua', 'progress', 'delivery'}): return unknown
        architecture = {key: plain_text(value, 320) for key, value in architecture.items()}
        def role(who): return dict(name=who, **{key:list(values) for key,values in data['roles'][who].items()})
        return dict(available=True, self=role(name), team=[role(who) for who in sorted(names) if who != name],
                    architecture=architecture, source='config/companion-roles.json', revision=hashlib.sha256(raw).hexdigest())
    except (OSError, ValueError, TypeError, ConversationError): return unknown


