        def publish():
            self.last_development_events = dict(record["counts"]) if developer else None
            record["receiptStored"] = True
            self.last_development_result = dict(record)
            try: write_json(self.state_dir / "development-events-last.json", record)
            except Exception: record["receiptStored"] = False
            callback = getattr(self, "_generation_progress", None)
            if callable(callback): callback(record)
        def api_progress(_):
            record["api"] = api_metadata()
            publish()
        tools = None
        if developer:
            from direct_tools import DirectTools
            prompt_state["shared_development"] = companion_role_context(self.character_name)
            prompt_state["shared_tasks"] = mission_runtime_context(integer(development["selfGuid"]),
                development["sessionId"], development["rpcUrl"])
        from direct_context import encode
        from direct_tools import DirectTools, ToolError, context_page, context_tool_schema
        self._generation["stage"] = "preparing"
        prompt_state = json.loads(encode(prompt_state))
        gm_context = prompt_state.get("development", {}).get("gmTasks")
        if isinstance(gm_context, dict):
            # Present the same direct API in the prompt and lazy context.
