def mission_deferred_blockers(data):
    """Explicit blocked-child receipts, independent of walking/retry clocks."""
    memory=data.get('memory',{});rows=memory.get('deferredQuests',{}) if isinstance(memory,dict) else {}
    if not isinstance(rows,dict) or len(rows)>128:return [],''
    receipts=[];resolved=set()
    for kind in ('completed','accepted'):
        values=memory.get(kind,{})
        if not isinstance(values,dict) or len(values)>128:continue
        for key,row in values.items():
            if (not isinstance(row,dict) or str(row.get('questId',''))!=str(key)
                    or re.fullmatch('[0-9]{1,10}',str(key)) is None or not 0<int(key)<2**32):continue
            baseline,confirmed=str(row.get('baselineLogRevision','')),str(row.get('confirmedLogRevision',''))
            if not (re.fullmatch('[0-9]{1,20}',baseline) and re.fullmatch('[0-9]{1,20}',confirmed)
                    and int(confirmed)>int(baseline)):continue
            valid=(row.get('status') in ('REWARD_CONFIRMED',2) and row.get('serverRewardObserved') is True
                   and row.get('logRemovalConfirmed') is True) if kind=='completed' else row.get('status') in ('CONFIRMED_IN_LOG',2)
            if valid:
                receipts.append((kind,str(key),baseline,confirmed,str(row.get('offerRevision',''))))
                resolved.add(('hand_in' if kind=='completed' else 'followup')+':'+str(key))
                if kind=='accepted':resolved.add('pickup:'+str(key))
    epoch=hashlib.sha256(json.dumps(sorted(receipts),separators=(',',':')).encode()).hexdigest()
    blockers=[]
    for key,row in sorted(rows.items()):
        if not isinstance(key,str) or not isinstance(row,dict):continue
        kind,reason,params,attempts=row.get('taskKind'),row.get('reason'),row.get('data'),row.get('attempts')
        if not (isinstance(kind,str) and re.fullmatch('[A-Za-z0-9_.-]{1,48}',kind)
                and isinstance(reason,str) and re.fullmatch('[A-Za-z0-9_.:/-]{1,128}',reason)
                and isinstance(params,dict) and type(params.get('questId')) is int and 0<params['questId']<2**32
                and type(attempts) is int and attempts>0 and key==kind+':'+str(params['questId'])):continue
        if key not in resolved:
            blockers.append(dict(task=key,taskKind=kind,questId=params['questId'],reason=reason,attempts=attempts))
    return blockers,epoch


