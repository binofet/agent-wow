def owner_acknowledgement(folder, identity, session, sequence, outcome=None, *, reserve=True):
    """Reserve current owner input before chat/model work; never rearm an unknown write."""
    host=task_runtime_module()
    try:
        store=host.Store(Path(folder)/'owner-acknowledgements',max_bytes=host.MAX_CONTROLLER_LIMIT)
        if not reserve and not store.folder.exists():return 'available'
        with store:
            data=store.load()
            if data is None:data=dict(version=1,identity=identity,streams={})
            streams=data.get('streams')
            if (data.get('version')!=1 or data.get('identity')!=identity or not isinstance(streams,dict)
                    or any(not isinstance(sid,str) or not re.fullmatch(r'[A-Za-z0-9._-]{1,128}',sid)
                        or not isinstance(row,dict) or set(row)!={'sequence','outcome'}
                        or type(row['sequence']) is not int or row['sequence']<=0
                        or row['outcome'] not in ('reserved','transport_written','transport_unconfirmed','not_started')
                        for sid,row in streams.items())):
                raise ConversationError('Owner acknowledgement reservations are unavailable')
            row=streams.get(session)
            if outcome is None:
                if row and sequence<=row['sequence']:return 'already_reserved'
                if not reserve:return 'available'
                streams[session]=dict(sequence=sequence,outcome='reserved')
            elif row and row['sequence']==sequence:
                row['outcome']=outcome
            else:
                raise ConversationError('Owner acknowledgement reservation changed')
            store.save(data) # Durable before sending chat or entering the model.
            return outcome or 'reserved'
    except host.Error as error:
        raise ConversationError('Owner acknowledgement storage unavailable: '+str(error)) from error


def owner_message_scope(text, names):
    """Grammatical audience hints only; never gameplay intent or authority."""
    names=sorted({name.casefold() for name in names},key=lambda name:(-len(name),name))
    pattern='|'.join(re.escape(name) for name in names)
    roles=r'casters?|healers?|tanks?|melee|ranged|mages?|priests?|warlocks?|rogues?|warriors?|paladins?|hunters?|druids?|shamans?|death knights?'
    # Sentence delimiters exclude decimal points. A new explicit vocative,
    # party address or role after a conjunction/comma starts its own scope.
    audience=r'(?:everyone|everybody|team|party|all|both|'+roles+r')(?!\w)'
    if pattern:audience+=r'|(?:'+pattern+r')(?=\s*[,:])'
    boundary=r'[!?;\n]|(?<!\d)\.|\.(?!\d)|(?:,\s*(?:(?:and|also)\s+)?|\s+(?:and|also)\s+)(?=(?:'+audience+r'))'
    spans=[];previous=0
    for split in re.finditer(boundary,text,re.IGNORECASE):
        prefix=text[previous:split.start()].strip()
        named_only=(pattern and re.fullmatch(r'(?:hey\s+)?(?:'+pattern+r')(?:[\s,&]*(?:(?:and|or|also)\s+)?(?:'+pattern+r'))*',prefix,re.IGNORECASE))
        if split.group()[0] in ', \t' and named_only:
            continue # This comma/conjunction still belongs to the vocative.
        spans.append((previous,split.start()));previous=split.end()
    spans.append((previous,len(text)))
    clauses=[]
    for left,right in spans:
        raw=text[left:right];clause=raw.strip()
        if not clause:continue
        start=left+len(raw)-len(raw.lstrip())
        row=dict(start=start,end=start+len(clause),audience='party')
        prefix=re.match(r'\s*(?:hey\s+)?',clause,re.IGNORECASE).end()
        named=re.match(r'(?:'+pattern+r')(?=[\s,:]|$)',clause[prefix:],re.IGNORECASE) if pattern else None
        if named:
            addressed=[named.group().casefold()];end=prefix+named.end()
            while True:
                join=re.match(r'\s*(?:,\s*(?:(?:and|or|also)\s+)?|(?:and|or|also)\s+|&\s*)('+pattern+r')(?!\w)',clause[end:],re.IGNORECASE)
                if not join:break
                addressed.append(join.group(1).casefold());end+=join.end()
            row.update(audience='named',names=addressed)
        else:
            role=re.match(r'(?:hey\s+)?('+roles+r')(?=[\s,:]|$)',clause,re.IGNORECASE)
            if role:row.update(audience='role',role=role.group(1).casefold())
        clauses.append(row)
    return dict(clauses=clauses,broadcast=any(row['audience']!='named' for row in clauses),
                namedAddresses=sorted({name for row in clauses for name in row.get('names',[])}))


def addressed_names(text, names):
    scope=owner_message_scope(text,names)
    # A trailing named clause cannot consume an earlier party/role directive.
    return set() if scope['broadcast'] else set(scope['namedAddresses'])


def parse_roster(values, self_guid, self_name, owner_guid):
    if len(values) > 39:
        raise ConversationError("Party roster exceeds39 other agents")
    roster, names = {}, set()
    for value in values:
        try:
            name, raw_guid = value.split(":")
            name, guid = character_name(name), integer(raw_guid, "roster GUID")
        except (ValueError, TypeError):
            raise ConversationError("Party agents use NAME:GUID") from None
        if not 0 < guid < 2**48 or guid == owner_guid or guid in roster or name.casefold() in names:
            raise ConversationError("Party roster has an invalid or duplicate identity")
        if guid == self_guid:
            if name.casefold() != self_name.casefold():
                raise ConversationError("Own roster identity does not match")
            continue
        if name.casefold() == self_name.casefold():
            raise ConversationError("Party roster reuses this character's name")
        roster[guid] = name
        names.add(name.casefold())
    return roster


def owner_quest_snapshot(path):
    unknown = {"available": False, "live": False, "source": "owner_reported",
               "reason": "missing_or_invalid_snapshot"}
    if path is None:
        return unknown
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as source:
            info = os.fstat(source.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                    or info.st_nlink != 1 or info.st_mode & 0o077 or info.st_size > 65536):
                return unknown
            raw = source.read(65537)
        if len(raw) > 65536:
            return unknown
        value = json.loads(raw)
        if not isinstance(value, dict) or set(value) != {"recordedAt", "source", "quests"}:
            return unknown
        recorded_at = plain_text(value["recordedAt"], 64)
        recorded = datetime.datetime.fromisoformat(recorded_at.replace("Z", "+00:00"))
        if recorded.tzinfo is None or recorded.utcoffset() is None:
            return unknown
        report_source = plain_text(value["source"], 160)
        quests = value["quests"]
        if not isinstance(quests, list) or len(quests) > 25:
            return unknown
        clean, seen = [], set()
        for quest in quests:
            if not isinstance(quest, dict) or set(quest) != {"questId", "title", "objectives"}:
                return unknown
            quest_id = integer(quest["questId"], "reported quest ID")
            if not 0 < quest_id <= 2**32 - 1 or quest_id in seen:
                return unknown
            seen.add(quest_id)
            title = plain_text(quest["title"], 160)
            objectives = quest["objectives"]
            if not isinstance(objectives, list) or len(objectives) > 8:
                return unknown
            cleaned_objectives = []
            for objective in objectives:
                if (not isinstance(objective, dict)
                        or set(objective) not in ({"text"}, {"text", "current", "required"})):
                    return unknown
                item = {"text": plain_text(objective["text"], 512)}
                if "current" in objective:
                    current = integer(objective["current"], "reported objective count")
                    required = integer(objective["required"], "reported objective requirement")
                    if not 0 <= current <= required <= 2**32 - 1 or required == 0:
                        return unknown
                    item.update(current=current, required=required)
                cleaned_objectives.append(item)
            clean.append({"questId": quest_id, "title": title, "objectives": cleaned_objectives})
        return {"available": True, "live": False, "source": report_source,
                "recordedAt": recorded_at, "quests": clean,
                "progressSemantics": "Human-reported snapshot at recordedAt; may be stale and is not live server quest-log evidence."}
    except (OSError, ValueError, TypeError, ConversationError):
        return unknown


def _quest_routine_snapshot(character_guid, stop=False, standing=False):
    # Fixed local goal path; neither the model nor chat supplies a path/token.
    folder = ROOT / ("data/party-quests" if standing else "data/sync-quests")
    identities = (PARTY_QUEST_IDENTITY,) if standing else (QUEST_SYNC_IDENTITY, LEGACY_QUEST_SYNC_IDENTITY)
    unknown = {"active": False}
    def regular(path):
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or info.st_nlink != 1 or info.st_mode & 0o077 or info.st_size > 8192):
            os.close(descriptor)
            raise ConversationError("Quest sync state is unavailable")
        return descriptor
    try:
        if folder.is_symlink() or folder.stat().st_uid != os.geteuid() or folder.stat().st_mode & 0o077:
            return unknown
        with os.fdopen(regular(folder / "status.json"), "rb") as source:
            raw = source.read(8193)
        if len(raw) > 8192:
            return unknown
        record = json.loads(raw)
        if (not isinstance(record, dict) or record.get("identity") not in identities
                or record.get("routineActive") is not True
                or not isinstance(record.get("instance"), str)
                or not re.fullmatch(r"[0-9a-f]{32}", record["instance"])):
            return unknown
        with os.fdopen(regular(folder / "lock"), "r") as lock:
            if not is_locked(lock):
