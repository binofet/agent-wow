def checked_developer_workspace(path):
    path = Path(path).resolve()
    def git(folder, option):
        try:
            return subprocess.check_output(["git", "-C", str(folder), "rev-parse", option],
                text=True, stderr=subprocess.DEVNULL, timeout=5).strip()
        except (OSError, subprocess.SubprocessError):
            raise ConversationError("Developer workspace must be this project's Git repository/worktree") from None
    if not path.is_dir() or Path(git(path,"--show-toplevel")).resolve() != path:
        raise ConversationError("Developer workspace must be a repository root")
    if (path / git(path,"--git-common-dir")).resolve() != (ROOT / git(ROOT,"--git-common-dir")).resolve():
        raise ConversationError("Developer workspace belongs to another repository")
    return path

def registered_developer_workspace(guid, name):
    registry = read_json(ROOT / "data/self-edit/workspaces.json")
    matches = [row for row in registry.get("characters", [])
               if row.get("guid") == guid and row.get("name") == name.casefold()]
    if not matches:
        return None
    if len(matches) != 1 or not isinstance(matches[0].get("workspace"), str):
        raise ConversationError("Companion workspace registration is invalid")
    return Path(matches[0]["workspace"])


def model_transport(provider="codex", *, model=None, base_url=None, local_provider=None, api_key_env=None):
    """Bind one explicit transport; an unavailable provider never selects another."""
    if provider not in ("codex", "local", "responses"):
        raise ConversationError("Unsupported model provider")
    if provider == "codex":
        if any(value is not None for value in (base_url, local_provider, api_key_env)):
            raise ConversationError("Model endpoint options require an explicit provider")
        return dict(provider=provider)
    if explicit_model(model) is None:
        raise ConversationError("This model provider requires an explicit model")
    if (not isinstance(base_url, str) or not 1 <= len(base_url) <= 2048
            or any(char.isspace() or ord(char) < 32 for char in base_url)):
        raise ConversationError("An explicit model base URL is required")
    try:
        parsed = urllib.parse.urlsplit(base_url)
        port = parsed.port
    except ValueError:
        raise ConversationError("Invalid model base URL") from None
    loopback = parsed.hostname in ("127.0.0.1", "localhost", "::1")
    if (not parsed.hostname or parsed.username is not None or parsed.password is not None
            or parsed.query or parsed.fragment or port is not None and not 0 < port < 65536
            or parsed.scheme not in ("http", "https") or parsed.scheme == "http" and not loopback
            or provider == "local" and not loopback):
        raise ConversationError("Model base URL must use HTTPS or explicit loopback HTTP")
    if provider == "local":
        local_provider = local_provider or "lmstudio"
        if local_provider not in ("lmstudio", "ollama") or api_key_env is not None:
            raise ConversationError("Local models require LM Studio or Ollama without hosted credentials")
    elif local_provider is not None:
        raise ConversationError("Local provider is only valid for a local model")
    if api_key_env is not None and (not isinstance(api_key_env, str)
            or re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]{0,127}", api_key_env) is None):
        raise ConversationError("Model API key must name an environment variable")
    return dict(provider=provider, baseURL=base_url.rstrip("/"),
                localProvider=local_provider, apiKeyEnv=api_key_env)


def codex_environment(transport):
    if transport.get("provider") != "local":
        return None  # Preserve the maintained CLI environment for other providers.
    environment = os.environ.copy()
    for name in ("OPENAI_API_KEY", "OPENAI_BASE_URL", "CODEX_OSS_PORT",
                 "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy"):
        environment.pop(name, None)
    # Codex's built-in OSS providers read this explicit endpoint before their defaults.
    environment["CODEX_OSS_BASE_URL"] = transport["baseURL"]
    environment["NO_PROXY"] = environment["no_proxy"] = "127.0.0.1,localhost,::1"
    return environment


def codex_command(binary, workspace, schema, output, developer=False, model=None, reasoning_effort=None, *, transport=None):
    if transport is not None and not isinstance(transport, dict):
        raise ConversationError("Invalid model transport")
    configured = transport or dict(provider="codex")
    transport = model_transport(configured.get("provider"), model=model, base_url=configured.get("baseURL"),
        local_provider=configured.get("localProvider"), api_key_env=configured.get("apiKeyEnv"))
    command = [str(binary), "exec", "--ephemeral", "--ignore-user-config",
               "--skip-git-repo-check", "--color", "never",
               "--json", "--output-schema", str(schema), "--output-last-message", str(output),
               "--cd", str(workspace), "-c", 'web_search="disabled"',
               "-c", "apps._default.enabled=false"]
    if explicit_model(model) is not None: command.extend(("--model", model))
    if explicit_reasoning_effort(reasoning_effort) is not None:
        command.extend(("-c", 'model_reasoning_effort=' + json.dumps(reasoning_effort)))
    provider = transport["provider"]
    if provider == "local":
        command.extend(("--oss", "--local-provider", transport["localProvider"],
                        "-c", "model_provider=" + json.dumps(transport["localProvider"])))
    elif provider == "responses":
        command.extend(("-c", 'model_provider="buddy_responses"'))
        for key, value in dict(name="Explicit Responses provider", base_url=transport["baseURL"],
                wire_api="responses", requires_openai_auth=False).items():
            command.extend(("-c", "model_providers.buddy_responses." + key + "=" + json.dumps(value)))
        if transport["apiKeyEnv"] is not None:
            command.extend(("-c", "model_providers.buddy_responses.env_key=" + json.dumps(transport["apiKeyEnv"])))
    if provider == "codex":
        command += ["--approve-for-me"] if developer else ["--sandbox", "read-only"]
    else:
        command.extend(("--sandbox", "workspace-write" if developer else "read-only",
                        "-c", 'approval_policy="never"', "-c", 'approvals_reviewer="user"'))
    for feature in DISABLED_FEATURES:
        if developer and feature in DEVELOPER_FEATURES:
            continue
        command.extend(("--disable", feature))
    if developer:
        command.extend(("--add-dir",str(ROOT.resolve())))
        # The editing agent talks to its already-owned localhost client. The
        # ordinary workspace-write default disables this, which otherwise
        # masquerades as a dead game connection from inside shell tools.
        command.extend(("-c", "sandbox_workspace_write.network_access=true"))
        for feature in ("shell_tool", "unified_exec"):
            command.extend(("--enable", feature))
    return command + ["-"]


def receipt_identifier(value):
    if not isinstance(value,str) or not value:return None
    return value if re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}",value) else "sha256:"+hashlib.sha256(value.encode('utf-8','surrogatepass')).hexdigest()


def inspect_events(raw, developer=False, *, evidence=None):
    """Validate a complete CLI stream and reject unexpected tools/CLI errors.

    Ordinary chat forbids tools. Development admits coding events and records
    command failures so normal fail/edit/retest iterations stay in this turn.
    """
    completed, turn_started, pending = False, False, set()
    outcomes = dict(failedCommands=0,successfulCommands=0,failedPatches=0,completedPatches=0)
    tools=[]
    valid=False
    last_kind=None
    thread_id=turn_id=last_tool=None
    error_events=[]
    omitted_errors=0
    def error_metadata(kind, value):
        nonlocal omitted_errors
        code=value.get('code') if isinstance(value,dict) else None
        row=dict(eventType=kind)
        if type(code) is int and -(2**31)<=code<2**31:row['code']=code
        else:row['codeUnknown']=True
        error_events.append(row)
        if len(error_events)>4:error_events.pop(0);omitted_errors+=1
    try:
        for line in raw.splitlines():
            if not line.strip():
                continue
            try:
                event = json.loads(line)
            except (ValueError, UnicodeError):
                raise ConversationError("Codex returned non-JSON events") from None
            if not isinstance(event, dict):
                raise ConversationError("Codex returned an invalid event")
            kind = event.get("type")
            last_kind=kind if kind in ("item.started","item.updated","item.completed","turn.started","turn.completed","turn.failed","error","thread.started") else "unexpected"
            if isinstance(event.get('thread_id'),str):thread_id=receipt_identifier(event['thread_id'])
            if isinstance(event.get('turn_id'),str):turn_id=receipt_identifier(event['turn_id'])
            if kind in ('turn.failed','error'):error_metadata(kind,event.get('error',event))
            if kind in ("item.started", "item.updated", "item.completed"):
                item = event.get("item", {})
                if (not turn_started and kind == "item.completed" and isinstance(item, dict)
                        and item.get("type") == "error"
                        and item.get("message") == DISABLED_CODE_MODE_WARNING):
                    # Installed CLI emits this diagnostic because we intentionally
                    # removed the code-mode host. No model turn/tools have begun.
                    continue
                if isinstance(item,dict):
                    if item.get('type') in ('command_execution','file_change','mcp_tool_call','web_search'):
                        last_tool=dict(itemId=receipt_identifier(item.get('id')),type=item['type'],eventType=kind,
                            status=item.get('status') if item.get('status') in ('completed','failed','in_progress') else 'unknown')
                        code=item.get('exit_code')
                        if type(code) is int and -(2**31)<=code<2**31:last_tool['exitCode']=code
                        if isinstance(item.get('error'),dict):error_metadata(kind,item['error'])
                    elif item.get('type')=='error':error_metadata(kind,item)
                if developer and isinstance(item,dict) and item.get("type") in ("command_execution","file_change"):
                    identity=item.get("id")
                    if not turn_started or not isinstance(identity,str) or not 0<len(identity)<=128:
                        raise ConversationError("Developer tool event identity is invalid")
                    if kind=="item.completed":
                        if item.get("status") not in ("completed","failed"):
                            raise ConversationError("Developer tool outcome is malformed")
                        if item['type']=='command_execution':
                            code=item.get('exit_code')
                            if type(code) is not int and not (code is None and item['status']=='failed'):
                                raise ConversationError("Developer command exit code is malformed")
                            outcomes['successfulCommands' if code==0 and item['status']=='completed' else 'failedCommands']+=1
                        else:
                            outcomes['completedPatches' if item['status']=='completed' else 'failedPatches']+=1
                        row=dict(itemId=receipt_identifier(identity),type=item["type"],status=item["status"])
                        if item["type"]=="command_execution":
                            row["exitCode"]=code if code is None or -(2**31)<=code<2**31 else None
                        tools.append(row)
                        if len(tools)>16:del tools[0]
                        pending.discard(identity)
                    else:
                        pending.add(identity)
                    continue
                if not isinstance(item, dict) or item.get("type") not in (("agent_message", "reasoning", "todo_list") if developer else ("agent_message", "reasoning")):
                    raise ConversationError("Codex attempted a tool; no reply was sent")
            elif kind == "turn.started":
                turn_started = True
            elif kind == "turn.completed":
                completed = True
            elif kind != "thread.started":
                raise ConversationError("Codex reported an error or unexpected event")
        if not completed or pending:
            raise ConversationError("Codex did not complete a reply")
        valid=True
        return outcomes if developer else None
    finally:
        if evidence is not None:
            ids=[receipt_identifier(value) for value in pending]
            total=sum(outcomes.values())
            evidence.update(counts=outcomes,tools=tools,omittedTools=max(0,total-len(tools)),
                pendingTools=sorted(ids)[:16],omittedPendingTools=max(0,len(ids)-16),
                turnStarted=turn_started,turnCompleted=completed,streamComplete=valid,
                lastEventType=last_kind,threadId=thread_id,turnId=turn_id,lastTool=last_tool,
                errorEvents=error_events,omittedErrorEvents=omitted_errors)


class AgentBrain:
    """Shared conversation authority and receipts, independent of model transport."""
    class _SpellLearningRequest(dict):
        """Only the same-body spellbook observer creates this internal cue."""
        def __init__(self,*args,owned_learning_check=None,**kwargs):
            super().__init__(*args,**kwargs)
            self.owned_learning_check=owned_learning_check


    class _CombatReviewRequest(dict):
        """Created only by this body's private combat observer, never chat JSON."""
        def __init__(self, *args, owned_review_check=None, **kwargs):
            super().__init__(*args, **kwargs)
            self.owned_review_check = owned_review_check


    def __init__(self, state_dir, timeout=None, stopped=lambda: False, character_name="Arlen", character_class="priest", developer_workspace=None, model=None, reasoning_effort=None):
        self.state_dir = Path(state_dir)
        self.timeout, self.stopped = timeout, stopped
        self.persona = character_persona(character_name, character_class)
        self.character_name, self.model = character_name, explicit_model(model)
        self.gm_instructions = ""
        self.gm_reference = ""
        if character_name.casefold() == "lotharen":
            self.gm_instructions = gm_tasks.INSTRUCTIONS
            try:
                reference = Path(__file__).with_name("lotharen-gm-commands.txt").read_text(encoding="utf-8")
            except FileNotFoundError:
                reference = ""
            self.gm_reference = reference
            if reference:
                self.gm_instructions += "\n" + reference
        self.reasoning_effort = explicit_reasoning_effort(reasoning_effort)
        self.developer_workspace = checked_developer_workspace(developer_workspace) if developer_workspace is not None else None
        self.developer_persona = character_persona(character_name, character_class, developer=True)
        self.last_development_events = None
        self.last_development_result = None
        self.included_usage_only = False
        self.last_failure_receipt = None
        self.last_request_id = None


    def development_enabled(self, state):
        if self.developer_workspace is None or not isinstance(state,dict): return False
        request, development = state.get("current_request",{}), state.get("development",{})
        allowed = (isinstance(request,dict) and request.get("source") in ("owner","party_agent","mission_fault","combat_review")
            and (request["source"]=="owner" or request.get("verifiedPeer") is True)
            and isinstance(development,dict) and development.get("enabled") is True
            and development.get("directDevelopment") is True
            and development.get("workspace")==str(self.developer_workspace))
        if isinstance(request,dict) and request.get('source')=='mission_fault':
            allowed=(type(request) is _MissionFaultRequest and isinstance(development,dict)
                and development.get('enabled') is True and development.get('directDevelopment') is True
                and development.get('workspace')==str(self.developer_workspace))
        if isinstance(request,dict) and request.get('source')=='combat_review':
            allowed=(type(request) is self._CombatReviewRequest and isinstance(development,dict)
                and development.get('enabled') is True and development.get('directDevelopment') is True
                and development.get('workspace')==str(self.developer_workspace)
                and callable(request.owned_review_check))
        if isinstance(request,dict) and request.get('source')=='spell_learning':
            allowed=(type(request) is self._SpellLearningRequest and isinstance(development,dict)
                and development.get('enabled') is True and development.get('directDevelopment') is True
                and development.get('workspace')==str(self.developer_workspace)
                and callable(request.owned_learning_check))
        if not allowed: return False
        try:
            guid, owner = integer(development.get("selfGuid",0)), integer(development.get("ownerGuid",0))
            sid = development.get("sessionId")
            RPC(development.get("rpcUrl"))
            current=(0<guid<2**48 and 0<owner<2**48 and guid!=owner
                and str(guid)==state.get("character",{}).get("guid")
                and isinstance(sid,str) and re.fullmatch(r"[A-Za-z0-9._-]{1,128}",sid) is not None
                and (request["source"]!="owner" or str(owner)==request.get("senderGuid")))
            if current and request['source']=='combat_review':
                return request.owned_review_check(guid, sid, development['rpcUrl'], request.get('reviewKey'))
            if current and request['source']=='spell_learning':
                return request.owned_learning_check(guid,sid,development['rpcUrl'],request.get('noticeKey'))
            if not current or request['source'] != 'mission_fault':
                return current
            if request.owned_fault_check is not None:
                commission=request.get('commission')
                fault=state.get('mission_fault',{})
                if commission is not None and (not isinstance(commission,dict) or commission!=dict(
                        kind='gm_task',goalId=fault.get('goalId'),taskStateDir=fault.get('taskStateDir'),
                        sessionId=sid,selfGuid=str(guid),rpcUrl=development['rpcUrl'])
                        or fault.get('kind')!='gm_task'):
                    return False
                return request.owned_fault_check(guid, sid, development['rpcUrl'], request.get('faultKey'))
            return any(row['key'] == request.get('faultKey') for row in mission_faults(guid,sid,development['rpcUrl']))
        except (ConversationError,TypeError,ValueError,AttributeError):
            return False


    def generation_record(self, development, reason, error_type, process=None):
        development=development if isinstance(development,dict) else {}
        generation=getattr(self,'_generation',None) or {}
        pid=getattr(process,'pid',None)
        now=time.monotonic()
        return dict(version=1,requestId=generation.get('requestId') or uuid.uuid4().hex,
            toolCustodyRequestId=generation.get('toolCustodyRequestId'),
            sessionId=generation.get('sessionId',development.get('sessionId')),
            chatSessionId=generation.get('chatSessionId'),
            selfGuid=generation.get('selfGuid',str(development.get('selfGuid'))),
            cursor=generation.get('cursor'),requestSource=generation.get('requestSource','unknown'),
            recordedAtUnixMs=int(time.time()*1000),
            elapsedMs=max(0,int((now-generation.get('started',now))*1000)),
            outcome='completed' if reason is None else 'failed',reason=reason,errorType=error_type,
            childPid=pid if type(pid) is int and pid>0 else None,
            childStarted=process is not None,childReaped=process is not None and process.returncode is not None,
            processExitCode=getattr(process,'returncode',None),
            terminationRequested=generation.get('terminationRequested',False),
            killRequested=generation.get('killRequested',False),
            counts=dict(failedCommands=0,successfulCommands=0,failedPatches=0,completedPatches=0),
            tools=[],pendingTools=[],streamComplete=False,turnStarted=False,turnCompleted=False,
            omittedTools=0,omittedPendingTools=0,lastEventType=None,threadId=None,turnId=None,
            errorEvents=[],omittedErrorEvents=0,actionOutcome='unknown',receiptStored=False)


    def retain_failure(self, record):
        # This is evidence only: never clear or retry a tool/game reservation.
        self.last_failure_receipt=record
        stored=False
        try:
            folder=ensure_state(self.state_dir/'brain-failures')
            record['receiptStored']=True
            # Each receipt fits the existing reader; eight receipts bound disk use.
            while len(json.dumps(record).encode())+1>8192:
                if record.get('tools'):
                    record['tools'].pop(0);record['omittedTools']+=1
                elif record.get('pendingTools'):
                    record['pendingTools'].pop();record['omittedPendingTools']+=1
                elif record.get('errorEvents'):
                    record['errorEvents'].pop(0);record['omittedErrorEvents']+=1
                else:raise ConversationError('Failure receipt exceeds private limit')
            write_json(folder/(record['requestId']+'.json'),record)
            stored=True
            paths=[p for p in folder.iterdir() if re.fullmatch(r'[a-f0-9]{32}\.json',p.name)]
            for path in sorted(paths,key=lambda p:(p.lstat().st_mtime_ns,p.name))[:-8]:path.unlink()
        except Exception as error:
            record['receiptStored']=stored
            record['retentionError']=type(error).__name__


    def generate(self, history, control_state=None, cancelled=None):
        # Reset before binding checks, cancellation or Popen can fail. A previous
        # request's tools must never be attached to a new failure.
        self.last_request_id=uuid.uuid4().hex
        self.last_failure_receipt=self.last_development_events=self.last_development_result=None
        state=control_state if isinstance(control_state,dict) else {}
        development=state.get('development') if isinstance(state.get('development'),dict) else {}
        character=state.get('character') if isinstance(state.get('character'),dict) else {}
        context=getattr(self,'_generation_context',None)
        context=context if isinstance(context,dict) else {}
        sid=context.get('sessionId') or development.get('sessionId')
        guid=context.get('selfGuid') or development.get('selfGuid') or character.get('guid')
        guid=str(guid) if type(guid) in (int,str) else ''
        request=state.get('current_request') if isinstance(state.get('current_request'),dict) else {}
        source=request.get('source')
        self._generation=dict(requestId=self.last_request_id,started=time.monotonic(),stage='binding_check',
            toolCustodyRequestId=context.get('toolCustodyRequestId') or self.last_request_id,
            sessionId=sid if isinstance(sid,str) and re.fullmatch(r'[A-Za-z0-9._-]{1,128}',sid) else None,
            chatSessionId=receipt_identifier(context.get('chatSessionId')),
            selfGuid=guid if re.fullmatch(r'[0-9]{1,20}',guid) and 0<int(guid)<2**64 else None,
            cursor=context.get('cursor') if type(context.get('cursor')) is int and 0<=context['cursor']<2**64 else None,
            requestSource=source if source in ('owner','party_agent','mission_fault','combat_review','spell_learning','banter') else 'unknown')
        try:
            return self._generate(history,control_state,cancelled)
        except BaseException as error:
            if self.last_failure_receipt is None:
                reason=('owner_input_waiting' if isinstance(error,OwnerInputPending) else
                    'stop_requested' if isinstance(error,Stopped) else
                    'process_spawn_failed' if self._generation['stage']=='spawning' else
                    'developer_binding_changed' if self._generation['stage']=='binding_check' else 'preparation_failed')
                record=self.generation_record(development,reason,type(error).__name__)
                record['childPhase']='not_started'
                self.retain_failure(record)
            raise
        finally:self._generation=None



def gm_reference_context(reference):
    """Index the maintained public format losslessly; custom references stay eager."""
    raw=reference.encode('utf-8')
    captured=dict(format='custom_full_eager',raw=reference,sha256=hashlib.sha256(raw).hexdigest(),bytes=len(raw))
    metadata={key:captured[key] for key in ('format','sha256','bytes')}
    metadata['rawPath']=['gmReference','raw']
    fallback=dict(eager=reference,captured=captured,metadata=metadata)
    guide_end='END GENERAL GUIDE — FULL PUBLIC CATALOG PRESERVED BELOW\n'
    catalog_start='FULL COMMAND HELP AND SOURCE SIGNATURES\n'
    manifest_start='\nPUBLIC SOURCE FILE MANIFEST\n'
    if any(reference.count(marker)!=1 for marker in (guide_end,catalog_start,manifest_start)):return fallback
    if not reference.index(guide_end)<reference.index(catalog_start)<reference.index(manifest_start):return fallback
    guide,remainder=reference.split(guide_end,1)
    if not guide.startswith('GENERAL GM OPERATIONS GUIDE —'):return fallback
    preamble,catalog_and_manifest=remainder.split(catalog_start,1)
    catalog,manifest=catalog_and_manifest.split(manifest_start,1)
    pin=re.search(r'^Public source revision: ([a-f0-9]{40})$',preamble,re.M)
    count=re.search(r'(\d+) distinct paths in the\n  complete case-insensitive union',preamble)
    headers=list(re.finditer(r'^={72}\n(\.[^\r\n]+)\n',catalog,re.M))
    if not pin or not count or not headers or len(headers)!=int(count[1]) or catalog[:headers[0].start()].strip():return fallback
    names=[header[1] for header in headers]
    if len(set(name.casefold() for name in names))!=len(names) or any(name!=name.strip() for name in names):return fallback
    url='https://github.com/azerothcore/azerothcore-wotlk/blob/'+pin[1]+'/'
    for line in manifest.splitlines():
        if not line or line=='All paths below are relative to '+url or \
                line=='ADDITIONAL GENERAL-GUIDE PRIMARY SOURCES (SAME REFERENCE PIN)' or line.startswith(url):continue
        if not re.fullmatch(r'.+ \| \d+ bytes \| SHA-256 [a-f0-9]{64}',line):return fallback
    entries={header[1]:dict(sourcePin=pin[1],text=catalog[header.start():headers[index+1].start() if index+1<len(headers) else len(catalog)])
        for index,header in enumerate(headers)}
    captured.update(format='pinned_public_command_catalog_v1',sourcePin=pin[1],guide=guide,
        preamble=preamble,manifest=manifest_start+manifest,commands=entries)
    metadata.update(format=captured['format'],sourcePin=pin[1],commandCount=len(entries),
        commandPath=['gmReference','commands','<exact command name>','text'],
        manifestPath=['gmReference','manifest'],preamblePath=['gmReference','preamble'])
    eager=(guide+'\nCOMPLETE COMMAND NAME INDEX ('+str(len(entries))+')\n'+'\n'.join(names)+
        '\n\nThe full exact reference is preserved in captured context. Read a complete published entry with '
        'context_read(path=["gmReference","commands",".groupsummon","text"],limit=4096); substitute ANY indexed '
        'command name. Entries retain syntax, security, registration and signature, with sourcePin on their parent. '
        'Continue nextOffset when paged. Raw unchanged text/SHA, preamble and source manifest are at the gmReference paths below.\n')
    return dict(eager=eager,captured=captured,metadata=metadata)


class DirectBrain(AgentBrain):
    """Conversation brain using model HTTP APIs and actor-bound native tools."""
    def __init__(self, state_dir, timeout=None, stopped=lambda: False, character_name="Arlen",
                 character_class="priest", developer_workspace=None, model=None, *,
                 provider="local", base_url=None, api_key_env=None):
        super().__init__(state_dir, timeout, stopped, character_name, character_class,
                         developer_workspace, model, None)
        from direct_model import DirectModel
        self.client = DirectModel(provider, self.model, base_url, api_key_env, timeout)
