            if "emote_catalog" in prompt_state:
                catalog = prompt_state["emote_catalog"]
                prompt_state["emote_catalog"] = {k:catalog[k] for k in ("available","revision","source") if k in catalog}
                prompt_state["emote_catalog"]["count"] = len(emotes)
            if isinstance(prompt_state.get("combat"), dict):
                write_json(self.state_dir / "combat-context-last.json", {
                    "preparedAtUnixMs": int(time.time()*1000),
                    "character": prompt_state.get("character", {}),
                    "requestSource": request.get("source"),
                    "combat": prompt_state["combat"],
                })
            gm_instructions = self.gm_instructions if allow_gm else ""
            prompt = ((self.developer_persona if developer else self.persona) + gm_instructions + ownership + "\nCurrent observations and control state JSON:\n"
                      + json.dumps(prompt_state, ensure_ascii=False)
                      + "\nConversation JSON:\n" + json.dumps(history, ensure_ascii=False))
            if cancelled and cancelled():
                raise OwnerInputPending("Fresh owner input is waiting")
            # Files, rather than pipes, bound memory use and prevent pipe deadlock.
            with tempfile.TemporaryFile(dir=folder) as events, tempfile.TemporaryFile(dir=folder) as errors:
                self._generation['stage']='spawning'
                process = subprocess.Popen(codex_command(self.binary, workspace, schema, output, developer=developer,
                                                        model=self.model, reasoning_effort=self.reasoning_effort,
                                                        transport=transport),
                                           stdin=subprocess.PIPE, stdout=events, stderr=errors,
                                           start_new_session=True, env=codex_environment(transport))
                self._generation['stage']='running'
                progress=getattr(self,'_generation_progress',None) if developer else None
                progress_at=0.0
                progress_size=None
                reason,error_type='process_io_failed',None
                try:
                    process.stdin.write(prompt.encode())
                    process.stdin.close()
                    timeout=self.timeout if self.timeout is not None else (None if developer else 120)
                    deadline=None if timeout is None else time.monotonic()+timeout
                    while process.poll() is None:
                        if self.stopped():
                            reason='stop_requested'
                            raise Stopped("Conversation stop requested")
                        if cancelled and cancelled():
                            reason='owner_input_waiting'
                            raise OwnerInputPending("Fresh owner input is waiting")
                        if deadline is not None and time.monotonic() >= deadline:
                            reason='timeout'
                            raise ConversationError("Codex reply timed out")
                        if events.tell() > limit or errors.tell() > limit:
                            reason='output_limit'
                            raise ConversationError("Codex output exceeds the limit")
                        if callable(progress) and time.monotonic()>=progress_at:
                            progress_at=time.monotonic()+1
                            size=os.fstat(events.fileno()).st_size
                            if size!=progress_size:
                                progress_size=size
                                snapshot=self.generation_snapshot(events,errors,limit,prompt_state.get('development',{}),None,None,process,developer)
                                snapshot['outcome']='in_progress'
                                try:progress(snapshot)
                                except Exception:pass
                        time.sleep(0.1)
                    if process.returncode:
                        reason='process_failed'
                        raise ConversationError("Codex reply failed; verify codex login status" if transport["provider"] == "codex"
                            else "Selected model provider failed; no provider fallback was attempted")
                    if errors.tell() > limit:
                        reason='output_limit'
                        raise ConversationError("Codex output exceeds the limit")
                    events.seek(0)
                    raw = events.read(limit + 1)
                    if len(raw) > limit:
                        reason='output_limit'
                        raise ConversationError("Codex output exceeds the limit")
                    reason='event_stream_invalid'
                    self.last_development_events = inspect_events(raw, developer=developer)
                    reason='reply_missing_or_oversized'
                    if not output.is_file() or output.stat().st_size > 4096:
                        raise ConversationError("Codex did not produce a bounded JSON reply")
                    reason='reply_invalid_json'
                    try:
                        value = json.loads(output.read_text())
                    except (ValueError, UnicodeError):
                        raise ConversationError("Codex reply is invalid JSON") from None
                    reason='reply_validation_failed'
                    reply=validate_reply(value, emotes, allow_silent=allow_silent, allow_gm=allow_gm)
                    reason=None
                    return reply
                except BaseException as error:
                    error_type=type(error).__name__
                    raise
                finally:
                    try:
                        if process.poll() is None:
                            self._generation['terminationRequested']=True
                            try:
                                os.killpg(process.pid, signal.SIGTERM)
                            except ProcessLookupError:
                                pass  # The tracked child exited between poll and signal.
                            try:
                                process.wait(timeout=2)
                            except subprocess.TimeoutExpired:
                                self._generation['killRequested']=True
                                try:
                                    os.killpg(process.pid, signal.SIGKILL)
                                except ProcessLookupError:
                                    pass
                                process.wait(timeout=2)
                    except BaseException as error:
                        if error_type is None:reason,error_type='process_teardown_failed',type(error).__name__
                        raise
                    finally:
                        try:
                            if process.stdin and not process.stdin.closed:
                                process.stdin.close()
                        except OSError as error:
                            if error_type is None:
                                reason,error_type='process_io_failed',type(error).__name__
                                raise
                        finally:
                            if developer or reason is not None:
                                self.retain_development_events(events,errors,limit,prompt_state.get('development',{}),reason,error_type,process,developer=developer)





def queue_lua_control(controls, technique, mark=None, target_guid=None):
    """Queue an owner intent; None alone permits an existing legacy caller."""
    if technique not in ("polymorph", "sap"):
        raise ConversationError("Unknown crowd-control technique")
    marks = ("star", "circle", "diamond", "triangle", "moon", "square", "x", "skull")
    if mark is not None and mark not in marks or mark is not None and target_guid is not None:
        raise ConversationError("Use one exact crowd-control selector")
    method, session = "session.attach", ""
    try:
        actions = controls.rpc.call("buddy-actions.status", {})
        session = actions.get("sessionId")
        if (not isinstance(session, str) or not session or
                integer(actions.get("selfGuid", 0)) != controls.character_guid):
            raise ConversationError("Crowd-control body is unconfirmed")
        identity = {"sessionId": session, "characterGuid": str(controls.character_guid)}
        try:
            attached = controls.rpc.call(method, identity)
        except CapabilityUnavailable:
            return None
        if attached.get("sessionId") != session or attached.get("characterGuid") != identity["characterGuid"]:
            raise ConversationError("Attached crowd-control body changed")
        if not (attached.get("policy") or {}).get("revision"):
            return None
        value = {"task": "control", "technique": technique}
        if target_guid is not None:
            target = integer(target_guid, "control target")
            if not 0 < target < 2**64:
                raise ConversationError("Crowd-control target is invalid")
            value["targetGuid"] = str(target)
        elif mark is not None:
            value["mark"] = mark
        else:
            value["auto"] = True
        method = "session.send_event"
        result = controls.rpc.call(method, dict(identity, kind="command", value=value))
        if (result.get("status") != "queued" or result.get("sessionId") != session or
                result.get("characterGuid") != identity["characterGuid"] or integer(result.get("sequence", 0)) <= 0):
            raise ConversationError("Crowd-control request acknowledgment is unconfirmed")
        controls.command_fault = None
        controls.last_control_evidence = dict(value, sessionId=session, phase="queued", sequence=result["sequence"])
        return "I've queued the crowd-control request. I'll confirm it when the effect is observed."
    except ConversationError as error:
        controls.command_fault = {"sessionId": session, "selfGuid": str(controls.character_guid),
                                  "method": method, "error": str(error)}
        return "I couldn't confirm the crowd-control request. I won't retry it through a different controller."


def parse_lua_control_request(text):
    marks = "star|circle|diamond|triangle|moon|square|x|skull"
    match = re.fullmatch(r"(?:(?:can|could|would|will) you\s+|please\s+)?"
        r"(?:(?P<verb>sheep|polymorph|sap)\s+(?:the\s+)?(?P<target>" + marks + r"|[1-9][0-9]{0,19}|one|an? add)"
        r"|keep\s+(?:one|an? add)\s+(?P<effect>sheeped|sapped))"
        r"(?:\s+please)?(?:\s+(?:when|while)\s+we\s+(?:have|fight)\s+(?:adds|multiple enemies))?[.!?]?", text, re.I)
    if not match:
        return None
    technique = "sap" if (match["verb"] or "").lower() == "sap" or (match["effect"] or "").lower() == "sapped" else "polymorph"
    target = (match["target"] or "").lower()
    return dict(technique=technique, mark=target if target in marks.split("|") else None,
                target_guid=target if target.isdecimal() else None)


class BuddyControls:
    """Only fixed-owner game controls; the model never supplies RPC methods."""
    def __init__(self, rpc, player_name="Joel", character_class="priest", owner_quest_context=None, character_guid=1,
                 *, supply_state_dir=None, profile_identity=None):
        self.rpc, self.player_name = rpc, player_name
        self.character_class = character_class
        self.owner_quest_context = owner_quest_context
        self.character_guid = character_guid
        self.combat_context = combat_context.CombatContext(character_guid)
        self.party, self.actions = {}, {}
        self.party_available = self.actions_available = False
        self.attempted_invites = set()
        self.party_session = ""
        self.invitation_policy_fault = None
        self.events = []
        self.previous_group = None
        self.previous_cast_go = None
        self.quests, self.loot, self.trade, self.journal = {}, {}, {}, {}
        self.quests_available = self.loot_available = self.trade_available = self.journal_available = False
        self.previous_quest_confirmation = None
        self.previous_loot_items = self.previous_completed_trades = None
        self.reward_items = {"available": False, "items": []}
        self.quest_items, self.quest_items_available = {}, False
        self.inventory, self.inventory_names, self.inventory_session = {"available": False}, {}, ""
        self.spell_toolkit, self.professions = {"available": False}, {"available": False}
        self.spellbook_observation, self.learned_spell_notice = None, None
        self.emote_catalog = {"available": False}
        self.mission_follow_binding = None
        self.lua_water_supply = {}
        self.water_supply_phase = "idle"
        self.supply_state_dir = Path(supply_state_dir).absolute() if supply_state_dir is not None else None
        self.supply_profile_identity = copy.deepcopy(profile_identity)
        self._water_supply_loaded = False

    def load_water_supply(self, supply):
        identity = self.supply_profile_identity
        if (self.supply_state_dir is None or not isinstance(identity, dict)
                or identity.get("guid") != self.character_guid or identity.get("owner_guid") != supply.OWNER_GUID
                or identity.get("rpc_url") != getattr(self.rpc, "url", None)
                or identity.get("rpc_url") != f"http://127.0.0.1:{supply.MIRA}/rpc"):
            raise ConversationError("Durable current-profile water supply state required")
        if self._water_supply_loaded:
            return
        folder = ensure_state(self.supply_state_dir)
        if folder.resolve() != folder:
            raise ConversationError("Water supply profile directory cannot contain symlinks")
        runtime = supply.runtime
        path = folder / "mana-supply.json"
        try:
            record = runtime.decoded(runtime.read_file(path, runtime.MAX_STATE, True))
        except FileNotFoundError:
            record = {"version": 1, "profile": identity, "state": {}}
        if (not isinstance(record, dict) or set(record) != {"version", "profile", "state"}
                or type(record["version"]) is not int or record["version"] != 1
                or record["profile"] != identity or not isinstance(record["state"], dict)):
            raise ConversationError("Stored water supply profile binding is invalid; state retained")
        self.lua_water_supply = record["state"]
        self._water_supply_store = runtime.Store(folder)
        self._water_supply_loaded = True

    def persist_water_supply(self, state):
        runtime = mana_supply_module().runtime
        record = {"version": 1, "profile": self.supply_profile_identity, "state": state}
        # Reuse the existing private bounded atomic/fsync writer. The listener
        # already holds the exclusive profile run lock; this adds no worker.
        self._water_supply_store.write("mana-supply.json", runtime.packed(record, runtime.MAX_STATE), runtime.MAX_STATE)

    def maintain_water_supply(self, *, still_current):
        """Drive one accepted Lua turn; native RPCs execute its exact choice."""
        if self.character_guid != 4:
            return
        yielded = False
        try:
            supply = mana_supply_module()
            self.load_water_supply(supply)
            clients = getattr(self, "_water_supply_clients", None)
            if clients is None:
                clients = self._water_supply_clients = {
                    port: supply.runtime.RPC(f"http://127.0.0.1:{port}/rpc",
                        request_bytes=8*1024*1024, response_bytes=8*1024*1024)
                    for port in (supply.MIRA, *supply.RECIPIENTS)}

            def call(port, method, params):
                nonlocal yielded
                # Do not consume chat here. The next normal tick acknowledges
                # the owner before doing any more background work.
                if yielded or not still_current():
                    yielded = True
                    raise supply.NotDispatched("owner_input_pending")
                return clients[port].call(method, params, timeout=1.5)

            observations = {}
            for port in clients:
                try:
                    view = {name: call(port, method, {}) for name, method in (
                        ("world", "buddy-world.snapshot"), ("actions", "buddy-actions.status"),
                        ("inventory", "buddy-inventory.state"), ("trade", "buddy-trade.state"),
                        ("party", "buddy-party.state"))}
                    try:
                        view["journal"] = call(port, "buddy-quests.journal", {"refresh": False})
                    except supply.runtime.Error:
                        view["journal"] = {}  # Unknown protection facts forbid disposal.
                    if port == supply.MIRA:
                        view["spell_toolkit"] = call(port, "buddy-actions.spell_toolkit", {})
                    observations[port] = view
                except supply.runtime.Error:
                    continue
            # B's adapter commits Lua reservations before the write and retains
            # uncertain receipts. Even a zero-send preemption must not clear it.
            self.water_supply_phase = supply.maintain_supply(call, observations, self.lua_water_supply,
                                                           persist=self.persist_water_supply)
        except OwnerInputPending:
            pass
        except Exception as error:
            self.water_supply_phase = "accepted_water_policy_unavailable"
            self.lua_water_supply["error"] = str(error)
        if yielded:
            self.water_supply_phase = "yielded_to_owner"

    def observe_learned_spells(self, raw):
        """One factual same-body ID delta; eligibility/coalescing stays in Lua."""
        sid=raw['sessionId']
        known=frozenset(integer(row['spellId']) for row in raw.get('spells',[]))
        revision=str(integer(raw.get('spellbookRevision',0)))
        previous=self.spellbook_observation
        self.spellbook_observation=dict(sessionId=sid,ids=known,revision=revision)
        if previous is None or previous['sessionId']!=sid:
            self.learned_spell_notice=None
            self.events=[e for e in self.events if e!='server_observed_new_learned_spells']
            return  # Initial/reconnected complete snapshots are baselines.
        added=known-previous['ids']
        notice=self.learned_spell_notice
        if added:
            ids=set(notice['spellIds']) if notice else set()
            ids=(ids|added)&known
            notice=dict(sessionId=sid,selfGuid=str(self.character_guid),spellIds=sorted(ids),
                spellbookRevision=revision,changedAtMs=time.monotonic()*1000,stableObservations=0)
            self.learned_spell_notice=notice
            if 'server_observed_new_learned_spells' not in self.events:self.events.append('server_observed_new_learned_spells')
        elif notice:
            notice['spellIds']=[spell for spell in notice['spellIds'] if spell in known]
            notice['stableObservations']+=1
            if not notice['spellIds']:self.learned_spell_notice=None;return
        if self.learned_spell_notice:
            notice=self.learned_spell_notice
            notice['key']=hashlib.sha256(json.dumps(dict(kind='spell_learning',sessionId=sid,
                spellbookRevision=notice['spellbookRevision'],spellIds=notice['spellIds']),sort_keys=True).encode()).hexdigest()

    def acknowledge_learned_spells(self, notice):
        current=self.learned_spell_notice
        if not current or current['sessionId']!=notice['sessionId']:return
        current['spellIds']=[spell for spell in current['spellIds'] if spell not in notice['spellIds']]
        if not current['spellIds']:
            self.learned_spell_notice=None
            self.events=[e for e in self.events if e!='server_observed_new_learned_spells']
        else:
            current['key']=hashlib.sha256(json.dumps(dict(kind='spell_learning',sessionId=current['sessionId'],
                spellbookRevision=current['spellbookRevision'],spellIds=current['spellIds']),sort_keys=True).encode()).hexdigest()

    def refresh(self):
        def call(method, params, *, before_write=None):
            current = getattr(self, "_refresh_current", None)
            if current is not None and (self._refresh_yielded or not current()):
                self._refresh_yielded = True
                raise OwnerInputPending("Fact refresh yielded to current owner input")
            if before_write is not None:before_write()
            return self.rpc.call(method, params)

        try:
            party = call("buddy-party.state", {})
            self.party_available = True
            session = party.get("sessionId", "")
            if not isinstance(session, str) or not 1 <= len(session) <= 128:
                raise ConversationError("Party session identifier is invalid")
            if session != self.party_session:
                self.attempted_invites.clear()
                self.party_session = session
            self.party = party
            group = party.get("group", {})
            in_group = isinstance(group, dict) and group.get("known") is True and group.get("inGroup") is True
            if self.previous_group is False and in_group:
                self.events.append("server_confirmed_party_join")
            self.previous_group = in_group
            invitation = party.get("pendingInvite", {})
            self.invitation_policy_fault = None
            if isinstance(invitation, dict) and invitation:
                sequence = integer(invitation.get("sequence", "0"), "invite sequence")
                key = (session, sequence)
                inviter = invitation.get("inviterName")
                if sequence and key not in self.attempted_invites and len(self.attempted_invites) < 256:
                    try:
                        proposal = evaluate_party_invitation(party, self.player_name, self.character_guid)
                    except ConversationError as error:
                        self.invitation_policy_fault = str(error)[:512]
                        proposal = None
                    # Lua chooses whether to accept. The adapter binds only that
                    # proposal to the actual observed invitation; native Accept
                    # rechecks its session, sequence, name and pending decision.
                    if (not isinstance(proposal, dict) or proposal.get("kind") != "accept" or
                            set(proposal) != {"kind", "sessionId", "inviteSequence", "inviterName"} or
                            proposal["sessionId"] != session or proposal["inviteSequence"] != str(sequence) or
                            not isinstance(inviter, str) or not 1 <= len(inviter) <= 128 or
                            proposal["inviterName"] != inviter):
                        proposal = None
                else:
                    proposal = None
                if proposal is not None:
                    # Reserve before writing: a timeout cannot cause a repeated accept.
                    result = call("buddy-party.accept", {
                        "sessionId": session, "inviteSequence": str(sequence), "inviterName": inviter},
                        before_write=lambda: self.attempted_invites.add(key))
                    if result.get("transportWritten") is not True:
                        raise ConversationError("Party acceptance write was not confirmed")
        except ConversationError:
            self.party_available = False
        try:
            self.actions = call("buddy-actions.status", {})
            casts = integer(self.actions.get("serverCastGo", "0"), "completed cast counter")
            if self.previous_cast_go is not None and casts > self.previous_cast_go:
                self.events.append("server_confirmed_spell_cast")
            self.previous_cast_go = casts
            self.actions_available = True
        except ConversationError:
            self.actions_available = False
        self.spell_toolkit, self.professions = {"available": False}, {"available": False}
        if self.actions_available:
            try:
                raw = call("buddy-actions.spell_toolkit", {})
                self.spell_toolkit = spell_toolkit_context(raw, self.actions, self.character_guid)
                if self.spell_toolkit.get('available') is True:self.observe_learned_spells(raw)
            except ConversationError:
                pass
        try:
            raw = call("buddy-professions.state", {})
            self.professions = professions_context(raw, self.character_guid, self.actions.get("sessionId") if self.actions_available else None)
        except ConversationError:
            pass
        for name, method in (("quests", "buddy-quests.state"), ("loot", "buddy-loot.state"),
                             ("trade", "buddy-trade.state"), ("journal", "buddy-quests.journal"),
                             ("quest_items", "buddy-quest-items.state")):
            try:
                setattr(self, name, call(method, {"refresh": False} if name == "journal" else {}))
                if name == "quest_items":
                    value = self.quest_items
                    if (integer(value.get("selfGuid", 0)) != self.character_guid
                            or not isinstance(value.get("sessionId"), str) or not 1 <= len(value["sessionId"]) <= 128
                            or not 0 < integer(value.get("questId", 0)) < 2**32):
                        raise ConversationError("Quest executor identity is unavailable")
                setattr(self, name + "_available", True)
            except ConversationError:
                setattr(self, name + "_available", False)
        acceptance = self.quests.get("lastAcceptance", {}) if self.quests_available else {}
        if (isinstance(acceptance, dict) and acceptance.get("status") in ("CONFIRMED_IN_LOG", 2)):
            key = (self.quests.get("sessionId"), acceptance.get("questId"), acceptance.get("confirmedLogRevision"))
            if self.previous_quest_confirmation is not None and key != self.previous_quest_confirmation:
                self.events.append("server_confirmed_quest_in_own_log")
            self.previous_quest_confirmation = key
        for name, field, previous, event in (
                ("loot", "itemsStoredConfirmed", "previous_loot_items", "server_confirmed_loot_items_stored"),
                ("trade", "completedTrades", "previous_completed_trades", "server_confirmed_trade_completed")):
            if getattr(self, name + "_available"):
                try:
                    count = integer(getattr(self, name).get(field, "0"), field)
                    old = getattr(self, previous)
                    if old is not None and count > old:
                        self.events.append(event)
                    setattr(self, previous, count)
                except ConversationError:
                    setattr(self, name + "_available", False)
        self.events = self.events[-8:]
        try:
            raw = call("buddy-inventory.state", {})
            inventory = inventory_context(raw, self.character_guid)
            if inventory["sessionId"] != self.inventory_session:
                self.inventory_names, self.inventory_session = {}, inventory["sessionId"]
            missing = list(dict.fromkeys(row["entry"] for row in inventory.get("items", [])
                                       if row.get("metadataKnown") and row["entry"] not in self.inventory_names))[:6]
            if missing:
                try:
                    reply = call("buddy-trade.lookup_items", {"itemIds": missing})
                    rows = reply.get("items", [])
                    if reply.get("sessionId") == self.inventory_session and isinstance(rows, list) and len(rows) <= 6:
                        for row in rows:
                            if isinstance(row, dict) and row.get("available") is True and integer(row.get("itemId", 0)) in missing:
                                name = plain_text(row.get("name"), 120)
                                if len(self.inventory_names) < 128:
                                    self.inventory_names[integer(row["itemId"])] = name
                except ConversationError:
                    pass
            self.inventory = inventory_context(raw, self.character_guid, self.inventory_names)
        except ConversationError:
            self.inventory = {"available": False}

    def poll_combat(self):
        if self.actions_available:
            self.combat_context.poll(self.rpc, self.actions,
                self.party.get("group", {}) if self.party_available else {})
        else:
            self.combat_context.unavailable("current_actions_unavailable")

    def context(self):
        self.emote_catalog = {"available":False}
