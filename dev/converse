    return result


def mission_control_snapshot(guid, session_id, rpc_url, stop=False):
    """Fixed own runtimes only; instance markers never signal a process or actor."""
    result = dict(known=True, settled=True, stopRequested=False, runtimes={})
    folders=[ROOT/'data/tasks'/kind/str(guid)/'runtime' for kind in ('expedition','fishing')]
    if not any(path.exists() or path.is_symlink() for folder in folders for path in (folder/'state.json',folder/'lock')):
        return result
    try:
        RPC(rpc_url)
        module=task_runtime_module()
        for kind in ('expedition','fishing'):
            store=module.Store(ROOT/'data/tasks'/kind/str(guid)/'runtime',max_bytes=module.MAX_CONTROLLER_LIMIT)
            data=store.load()
            if data is None: continue
            held=store.held();identity=data.get('identity',{})
            if (not isinstance(identity,dict) or identity.get('guid')!=str(guid)
                    or identity.get('sessionId')!=session_id or identity.get('rpcUrl')!=rpc_url):
                if held: raise ConversationError('Mission body changed')
                continue  # Retained old-body history grants no current task authority.
            run=module.run_binding(data);pending=data.get('pending')
            if not isinstance(pending,list) or len(pending)>256: raise ConversationError('Mission pending state unavailable')
            entry=dict(instance=run['instance'],active=run['active'] and held,
                       stopped=not run['active'] and not held,pendingCount=len(pending),
                       stopRequested=module.stop_requested(store,data))
            if stop and entry['active']:
                request=module.request_stop(store,guid,session_id,rpc_url)
                entry['stopRequested']=request.get('stopRequested') is True
                result['stopRequested'] |= entry['stopRequested']
            result['runtimes'][kind]=entry
            result['settled'] &= entry['stopped'] and not pending
    except (OSError,ValueError,TypeError,AttributeError,RuntimeError,ConversationError):
        result.update(known=False,settled=False)
    except Exception:
        # The maintained host's bounded private-state errors use its own type.
        result.update(known=False,settled=False)
    return result


