            active = record.get("routineActive") is True and is_locked(lock)
        own = record.get("own", {})
        if not isinstance(own, dict):
            return unknown
        result = {"active": active, "busy": active and own.get("busy") is True}
        if own.get("lastKind") in ("bags", "sell"):
            result["kind"] = own["lastKind"]
        confirmed = integer(own.get("confirmedOperations", 0))
        if confirmed <= 168:
            result["confirmedOperations"] = confirmed
        phase = own.get("phase", "")
        if isinstance(phase, str) and re.fullmatch(r"[a-z0-9_]{1,120}", phase):
            result["phase"] = phase
        control = "follow" if revoke_follow else revoke_control
        if control is not None and control not in ("follow", "healing", "assist", "loot"):
            raise ConversationError("Town control revocation is invalid")
        if control is not None and result["busy"]:
            activity = record.get("activityId", "")
            if isinstance(activity, str) and re.fullmatch(r"[0-9a-f]{32}", activity):
                marker = {"identity": expected, "instance": record["instance"], "activityId": activity}
                prior = read_json(folder / "follow-revoked.json")
                controls = set()
                if all(prior.get(key) == value for key,value in marker.items()):
                    previous = prior.get("controls", ["follow", "healing", "assist", "loot"])
                    if not isinstance(previous,list) or any(name not in ("follow","healing","assist","loot") for name in previous):
                        raise ConversationError("Town control marker is invalid")
                    controls.update(previous)
                controls.add(control)
                write_json(folder / "follow-revoked.json", dict(marker, controls=sorted(controls)))
                result["followRevoked"] = True
        return result
    except (OSError, ValueError, TypeError, ConversationError):
        return unknown


def inventory_context(state, character_guid, names=None):
    """Describe actual carried slots; template names alone never imply ownership."""
    if (not isinstance(state, dict) or integer(state.get("selfGuid", 0)) != character_guid
            or not isinstance(state.get("sessionId"), str) or not 1 <= len(state["sessionId"]) <= 128):
        raise ConversationError("Inventory actor identity is unavailable")
    result = {"available": True, "known": state.get("inventoryKnown") is True,
              "sessionId": state["sessionId"], "inventoryRevision": state.get("inventoryRevision", "0")}
    if not result["known"]:
        return result
    bags = state.get("inventoryBags", [])
    if not isinstance(bags, list) or len(bags) != 5:
        raise ConversationError("Inventory bag frame is incomplete")
    seen_bags, seen_items, items, bag_entries, total, free = set(), set(), [], [], 0, 0
    for bag in bags:
        if not isinstance(bag, dict):
            raise ConversationError("Inventory bag is invalid")
        b, count = integer(bag.get("bag", 0)), integer(bag.get("slotCount", 0))
        guid = integer(bag.get("containerGuid", 0))
        if b > 4 or b in seen_bags or count > 36 or bag.get("slotKnown") is not True or bag.get("contentsKnown") is not True:
            raise ConversationError("Inventory bag layout is unknown")
        seen_bags.add(b)
        if b == 0 and (count != 16 or guid) or b > 0 and not guid and count:
            raise ConversationError("Inventory bag capacity is inconsistent")
        if guid:
            if guid >> 48 != 0x4000 or guid in seen_items or bag.get("metadataKnown") is not True:
                raise ConversationError("Inventory container is invalid")
            seen_items.add(guid)
            bag_entries.append({"bag": b, "entry": integer(bag.get("entry", 0)), "slots": count})
        slots = bag.get("slots", [])
        if not isinstance(slots, list) or len(slots) != count:
            raise ConversationError("Inventory slots are incomplete")
        seen_slots = set()
        for item in slots:
            if not isinstance(item, dict):
                raise ConversationError("Inventory slot is invalid")
            slot, g = integer(item.get("slot", 0)), integer(item.get("itemGuid", 0))
            if integer(item.get("bag", 0)) != b or slot >= count or slot in seen_slots:
                raise ConversationError("Inventory slot is duplicated")
            seen_slots.add(slot)
            if not g:
                if integer(item.get("entry", 0)) or integer(item.get("stackCount", 0)) or item.get("metadataKnown") is True:
                    raise ConversationError("Empty inventory slot is inconsistent")
                free += 1
            else:
                if g >> 48 != 0x4000 or g in seen_items:
                    raise ConversationError("Inventory item is duplicated")
                seen_items.add(g)
                row = {"bag": b, "slot": slot, "itemGuid": str(g), "metadataKnown": item.get("metadataKnown") is True}
                if row["metadataKnown"]:
                    entry, stack = integer(item.get("entry", 0)), integer(item.get("stackCount", 0))
                    if not 0 < entry < 2**32 or not 0 < stack < 2**32:
                        raise ConversationError("Inventory item metadata is invalid")
                    row.update(entry=entry, count=stack)
                    if names and entry in names:
                        row["name"] = names[entry]
                items.append(row)
        total += count
    if total > 160:
        raise ConversationError("Inventory capacity exceeds its bound")
    result.update(totalSlots=total, freeSlots=free, occupiedSlots=total-free, bags=bag_entries,
                  items=sorted(items, key=lambda row: (row["bag"], row["slot"]))[:48], itemsTruncated=len(items) > 48)
    return result


