        # Keep the complete factual snapshot available without projecting or
        # truncating the model's context. Typed authority stays in `state` only.
        full_context = json.loads(encode(prompt_state))
        if reference is not None:full_context['gmReference']=reference['captured']
        if "emote_catalog" in state:
            full_context["emote_catalog"] = json.loads(encode(state["emote_catalog"]))
        full_context["conversationHistory"] = json.loads(encode(history))
        if isinstance(prompt_state.get("current_request"), dict):
            prompt_state["current_request"].pop("messages", None)  # Raw chat is USER content, never SYSTEM instructions.
        if developer or owner_authorised():
            url = development['rpcUrl'] if developer else private_context['rpcUrl']
