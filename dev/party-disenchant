class Worker:
    def __init__(self, rpc, journal, scanner, guard, stopped=lambda: False, now=time.monotonic, sleep=time.sleep):
        self.rpc, self.journal, self.scanner, self.guard = rpc, journal, scanner, guard
        self.stopped, self.now, self.sleep = stopped, now, sleep
        if rpc.url != journal.url: raise Error('mira_disenchant_identity_required')
    def check_guard(self):
        try:self.guard()
        except Exception:raise Error('disenchant_control_or_safety_changed') from None
    def state(self):
        state = self.rpc.call('buddy-professions.state', {})
        if number(state.get('selfGuid', 0)) != 4: raise Error('mira_disenchant_identity_required')
        token(state.get('sessionId')); return state
    def receipt(self, row, state):
        request = row['request']; operation = state.get('operation') or {}
        if state['sessionId'] != request['sessionId']: row['phase'] = 'new_session_requires_review'
        elif matches(request, row['source'], operation):
            row['receipt'] = copy.deepcopy(operation)
            if operation.get('operationId'): token(operation['operationId']); row['operationId'] = operation['operationId']
            clean = operation.get('leaseReleased') is True and operation.get('cleanupUnconfirmed', False) is False and state.get('active', False) is False
            if clean and completion(operation):
                inv = town.checked_state(self.rpc.call('buddy-inventory.state', {}), 4)
                _, slots = town.layout(inv); equipped = gear.equipment(inv)
                absent = all(number(r.get('itemGuid', 0)) != number(row['source']['itemGuid'])
                    for r in [*slots.values(), *equipped.values()])
                row['phase'] = ('completed' if inv['sessionId'] == request['sessionId'] and absent
                    and number(inv['inventoryRevision']) >= number(operation['observedInventoryRevision']) else 'unconfirmed')
            elif clean and operation.get('status') == 'BLOCKED' and not operation.get('castTransportWritten', False) and not operation.get('ownGoObserved', False): row['phase'] = 'blocked'
            elif clean and operation.get('status') == 'SERVER_REJECTED' and number(operation.get('failureCode', 0)): row['phase'] = 'server_rejected'
            else: row['phase'] = 'requested' if operation.get('status') in ('RESERVED', 'WAITING_CAST', 'WAITING_LOOT', 'WAITING_OBSERVATIONS') else 'unconfirmed'
        else: row['phase'] = 'unconfirmed'
        self.journal.save(); return row['phase']
    def result(self,row):
        phase=row['phase']
        result=dict(phase='complete' if phase=='completed' else phase if phase in TERMINAL else 'unconfirmed',
            newConfirmedOperations=int(phase=='completed'))
        if phase=='completed':
            op=row['receipt'];result['disenchantedItems']=[dict(entry=row['source']['entry'],name=row.get('name',''),
                bodySessionId=row['request']['sessionId'],status='COMPLETED',ownGoObserved=True,inputConsumedObserved=True,
                outputInventoryObserved=True,lootReleaseObserved=True,leaseReleased=True,
                baselineInventoryRevision=op['baselineInventoryRevision'],observedInventoryRevision=op['observedInventoryRevision'])]
        return result
    def run(self, protected=(), max_seconds=25):
        self.reservation_created=any(r['phase'] not in TERMINAL for r in self.journal.data['attempts'])
        try:return self.run_checked(protected,max_seconds)
        except (Error,c.ConversationError,OSError,ValueError,KeyError,TypeError):
            if self.reservation_created:raise
            return dict(phase='blocked',reason='comparison_or_preflight_unavailable_keep_item',newConfirmedOperations=0)
    def run_checked(self, protected=(), max_seconds=25):
        if self.journal.lock is None or not 0 < max_seconds <= 30: raise Error('finite_locked_disenchant_required')
        deadline = self.now()+max_seconds
        if isinstance(self.rpc,RPC):self.rpc.deadline=time.monotonic()+max_seconds
        self.scanner.deadline=time.monotonic()+max_seconds
        row = next((r for r in self.journal.data['attempts'] if r['phase'] not in TERMINAL), None)
        if row is not None:
            phase = self.receipt(row, self.state())
            return self.result(row)
        self.check_guard()
        inv = town.checked_state(self.rpc.call('buddy-inventory.state', {}), 4)
        source, reason, shared = self.scanner.scan(inv, protected)
        if source is None: return dict(phase='blocked', reason=reason, newConfirmedOperations=0)
        attempted = {number(r['source']['itemGuid']) for r in self.journal.data['attempts'] if r['phase'] != 'not_dispatched'}
        if number(source['itemGuid']) in attempted or len(self.journal.data['attempts']) >= 64:
            return dict(phase='blocked', reason='disenchant_source_already_reserved', newConfirmedOperations=0)
        state = self.rpc.call('buddy-professions.inspect_disenchant', dict(sessionId=inv['sessionId'], targetGuid=source['itemGuid']))
        item = state.get('disenchantItem', {})
        if (state.get('sessionId') != inv['sessionId'] or number(state.get('selfGuid', 0)) != 4 or item.get('ready') is not True
                or state.get('active') is True or state.get('closing') is True or state.get('stopPrepared') is True
                or state.get('skillsKnown') is not True or state.get('spellsKnown') is not True
                or number(state.get('inventoryRevision', 0)) != number(inv['inventoryRevision'])
                or any(number(item.get(k, 0)) != number(source.get(k, 0)) for k in ('bag', 'slot', 'itemGuid', 'entry', 'stackCount'))):
            return dict(phase='blocked', reason=item.get('reason', 'selected_disenchant_not_ready'), newConfirmedOperations=0)
        self.check_guard()
        fresh = town.checked_state(self.rpc.call('buddy-inventory.state', {}), 4)
        # Re-read every party comparison before reserving destruction. A changed
        # selection or source is a read-only abort, never an issued request.
        latest, reason, latest_shared = self.scanner.scan(fresh, protected, selected=source)
        if (fresh['sessionId'] != inv['sessionId'] or number(fresh['inventoryRevision']) != number(inv['inventoryRevision'])
                or latest is None or town.ref(latest) != town.ref(source) or latest_shared != shared):
            return dict(phase='blocked', reason=reason or 'party_comparison_changed', newConfirmedOperations=0)
        self.check_guard()
        final = self.state()
        if (final['sessionId'] != state['sessionId'] or final.get('active') is True or final.get('closing') is True
                or any(number(final.get(k, 0)) != number(state.get(k, 0)) for k in ('revision', 'skillsRevision', 'inventoryRevision'))):
            return dict(phase='blocked', reason='disenchant_observations_changed', newConfirmedOperations=0)
        request = dict(sessionId=state['sessionId'], requestId='auto_de_'+uuid.uuid4().hex,
            expectedRevision=str(number(state['revision'])), expectedSkillsRevision=str(number(state['skillsRevision'])),
            expectedInventoryRevision=str(number(state['inventoryRevision'])), skillId=333, spellId=13262,
            targetGuid=source['itemGuid'], targetPositionRevision='0')
        row = dict(phase='reserved', request=request, source=town.ref(source), partyProof=shared,name=source.get('name',''))
        self.reservation_created=True
        self.journal.data['attempts'].append(row); self.journal.save()
        if self.stopped() or self.now() >= deadline:
            row.update(phase='not_dispatched', rpcInvoked=False); self.journal.save()
            return dict(phase='blocked', reason='stop_before_disenchant_dispatch', newConfirmedOperations=0)
        try: state = self.rpc.call('buddy-professions.attempt', request)
        except Error:
            row['phase'] = 'unconfirmed'; self.journal.save()
            return dict(phase='unconfirmed', reason='disenchant_reply_unknown_no_retry', newConfirmedOperations=0)
        while True:
            phase = self.receipt(row, state)
            if phase in TERMINAL:
                return dict(self.result(row),reason=(row.get('receipt') or {}).get('reason',''))
            if self.now() >= deadline: return dict(phase='unconfirmed', reason='disenchant_pending_no_retry', newConfirmedOperations=0)
            try: self.check_guard()
            except Error:
                current=self.state()
                if (current['sessionId']==request['sessionId'] and matches(request,row['source'],current.get('operation'))
                        and row.get('operationId')==current.get('operation',{}).get('operationId') and not row.get('cancelReserved')):
                    row['cancelReserved'] = True; self.journal.save()
                    try: self.rpc.call('buddy-professions.cancel', dict(sessionId=request['sessionId'], operationId=row['operationId']))
                    except Error: pass
                return dict(phase='unconfirmed', reason='disenchant_cleanup_pending', newConfirmedOperations=0)
            self.sleep(.15); state = self.state()
